  "reason": "Record the reviewed assertion and its relationship.",
  "provenance": {"kind": "user-assertion", "method": "human-review"},
  "evidence": [{"document_id": "doc:source-1", "note": "Primary source"}],
  "idempotency_key": "research-note-001",
  "partial_batch": "atomic",
  "mutations": [
    {
      "mutation_id": "m1",
