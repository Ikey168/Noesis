{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/contracts/noesis-review-screening-evaluation-v1.json",
  "title": "Stage-specific screening evaluation",
  "type": "object",
  "required": ["contract", "stage", "cases", "studies", "label_origins", "inclusion_recall", "false_exclusion_rate", "false_exclusions", "false_inclusions", "pending_rate", "criterion_accuracy", "criterion_cases", "automated_exclusion_enabled", "task_ready", "readiness_requires"],
  "properties": {
    "contract": {"const": "noesis-review-screening-evaluation-v1"},
    "stage": {"enum": ["title_abstract", "full_text"]},
    "cases": {"type": "integer", "minimum": 1}, "studies": {"type": "integer", "minimum": 1},
    "label_origins": {"type": "array", "items": {"enum": ["independent-human", "fixture"]}},
    "inclusion_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "false_exclusion_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "false_exclusions": {"type": "integer", "minimum": 0},
    "false_inclusions": {"type": "integer", "minimum": 0},
    "pending_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "criterion_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "criterion_cases": {"type": "integer", "minimum": 0},
    "automated_exclusion_enabled": {"const": false},
    "task_ready": {"const": false},
    "readiness_requires": {"type": "string"}
  },
  "additionalProperties": false
}
