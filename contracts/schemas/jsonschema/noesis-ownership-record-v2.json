{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noesis-ownership-record-v2",
  "title": "Source-stated corporate-ownership record (v2: structured SEC holdings and beneficial-ownership filings)",
  "description": "What one registry or filing states: a legal entity, person, registration, officer role, ownership or control assertion, corporate event or filing reference. Direct/ultimate consolidation parents, control assertions and reporting exceptions are distinct kinds. Percentages are exact or explicit bands. Unknown values stay null and are listed in unknowns. No beneficial-ownership, sanctions or AML determination is ever stored. Version 2 keeps every v1 kind and field and adds what structured SEC filings state: a reported_holding assertion kind (a Form 13F information-table position: CUSIP, class, shares or principal, value, put/call, investment discretion, sole/shared/none voting authority; no percentage and no control), Schedule 13D/13G sole/shared voting and dispositive power and group membership as stated, the filing each assertion comes from (accession, form, dates) and its place on the amendment chain (amendments are new records on the chain, never overwrites), and the natural-person policy a person-level record was stored under.",
  "type": "object",
  "required": [
    "contract",
    "kind",
    "record_key",
    "source",
    "unknowns"
  ],
  "definitions": {
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
    },
    "percent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{1,3}(\\.\\d+)?$"
    },
    "identifier": {
      "type": "object",
      "required": [
        "scheme",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "provider",
        "provider_record_id"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "gleif",
            "companies-house",
            "sec-edgar",
            "open-ownership",
            "opencorporates",
            "handelsregister",
            "unternehmensregister",
            "bris",
            "market-instruments",
            "bafin"
          ]
        },
        "provider_record_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "locator": {
          "type": [
            "object",
            "null"
          ]
        },
        "statement_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "raw_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "share": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "exact": {
          "$ref": "#/definitions/percent"
        },
        "band": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "$ref": "#/definitions/percent"
            },
            "max": {
              "$ref": "#/definitions/percent"
            },
            "min_inclusive": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "max_inclusive": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "native": {},
