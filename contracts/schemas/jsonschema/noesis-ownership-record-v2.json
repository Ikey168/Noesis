      "additionalProperties": false,
      "properties": {
        "is_amendment": {
          "type": "boolean"
        },
        "number": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d+$"
        },
        "type": {
          "enum": [
            "restatement",
            "new_holdings",
            null
          ]
        },
        "amends_accession": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{10}-\\d{2}-\\d{6}$"
        },
        "chain_key": {
          "type": "string",
          "minLength": 1
        },
        "chain_basis": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
