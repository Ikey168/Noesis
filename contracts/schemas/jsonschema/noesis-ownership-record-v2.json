        "period_of_report": {
          "$ref": "#/definitions/date"
        },
        "event_date": {
          "$ref": "#/definitions/date"
        },
        "document_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "amendment": {
          "$ref": "#/definitions/amendment"
        }
      }
    },
    "position": {
