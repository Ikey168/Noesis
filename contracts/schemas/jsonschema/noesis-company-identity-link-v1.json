{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-company-identity-link-v1.json",
  "title": "Noesis company identity link v1",
  "description": "A reviewable link from an LEI to an OpenCorporates record, market issuer or register entry; never an automatic merge.",
  "type": "object",
  "required": [
    "contract",
    "link_id",
    "lei",
    "external_kind",
    "external_id",
    "state",
    "basis"
  ],
  "properties": {
    "contract": {
      "const": "noesis-company-identity-link-v1"
    },
    "link_id": {
      "type": "string",
      "pattern": "^company-link:"
    },
    "lei": {
      "type": "string",
      "pattern": "^[0-9A-Z]{18}[0-9]{2}$"
    },
    "external_kind": {
      "enum": [
        "opencorporates",
        "market-issuer",
        "registry"
      ]
    },
    "external_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "candidate",
        "linked",
        "rejected"
      ]
    },
    "basis": {
      "enum": [
        "registry-number-match",
        "proposed"
      ]
    }
  }
}
