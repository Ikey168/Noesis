{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noesis-extractives-record-v1",
  "title": "Extractives record: release, EITI report revision, payment line, discrepancy, commodity series, vintage or observation",
  "description": "Extractive-sector payments and mineral statistics as published (#2653). Every record carries its namespace and cites the release it came from, with the release clock and the retrieval clock kept apart, each with its basis label, and the licence and attribution terms of the source. An EITI report revision is keyed by country and fiscal period; a changed or withdrawn summary is a new revision (revision_of its predecessor), never a deletion. Payment lines keep the government agency, revenue stream (name and GFS code as reported), company and project as reported, who reported the figure (government or company) and the amount text with the currency the report states; discrepancy lines are the report's own reconciliation figures and explanation. Commodity series are keyed by source (USGS MCS or BGS WMS, never blended), commodity and form as published, statistic, unit and country; numbers and vintages live in the Economics series storage, one vintage per publication, recording new, revised and removed years. Observations keep the value text, status (reported, withheld, not_available, symbol_only) and the published estimated and revised flags; a withheld value carries no number. No record carries a natural-person field (EX01 minimisation), a converted or summed amount, a reserve estimate, a risk score or a forecast.",
  "type": "object",
  "required": ["contract", "record_type"],
  "definitions": {
    "day": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"enum": ["eiti", "usgs-mcs", "bgs-wms"]},
    "decimal": {"type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d+)?$"},
    "company": {
      "type": ["object", "null"],
      "required": ["name_as_reported", "identifiers", "natural_person", "redacted"],
      "properties": {
        "name_as_reported": {"type": ["string", "null"]},
        "identifiers": {"type": "array", "items": {"type": "object", "required": ["scheme", "value"]}},
        "sector": {"type": ["string", "null"]},
        "commodities": {"type": "array"},
        "natural_person": {"type": "boolean"},
        "redacted": {"type": "boolean"}
      },
      "allOf": [{"if": {"properties": {"natural_person": {"const": true}}},
                 "then": {"properties": {"name_as_reported": {"const": "[natural person - redacted]"},
                                         "identifiers": {"maxItems": 0}}}}]
    },
    "stream": {
      "type": "object",
      "required": ["name_as_reported", "gfs_code"],
      "properties": {"name_as_reported": {"type": ["string", "null"]}, "gfs_code": {"type": ["string", "null"]},
                     "gfs_label": {"type": ["string", "null"]}}
    }
  },
  "properties": {
    "contract": {"const": "noesis-extractives-record-v1"},
    "record_type": {"enum": ["release", "eiti_report", "payment", "discrepancy", "commodity_series", "vintage", "observation"]},
    "namespace": {"type": "string", "minLength": 1}
  },
  "propertyNames": {"not": {"enum": ["contact", "email", "phone", "telephone", "person", "beneficial_owner", "beneficial_owners", "risk_score", "forecast", "converted_amount", "estimated_reserves"]}},
  "allOf": [
    {"if": {"properties": {"record_type": {"const": "release"}}},
     "then": {"required": ["release_id", "provider", "format", "file_sha256", "release_basis", "release_at_ms", "retrieved_at_ms", "evidence_origin", "licence"],
              "properties": {"provider": {"$ref": "#/definitions/provider"},
                             "format": {"enum": ["eiti-summary-json", "usgs-mcs-world-csv", "bgs-ogcapi-json"]},
                             "file_sha256": {"$ref": "#/definitions/sha256"},
                             "published_on": {"$ref": "#/definitions/day"},
                             "release_basis": {"enum": ["declared_release", "report_publication", "provider_change_stamp", "retrieval_time"]},
                             "release_at_ms": {"type": "integer"},
                             "retrieved_at_ms": {"type": "integer"},
                             "evidence_origin": {"enum": ["fixture", "operator", "live"]},
                             "licence": {"type": "object"}}}},
    {"if": {"properties": {"record_type": {"const": "eiti_report"}}},
     "then": {"required": ["report_id", "report_key", "revision", "revision_of", "release_id", "status", "country", "fiscal_period", "report", "changes", "release_at_ms", "retrieved_at_ms"],
              "properties": {"revision": {"type": "integer", "minimum": 1},
                             "revision_of": {"type": ["string", "null"]},
                             "status": {"enum": ["published", "withdrawn"]},
                             "country": {"type": "object", "required": ["scheme", "code"]},
                             "fiscal_period": {"type": "object", "required": ["start", "end"],
                                               "properties": {"start": {"$ref": "#/definitions/day"}, "end": {"$ref": "#/definitions/day"}}},
                             "currency": {"type": ["string", "null"]},
                             "excluded_fields": {"type": "array", "items": {"type": "string"}}}}},
    {"if": {"properties": {"record_type": {"const": "payment"}}},
     "then": {"required": ["report_id", "line_key", "reported_by", "level", "agency", "revenue_stream", "amount_text", "currency"],
              "properties": {"reported_by": {"enum": ["government", "company"]},
                             "level": {"enum": ["government-revenue", "company-payment"]},
                             "revenue_stream": {"$ref": "#/definitions/stream"},
                             "company": {"$ref": "#/definitions/company"},
                             "amount": {"$ref": "#/definitions/decimal"},
                             "currency": {"type": ["string", "null"]}}}},
    {"if": {"properties": {"record_type": {"const": "discrepancy"}}},
     "then": {"required": ["report_id", "line", "revenue_stream", "government_amount_text", "company_amount_text", "discrepancy_text", "currency", "basis"],
              "properties": {"company": {"$ref": "#/definitions/company"},
                             "government_amount": {"$ref": "#/definitions/decimal"},
                             "company_amount": {"$ref": "#/definitions/decimal"},
                             "discrepancy": {"$ref": "#/definitions/decimal"}}}},
    {"if": {"properties": {"record_type": {"const": "commodity_series"}}},
     "then": {"required": ["series_id", "provider", "commodity", "statistic", "unit", "country", "economic_series"],
              "properties": {"provider": {"enum": ["usgs-mcs", "bgs-wms"]},
                             "statistic": {"enum": ["production", "reserves", "capacity", "imports", "exports"]},
                             "commodity": {"type": "object", "required": ["name"]},
                             "country": {"type": "object", "required": ["scheme", "name"]}}}},
    {"if": {"properties": {"record_type": {"const": "vintage"}}},
     "then": {"required": ["vintage_id", "series_id", "release_id", "release_at_ms", "release_basis", "retrieved_at_ms", "revision_of", "changes", "publication"],
              "properties": {"changes": {"type": "object", "required": ["new_periods", "revised", "removed_periods"]}}}},
    {"if": {"properties": {"record_type": {"const": "observation"}}},
     "then": {"required": ["period", "value_text", "value", "status", "estimated", "revised"],
              "properties": {"period": {"type": "string", "pattern": "^\\d{4}$"},
                             "value": {"$ref": "#/definitions/decimal"},
                             "status": {"enum": ["reported", "withheld", "not_available", "symbol_only"]},
                             "estimated": {"type": "boolean"},
                             "revised": {"type": "boolean"}},
              "allOf": [{"if": {"properties": {"status": {"not": {"const": "reported"}}}},
                         "then": {"properties": {"value": {"type": "null"}}}}]}}
  ]
}
