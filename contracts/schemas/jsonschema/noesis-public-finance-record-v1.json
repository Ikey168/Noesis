{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noesis-public-finance-record-v1",
  "title": "Public-finance record: release, budget line, budget plan, figure, beneficiary payment or audit finding",
  "description": "Every record carries its namespace and cites the source revision it came from (an acquired budget, payment or statistics file, or an operator's finding sheet). Retrieval time is kept apart from the dates the source states. Budget lines keep the source's own hierarchy codes and labels. Plan, supplementary-plan and outturn figures and beneficiary payments are distinct record kinds, each with amount text as published, the published unit, a normalised value in the currency unit and the accounting basis. An audit finding quotes a passage and the lines it cites, and no record carries a verdict, a forecast or a netted cross-basis number.",
  "type": "object",
  "required": ["contract", "record_type"],
  "definitions": {
    "day": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "basis": {"enum": ["cash", "accrual", "esa2010", "commitment-appropriation", "payment-appropriation", "commitment", "payment"]},
    "source_revision": {
      "type": "object",
      "required": ["release_id", "provider", "file_sha256", "published_on", "evidence_origin"],
      "properties": {
        "release_id": {"type": "string"},
        "provider": {"type": "string"},
        "source_id": {"type": ["string", "null"]},
        "file_sha256": {"$ref": "#/definitions/sha256"},
        "published_on": {"$ref": "#/definitions/day"},
        "url": {"type": ["string", "null"]},
        "evidence_origin": {"enum": ["fixture", "live", "operator"]},
        "retrieved_at_ms": {"type": "integer"}
      }
    },
    "normalized": {
      "type": ["object", "null"],
      "required": ["value", "currency", "scale", "method"],
      "properties": {"value": {"type": ["string", "null"]}, "currency": {"type": "string"}, "scale": {"type": "integer"},
                     "method": {"type": "string"}}
    }
  },
  "properties": {
    "contract": {"const": "noesis-public-finance-record-v1"},
    "record_type": {"enum": ["release", "budget_line", "budget_plan", "figure", "beneficiary_payment", "audit_finding"]},
    "namespace": {"type": "string"},
    "release_id": {"type": "string"},
    "provider": {"type": "string"},
    "published_on": {"$ref": "#/definitions/day"},
    "file_sha256": {"$ref": "#/definitions/sha256"},
    "evidence_origin": {"enum": ["fixture", "live", "operator"]},
    "line_id": {"type": ["string", "null"]},
    "scheme": {"enum": ["de-bund-haushalt", "de-be-haushalt", "eu-budget-line"]},
    "codes": {"type": "object"},
    "labels": {"type": "object"},
    "plan_id": {"type": ["string", "null"]},
    "fiscal_year": {"type": "string", "pattern": "^\\d{4}$"},
    "figure_kind": {"enum": ["plan", "supplementary_plan", "outturn"]},
    "plan_key": {"type": "string"},
    "figure_id": {"type": "string"},
    "revision_no": {"type": "integer", "minimum": 1},
    "accounting_basis": {"$ref": "#/definitions/basis"},
    "amount_text": {"type": ["string", "null"]},
    "amount": {"type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d+)?$"},
    "unit": {"type": "string"},
    "currency": {"type": "string"},
    "normalized": {"$ref": "#/definitions/normalized"},
    "payment_id": {"type": "string"},
    "payment_kind": {"enum": ["commitment", "payment"]},
    "beneficiary": {"type": "string"},
    "beneficiary_key": {"type": "string", "pattern": "^public-finance:beneficiary:"},
    "finding_id": {"type": "string"},
    "report": {"type": "object", "required": ["report_id", "url"]},
    "passage": {"type": "object", "required": ["locator"]},
    "quote": {"type": "string"},
    "cites": {"type": "array"},
    "source_revision": {"$ref": "#/definitions/source_revision"}
  },
  "allOf": [
    {"if": {"properties": {"record_type": {"const": "release"}}},
     "then": {"required": ["release_id", "provider", "published_on", "file_sha256", "evidence_origin"]}},
    {"if": {"properties": {"record_type": {"const": "budget_line"}}},
     "then": {"required": ["line_id", "scheme", "codes", "labels"]}},
    {"if": {"properties": {"record_type": {"const": "figure"}}},
     "then": {"required": ["figure_id", "line_id", "fiscal_year", "figure_kind", "revision_no", "accounting_basis",
                           "amount_text", "unit", "currency", "source_revision"]}},
    {"if": {"properties": {"record_type": {"const": "beneficiary_payment"}}},
     "then": {"required": ["payment_id", "beneficiary", "beneficiary_key", "payment_kind", "accounting_basis",
                           "fiscal_year", "amount_text", "currency", "source_revision"]}},
    {"if": {"properties": {"record_type": {"const": "audit_finding"}}},
     "then": {"required": ["finding_id", "report", "passage", "quote", "cites", "source_revision"]}}
  ],
  "not": {"anyOf": [{"required": ["verdict"]}, {"required": ["waste"]}, {"required": ["fraud"]},
                    {"required": ["forecast"]}, {"required": ["net_total"]}, {"required": ["risk_score"]}]}
}
