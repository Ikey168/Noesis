{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/contracts/noesis-cli-v1.json",
  "title": "Noesis CLI JSON envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cli_contract", "command", "ok"],
  "properties": {
    "cli_contract": {"const": "noesis-cli-v1"},
    "command": {"type": "string", "minLength": 1},
    "ok": {"type": "boolean"},
    "data": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "repair": {"type": "string", "minLength": 1}
      }
    }
  },
  "oneOf": [
    {"properties": {"ok": {"const": true}}, "required": ["data"], "not": {"required": ["error"]}},
    {"properties": {"ok": {"const": false}}, "required": ["error"], "not": {"required": ["data"]}}
  ]
}
