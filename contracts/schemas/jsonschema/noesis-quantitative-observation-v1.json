{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/schemas/noesis-quantitative-observation-v1.json",
  "title": "Noesis vintage-aware quantitative observation",
  "type": "object",
  "required": ["contract", "observation_id", "namespace", "metric_id", "provider", "provider_series_id", "period", "value", "missing", "unit_id", "currency_code", "valid_from_ms", "valid_to_ms", "release_at_ms", "retrieved_at_ms", "vintage_id", "adjustment", "preliminary", "revision_of", "provenance", "generation", "producer", "policy", "principal_id", "input_hash", "created_at_ms"],
  "properties": {
    "contract": {"const": "noesis-quantitative-observation-v1"},
    "observation_id": {"type": "string", "pattern": "^quantitative-observation:"},
    "namespace": {"type": "string", "minLength": 1},
    "metric_id": {"type": "string", "pattern": "^quantitative-metric:"},
    "provider": {"type": "string", "minLength": 1},
    "provider_series_id": {"type": "string", "minLength": 1},
    "period": {"type": "string", "minLength": 1},
    "value": {"type": ["string", "null"]},
    "missing": {"type": "boolean"},
    "unit_id": {"type": "string", "pattern": "^quantitative-unit:"},
    "currency_code": {"type": ["string", "null"]},
    "valid_from_ms": {"type": ["integer", "null"]},
    "valid_to_ms": {"type": ["integer", "null"]},
    "release_at_ms": {"type": "integer", "minimum": 0},
    "retrieved_at_ms": {"type": "integer", "minimum": 0},
    "vintage_id": {"type": "string", "minLength": 1},
    "adjustment": {"enum": ["seasonally-adjusted", "not-adjusted", "trend", "unknown"]},
    "preliminary": {"type": "boolean"},
    "revision_of": {"type": ["string", "null"]},
    "provenance": {"type": "object"},
    "generation": {"type": "integer", "minimum": 0},
    "producer": {"type": "object", "required": ["name", "version"]},
    "policy": {"type": "object"},
    "principal_id": {"type": "string"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "idempotent": {"type": "boolean"}
  },
  "additionalProperties": false
}
