{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noesis-investigation-template-v1",
  "type": "object",
  "required": [
    "contract",
    "template_id",
    "namespace",
    "owner",
    "revision",
    "status",
    "definition"
  ],
  "properties": {
    "contract": {
      "const": "noesis-investigation-template-v1"
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "definition": {
      "type": "object",
      "required": [
        "name",
        "description",
        "parameters",
        "questions",
        "success_criteria",
        "scope",
        "source_packs",
        "report_outline"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "maxProperties": 30,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "object",
          "required": [
            "domains",
            "namespaces"
          ],
          "additionalProperties": false,
          "properties": {
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "source_packs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "pack_id",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "pack_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "report_outline": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "additionalProperties": false
}
