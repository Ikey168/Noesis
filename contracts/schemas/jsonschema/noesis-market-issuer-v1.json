{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-market-issuer-v1.json",
  "title": "Noesis market issuer v1",
  "description": "A stable market-domain identity for a company or other issuer, linked to the authoritative Knowledge Graph entity. Names and external identifiers are dated assertions, not identities.",
  "type": "object",
  "required": ["contract", "namespace", "owner", "issuer_id", "kg_entity_id", "revision_id", "revision", "display_name", "status", "name_assertions", "identifiers", "source_refs", "recorded_at_ms", "record_hash"],
  "properties": {
    "contract": {"const": "noesis-market-issuer-v1"},
    "namespace": {"type": "string", "minLength": 1},
    "owner": {"type": ["string", "null"]},
    "issuer_id": {"type": "string", "minLength": 1, "description": "Opaque, stable Noesis identifier; never derive it from a company name, ticker, CIK or another mutable/provider-scoped value."},
    "kg_entity_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "display_name": {"type": "string", "minLength": 1},
    "legal_name": {"type": ["string", "null"]},
    "status": {"enum": ["active", "inactive", "merged", "unknown"]},
    "name_assertions": {"type": "array", "items": {"$ref": "#/definitions/name_assertion"}},
    "identifiers": {"type": "array", "items": {"$ref": "#/definitions/identifier"}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/source_ref"}},
    "recorded_at_ms": {"type": "integer", "minimum": 0},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "definitions": {
    "source_ref": {
      "type": "object",
      "required": ["source_ref_id", "provider", "provider_object_id", "source_revision_id", "public_at_ms", "source_snapshot_id", "source_url", "retrieved_at_ms", "content_hash", "license_id", "entitlement_id"],
      "properties": {
        "source_ref_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "provider_object_id": {"type": "string", "minLength": 1},
        "source_revision_id": {"type": ["string", "null"]},
        "public_at_ms": {"type": ["integer", "null"], "minimum": 0},
        "source_snapshot_id": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "retrieved_at_ms": {"type": "integer", "minimum": 0},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "license_id": {"type": "string", "minLength": 1},
        "entitlement_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "name_assertion": {
      "type": "object",
      "required": ["value", "valid_from_ms", "valid_to_ms", "source_ref_id"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "valid_from_ms": {"type": "integer", "minimum": 0},
        "valid_to_ms": {"type": ["integer", "null"], "minimum": 0},
        "assertion_status": {"enum": ["active", "retracted"], "default": "active"},
        "source_ref_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "identifier": {
      "type": "object",
      "required": ["scheme", "value", "valid_from_ms", "valid_to_ms", "source_ref_id"],
      "properties": {
        "scheme": {"type": "string", "minLength": 1, "description": "For example cik, lei, or a provider-specific issuer key."},
        "value": {"type": "string", "minLength": 1},
        "valid_from_ms": {"type": "integer", "minimum": 0},
        "valid_to_ms": {"type": ["integer", "null"], "minimum": 0},
        "assertion_status": {"enum": ["active", "retracted"], "default": "active"},
        "source_ref_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
