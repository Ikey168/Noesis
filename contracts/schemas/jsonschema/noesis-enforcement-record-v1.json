{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/noesis-enforcement-record-v1.json",
  "title": "Regulatory enforcement action, respondent, decision, penalty, appeal or notice document as published",
  "description": "One record of the Legal pack's legal.enforcement provider (#2651): what a regulator (US SEC, UK FCA, US EPA through ECHO, an EU supervisory authority through the EDPB Article 60 register) published about one enforcement action outside competition law. Records are immutable revisions keyed by provider and native release, notice, case or register-entry identifier; corrections, supersessions and removals by the source are new revisions, never deletions. Outcomes are kept as published: a settlement and its stated admission wording (for example 'without admitting or denying') are quoted, never merged into a finding. Penalties keep type, amount text, amount and currency as published and are never converted or summed. Natural-person respondents keep an action-scoped pseudonym and role only. No record carries a risk or compliance score, an inference of wrongdoing, a personal profile or legal advice.",
  "type": "object",
  "required": ["contract", "kind", "record_key", "source", "authority"],
  "properties": {
    "contract": {"const": "noesis-enforcement-record-v1"},
    "kind": {"enum": ["enforcement_action", "respondent", "decision", "penalty", "appeal", "notice_document"]},
    "record_key": {"type": "string", "pattern": "^enforcement:(action|respondent|decision|penalty|appeal|document):"},
    "source": {
      "type": "object",
      "required": ["provider", "provider_record_id"],
      "properties": {
        "provider": {"enum": ["us-sec", "uk-fca", "us-epa-echo", "edpb"]},
        "provider_record_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "publisher": {"type": "string"},
        "license": {"type": "string"},
        "revision": {"type": ["string", "null"]},
        "format": {"type": "string"},
        "evidence_origin": {"enum": ["fixture", "live"]},
        "locator": {"type": "object"},
        "note": {"type": "string"},
        "retrieved_at_ms": {"type": "integer"},
        "raw_sha256": {"type": "string"}
      },
      "additionalProperties": false
    },
    "authority": {"type": "string", "pattern": "^(us-sec|uk-fca|us-epa|eu-sa-[a-z]{2})$"},
    "action_key": {"type": "string", "pattern": "^enforcement:action:"},
    "native_id": {"type": "string", "minLength": 1},
    "action_type": {"enum": ["civil_action", "administrative_proceeding", "final_notice", "civil_judicial_case", "administrative_case", "criminal_case", "one_stop_shop_decision"]},
    "action_type_as_published": {"type": "string"},
    "identifiers": {"type": "array", "items": {"type": "object", "required": ["scheme", "value"]}},
    "legal_bases": {"type": "array", "items": {"type": "string"}},
    "initiated_on": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "decided_on": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "published_on": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "outcome_as_published": {"type": ["string", "null"]},
    "settled": {"type": ["boolean", "null"]},
    "admission_wording": {"type": ["string", "null"]},
    "publication_status": {"enum": ["published", "corrected", "removed_by_source"]},
    "court_cases": {"type": "array", "items": {"type": "object", "required": ["docket_number"]}},
    "party_type": {"enum": ["organisation", "natural_person"]},
    "name_as_published": {"type": ["string", "null"]},
    "pseudonym": {"type": ["string", "null"], "pattern": "^natural person \\d{1,3}$"},
    "role_as_published": {"type": "string"},
    "penalty_type": {"enum": ["civil_penalty", "disgorgement", "prejudgment_interest", "financial_penalty", "fine", "federal_penalty", "state_local_penalty", "sep_cost", "cost_recovery", "compliance_action_cost", "restitution", "other"]},
    "amount_as_published": {"type": ["string", "null"]},
    "amount": {"type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d+)?$"},
    "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "status": {"enum": ["stated", "not_published"]},
    "stage": {"enum": ["as_imposed", "after_settlement_discount", "before_settlement_discount", null]},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"party_type": {"const": "natural_person"}}, "required": ["party_type"]},
     "then": {"required": ["pseudonym"], "properties": {"name_as_published": {"type": "null"}}}}
  ],
  "not": {"anyOf": [{"required": ["risk_score"]}, {"required": ["compliance_score"]}, {"required": ["risk_rating"]},
                    {"required": ["finding_of_wrongdoing"]}, {"required": ["wrongdoing"]}, {"required": ["guilty"]},
                    {"required": ["found_liable"]}, {"required": ["person_profile"]}, {"required": ["legal_advice"]},
                    {"required": ["date_of_birth"]}, {"required": ["address"]},
                    {"required": ["individual_reference_number"]}]}
}
