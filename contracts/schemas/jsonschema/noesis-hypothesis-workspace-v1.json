{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/schemas/noesis-hypothesis-workspace-v1.json",
  "title": "Noesis versioned hypothesis workspace",
  "type": "object",
  "required": ["contract", "workspace_id", "namespace", "revision_id", "revision", "predecessor_revision_id", "title", "lifecycle", "hypotheses", "generation", "valid_from_ms", "valid_to_ms", "observed_at_ms", "producer", "policy", "principal_id", "input_hash", "created_at_ms", "parent_workspace_id"],
  "properties": {
    "contract": {"const": "noesis-hypothesis-workspace-v1"},
    "workspace_id": {"type": "string", "pattern": "^hypothesis-workspace:"},
    "namespace": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "pattern": "^hypothesis-revision:"},
    "revision": {"type": "integer", "minimum": 1},
    "predecessor_revision_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["draft", "active", "retired"]},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "label", "statement", "assumptions", "predictions", "alternative_to", "status"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "statement": {"type": "string", "minLength": 1},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "predictions": {"type": "array", "items": {"type": "object"}},
          "alternative_to": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "generation": {"type": "integer", "minimum": 0},
    "valid_from_ms": {"type": ["integer", "null"]},
    "valid_to_ms": {"type": ["integer", "null"]},
    "observed_at_ms": {"type": "integer", "minimum": 0},
    "producer": {"type": "object", "required": ["name", "version"]},
    "policy": {"type": "object"},
    "principal_id": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "parent_workspace_id": {"type": ["string", "null"]},
    "idempotent": {"type": "boolean"}
  },
  "additionalProperties": false
}
