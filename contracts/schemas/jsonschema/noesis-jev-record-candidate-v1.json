{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/contracts/noesis-jev-record-candidate-v1.json",
  "title": "Version-bound Jev record candidate suggestion",
  "type": "object",
  "required": ["contract", "task", "status", "accepted", "source_binding", "decision_run"],
  "properties": {
    "contract": {"const": "noesis-jev-record-candidate-v1"},
    "task": {"enum": ["methodology", "entity_identity", "source_identity"]},
    "status": {"enum": ["suggested", "shadow", "unavailable"]},
    "accepted": {"const": false},
    "source_binding": {"type": "array", "minItems": 1},
    "decision_run": {"type": "object"},
    "study_id": {"type": "string"}, "study_revision_id": {"type": "string"},
    "statement_id": {"type": "string"}, "source_revision_id": {"type": "string"},
    "source_locator": {"type": "object"}, "categories": {"type": "object"},
    "numeric_values_generated": {"const": false},
    "reference_id": {"type": "string"}, "candidate_ids": {"type": "array", "minItems": 1, "maxItems": 10},
    "record_versions": {"type": "object"},
    "selected_candidate_id": {"type": ["string", "null"]},
    "assessment": {"enum": ["match", "none", "uncertain", null]},
    "ownership_assessed": {"const": false},
    "independence_assessed": {"const": false},
    "corroboration_assessed": {"const": false}
  },
  "additionalProperties": false
}
