{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/contracts/noesis-source-pack-v1.json",
  "type": "object",
  "required": ["contract", "pack_id", "version", "description", "domains", "sources", "manifest_hash"],
  "properties": {
    "contract": {"const": "noesis-source-pack-v1"},
    "pack_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"},
    "description": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "connector", "endpoint", "publisher", "scope", "license", "update_cadence", "temporal_semantics", "mapping", "extractor_versions", "schedule", "budgets", "auth", "fixture", "health", "operations", "source_hash"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "connector": {"enum": ["berlin-law", "blog", "cellar", "dataset", "ddb", "declarative-rest", "epo-ops", "eprel", "europeana", "filings", "geojson", "git", "gleif", "icecat", "iso-open-data", "manifest", "package-registry", "paper", "rii", "web", "wfs"]},
          "wfs": {
            "type": "object",
            "description": "Pinned WFS 2.0.0 GetFeature contract; required for the wfs connector.",
            "required": ["version", "type_names", "output_format", "srs_name", "axis_order", "sort_by", "page_size"],
            "properties": {
              "version": {"const": "2.0.0"},
              "type_names": {"type": "string", "minLength": 1},
              "output_format": {"type": "string", "minLength": 1},
              "srs_name": {"type": "string", "minLength": 1},
              "axis_order": {"type": "string", "minLength": 1},
              "sort_by": {"type": "string", "minLength": 1},
              "page_size": {"type": "integer", "minimum": 1, "maximum": 10000}
            }
          },
          "geospatial": {
            "type": "object",
            "description": "Feature projection settings for wfs/geojson sources (namespace, geometry types, precision, attribution)."
          },
          "standards": {
            "type": "object",
            "description": "Bounded standards catalogue selection: reference prefixes and/or ICS codes with a record ceiling.",
            "required": ["selection"],
            "properties": {"namespace": {"type": "string", "minLength": 1}, "selection": {"type": "object"}}
          },
          "lei": {
            "type": "object",
            "description": "Bounded GLEIF selection: 1-50 LEIs and the parts to read (record, parent relationships, reporting exceptions).",
            "required": ["leis"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1},
              "leis": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "pattern": "^[0-9A-Z]{18}[0-9]{2}$"}}
            }
          },
          "patent": {
            "type": "object",
            "description": "Bounded EPO OPS selection: 1-25 docdb publication numbers and the parts to read (biblio, family, legal, claims).",
            "required": ["publications"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1},
              "publications": {"type": "array", "minItems": 1, "maxItems": 25, "items": {"type": "string", "pattern": "^[A-Z]{2}\\.[0-9A-Z]{1,15}\\.[A-Z][0-9]?$"}},
              "parts": {"type": "array", "items": {"enum": ["biblio", "family", "legal", "claims"]}}
            }
          },
          "cultural": {
            "type": "object",
            "description": "Bounded cultural-object query for ddb/europeana sources: namespace, explicit query and filters, rows per page, record ceiling and place-precision policy.",
            "required": ["query", "rows", "max_records"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1},
              "query": {"type": "object", "required": ["q"]},
              "rows": {"type": "integer", "minimum": 1, "maximum": 100},
              "max_records": {"type": "integer", "minimum": 1, "maximum": 500}
            }
          },
          "legal": {
            "type": "object",
            "description": "Bounded legal selection for cellar/rii/berlin-law sources: namespace and explicit CELEX+languages, doknr list or index window, or official Berlin publications.",
            "required": ["selection"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1},
              "selection": {"type": ["object", "array"]}
            }
          },
          "product": {
            "type": "object",
            "description": "Bounded model selection for icecat/eprel sources: namespace, category, market, language, 1-50 explicit selectors and the document retention policy.",
            "required": ["category", "selection"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1},
              "category": {"type": "object", "required": ["label"]},
              "documents": {"type": "object"},
              "selection": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "minProperties": 1}}
            }
          },
          "endpoint": {"type": "string", "pattern": "^https://"},
          "publisher": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "license": {
            "type": "object",
            "required": ["id", "terms_url", "redistribution"],
            "properties": {"id": {"type": "string"}, "terms_url": {"type": "string", "pattern": "^https://"}, "redistribution": {"type": "string"}},
            "additionalProperties": false
          },
          "update_cadence": {"type": "string"},
          "temporal_semantics": {"type": "string"},
          "mapping": {"type": "object", "required": ["target_schema", "version"], "properties": {"target_schema": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false},
          "extractor_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "schedule": {"type": "object", "required": ["kind", "interval_s"]},
          "budgets": {"type": "object", "required": ["timeout_ms", "max_results", "max_bytes", "max_pages"], "properties": {"timeout_ms": {"type": "integer", "minimum": 1, "maximum": 120000}, "max_results": {"type": "integer", "minimum": 1, "maximum": 100000}, "max_bytes": {"type": "integer", "minimum": 1, "maximum": 100000000}, "max_pages": {"type": "integer", "minimum": 1, "maximum": 100}}, "additionalProperties": false},
          "auth": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["none", "optional-secret", "required-secret"]}, "secret_ref": {"type": "string", "pattern": "^NOESIS_[A-Z0-9_]+$"}}, "additionalProperties": false},
          "fixture": {"type": "object", "required": ["path", "sha256", "expected_output_hash"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "expected_output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
          "health": {"type": "object", "required": ["required", "max_staleness_s"]},
          "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "policy": {"type": "object"},
          "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
