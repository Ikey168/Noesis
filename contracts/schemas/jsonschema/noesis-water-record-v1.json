{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noesis-water-record-v1",
  "title": "Water record statement: what one provider published about a gauging station, an observation, a water body or its status in one reporting cycle",
  "description": "One statement a Climate and Environment water adapter emits (PEGELONLINE stations and measurements, USGS Water Data monitoring locations and daily values, EEA WISE Water Framework Directive water-body status) and src.kb.water_store keeps as an immutable revision with source, revision and retrieval time. Record types: station (native id, name, river, location and gauge zero or datum as published, published characteristic values), observation (parameter, unit, time, value and quality state as published, qualifiers per value), water_body (EU code, name, category, river basin district) and assessment (one reporting cycle's ecological and chemical status as reported). No statement carries a forecast, an interpolated or gap-filled value, a Noesis status assessment, a flood-risk score or personal data.",
  "type": "object",
  "required": ["contract", "record_type", "provider", "record_key", "subject", "as_published", "effective", "source", "unknowns"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "noesis-water-record-v1"},
    "record_type": {"enum": ["station", "observation", "water_body", "assessment"]},
    "provider": {"enum": ["pegelonline", "usgs", "eea-wise"]},
    "record_key": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "required": ["key", "kind"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "kind": {"enum": ["station", "observation", "water_body"]},
        "name": {"type": ["string", "null"]}
      }
    },
    "as_published": {
      "type": "object",
      "propertyNames": {"not": {"enum": ["forecast", "predicted", "interpolated", "gap_filled", "flood_risk", "risk_score", "derived_status", "noesis_status", "contact", "email", "phone", "person"]}}
    },
    "effective": {
      "type": "object",
      "required": ["event"],
      "properties": {
        "event": {"enum": ["published", "removed"]},
        "date": {"type": ["string", "null"]},
        "date_basis": {"type": ["string", "null"]}
      }
    },
    "source": {
      "type": "object",
      "required": ["url"],
      "properties": {"url": {"type": "string", "pattern": "^https://"}}
    },
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"record_type": {"const": "station"}}},
      "then": {"properties": {"as_published": {
        "required": ["native_id", "name", "location"],
        "properties": {
          "location": {"type": "object", "properties": {
            "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
            "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180}}},
          "thresholds": {"type": ["array", "null"], "items": {"type": "object", "required": ["name", "parameter", "unit"]}}
        }
      }}}
    },
    {
      "if": {"properties": {"record_type": {"const": "observation"}}},
      "then": {"properties": {"as_published": {
        "required": ["station_id", "parameter", "parameter_code", "time", "value", "unit", "quality"],
        "properties": {
          "parameter": {"enum": ["water_level", "discharge", "water_temperature"]},
          "value": {"type": "number"},
          "quality": {"type": "object", "required": ["state"], "properties": {"state": {"enum": ["provisional", "approved", "unknown"]}}},
          "qualifiers": {"type": ["array", "null"], "items": {"type": "string"}}
        }
      }}}
    },
    {
      "if": {"properties": {"record_type": {"const": "water_body"}}},
      "then": {"properties": {"as_published": {
        "required": ["eu_code", "name", "category"],
        "properties": {"category": {"enum": ["river", "lake", "transitional", "coastal", "territorial", "groundwater", "unknown"]}}
      }}}
    },
    {
      "if": {"properties": {"record_type": {"const": "assessment"}}},
      "then": {"properties": {"as_published": {
        "required": ["eu_code", "reporting_cycle", "cycle_year"],
        "properties": {"cycle_year": {"type": "string", "pattern": "^\\d{4}$"}}
      }}}
    }
  ]
}
