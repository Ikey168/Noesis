{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/noesis-jev-revision-significance-evaluation-v1.json",
  "title": "Revision significance comparison against labeled edits",
  "type": "object",
  "required": ["contract", "cases", "threshold", "coverage", "substantive_recall", "cosmetic_false_positive_rate", "label_origins", "automatic_change_brief_selection_enabled"],
  "properties": {
    "contract": {"const": "noesis-jev-revision-significance-evaluation-v1"},
    "cases": {"type": "integer", "minimum": 1},
    "threshold": {"type": "integer", "minimum": 1, "maximum": 3},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "substantive_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "cosmetic_false_positive_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "label_origins": {"type": "array", "items": {"enum": ["independent-human", "fixture"]}},
    "automatic_change_brief_selection_enabled": {"const": false}
  },
  "additionalProperties": false
}
