{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/contracts/noesis-technical-impact-v1.json",
  "title": "Technical dependency impact assessment",
  "type": "object",
  "required": ["contract", "inventory_id", "inventory_hash", "offset", "total", "findings", "coverage_note"],
  "properties": {
    "contract": {"const": "noesis-technical-impact-v1"},
    "inventory_id": {"type": "string"},
    "inventory_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "offset": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 0},
    "coverage_note": {"type": "string"},
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["entry", "overall", "advisories", "upstream_review_candidates"],
        "properties": {
          "entry": {"type": "object"},
          "overall": {"enum": ["affected", "unknown"]},
          "reason": {"type": "string"},
          "advisories": {"type": "array", "items": {
            "type": "object",
            "required": ["advisory_id", "finding", "source_document_id", "range_type"],
            "properties": {
              "advisory_id": {"type": "string"},
              "finding": {"enum": ["affected", "unaffected_under_assessed_range", "unknown"]},
              "reason": {"type": ["string", "null"]},
              "source_document_id": {"type": ["string", "null"]},
              "range_type": {"type": "string"}
            }
          }},
          "upstream_review_candidates": {"type": "array", "maxItems": 5, "items": {"type": "object"}}
        }
      }
    }
  }
}
