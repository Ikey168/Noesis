{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/schemas/noesis-quantitative-metric-v1.json",
  "title": "Noesis quantitative metric revision",
  "type": "object",
  "required": ["contract", "metric_id", "namespace", "revision_id", "revision", "predecessor_revision_id", "canonical_name", "definition", "unit_id", "dimension", "frequency", "population", "synonyms", "mappings", "formula", "generation", "valid_from_ms", "valid_to_ms", "observed_at_ms", "producer", "policy", "principal_id", "input_hash", "created_at_ms"],
  "properties": {
    "contract": {"const": "noesis-quantitative-metric-v1"},
    "metric_id": {"type": "string", "pattern": "^quantitative-metric:"},
    "namespace": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "pattern": "^quantitative-metric-revision:"},
    "revision": {"type": "integer", "minimum": 1},
    "predecessor_revision_id": {"type": ["string", "null"]},
    "canonical_name": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "pattern": "^quantitative-unit:"},
    "dimension": {"type": "object", "additionalProperties": {"type": "integer"}},
    "frequency": {"enum": ["instant", "daily", "weekly", "monthly", "quarterly", "annual", "irregular"]},
    "population": {"type": "object"},
    "synonyms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "mappings": {"type": "object", "additionalProperties": {"type": "string"}},
    "formula": {"type": ["object", "null"]},
    "generation": {"type": "integer", "minimum": 0},
    "valid_from_ms": {"type": ["integer", "null"]},
    "valid_to_ms": {"type": ["integer", "null"]},
    "observed_at_ms": {"type": "integer", "minimum": 0},
    "producer": {"type": "object", "required": ["name", "version"]},
    "policy": {"type": "object"},
    "principal_id": {"type": "string"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "idempotent": {"type": "boolean"},
    "history": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
