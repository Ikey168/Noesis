{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/schemas/noesis-event-record-v2.json",
  "title": "Noesis immutable event record revision",
  "type": "object",
  "required": ["contract", "event_id", "namespace", "revision_id", "revision", "predecessor_revision_id", "event_type", "lifecycle", "granularity", "participants", "location", "time", "recurrence_key", "evidence", "generation", "valid_from_ms", "valid_to_ms", "observed_at_ms", "producer", "policy", "provenance", "principal_id", "input_hash", "created_at_ms"],
  "properties": {
    "contract": {"const": "noesis-event-record-v2"},
    "event_id": {"type": "string", "pattern": "^event:"},
    "namespace": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "pattern": "^event-revision:"},
    "revision": {"type": "integer", "minimum": 1},
    "predecessor_revision_id": {"type": ["string", "null"]},
    "event_type": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["planned", "ongoing", "completed", "cancelled", "corrected"]},
    "granularity": {"enum": ["instant", "interval", "series", "process", "unknown"]},
    "participants": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "location": {"type": ["object", "string", "null"]},
    "time": {"type": "object", "required": ["start_ms", "end_ms"]},
    "recurrence_key": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "generation": {"type": "integer", "minimum": 0},
    "valid_from_ms": {"type": ["integer", "null"]},
    "valid_to_ms": {"type": ["integer", "null"]},
    "observed_at_ms": {"type": "integer", "minimum": 0},
    "producer": {"type": "object", "required": ["name", "version"]},
    "policy": {"type": "object"},
    "provenance": {"type": "object"},
    "principal_id": {"type": "string"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "idempotent": {"type": "boolean"}
  },
  "additionalProperties": false
}
