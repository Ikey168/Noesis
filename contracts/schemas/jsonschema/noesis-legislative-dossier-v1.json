{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/noesis-legislative-dossier-v1.json",
  "title": "Versioned legislative dossier",
  "description": "Additive in place (#2208, LT02): US and GB jurisdictions, the debate stage category and an optional per-stage legislation detail; DE and EU dossiers are unchanged, so the contract version stays v1.",
  "type": "object",
  "required": ["contract", "dossier_id", "namespace", "owner", "jurisdiction", "procedure_id", "revision", "stages", "review_candidates", "missing_stages"],
  "properties": {
    "contract": {"const": "noesis-legislative-dossier-v1"},
    "dossier_id": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "jurisdiction": {"enum": ["DE", "EU", "US", "GB"]},
    "procedure_id": {"type": "string", "minLength": 1},
    "raw_procedure_id": {"type": "string", "minLength": 1},
    "procedure_identity_state": {"enum": ["instrument_anchor_only", "source_linked_procedure"]},
    "revision": {"type": "integer", "minimum": 1},
    "stages": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/stage"}},
    "review_candidates": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/stage"}},
    "missing_stages": {"type": "array", "items": {"enum": ["proposal", "amendment", "vote", "adoption", "publication", "commencement", "repeal"]}}
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["namespace", "document_id", "revision_id", "source_id", "url", "content_hash", "payload_hash"],
      "properties": {
        "namespace": {"type": "string"}, "document_id": {"type": "string"},
        "revision_id": {"type": "string"}, "source_id": {"type": "string"},
        "url": {"type": "string", "pattern": "^https://"},
        "content_hash": {"type": "string"}, "payload_hash": {"type": "string"}
      }
    },
    "legislation": {
      "type": "object",
      "description": "A US Congress or UK Parliament record as its provider published it (noesis-legislation-record-v1 fields); a source assertion, never reconciled with another provider.",
      "required": ["record_kind", "record_key", "provider", "fields"],
      "properties": {
        "record_kind": {"enum": ["us-bill", "us-bill-status", "us-text-version", "us-roll-call", "uk-bill", "uk-stage", "uk-publication", "uk-division", "uk-debate-reference"]},
        "record_key": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "bill_key": {"type": ["string", "null"]},
        "bill_link": {"type": "object"},
        "native_revision": {"type": ["string", "null"]},
        "evidence_origin": {"enum": ["fixture", "live", null]},
        "fields": {"type": "object"}
      }
    },
    "stage": {
      "type": "object",
      "required": ["stage_id", "stage", "jurisdiction", "raw_document_id", "normalized_document_id", "observed_at_ms", "citation", "legal_events"],
      "properties": {
        "stage_id": {"type": "string"},
        "stage": {"enum": ["proposal", "amendment", "vote", "adoption", "publication", "commencement", "repeal", "debate"]},
        "jurisdiction": {"enum": ["DE", "EU", "US", "GB"]},
        "raw_document_id": {"type": "string"},
        "normalized_document_id": {"type": "string"},
        "observed_at_ms": {"type": "integer", "minimum": 0},
        "citation": {"$ref": "#/$defs/citation"},
        "legal_events": {"type": "array", "maxItems": 20},
        "link_basis": {"type": ["string", "null"]},
        "legislation": {"$ref": "#/$defs/legislation"}
      }
    }
  }
}
