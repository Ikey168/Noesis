{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://noesis.local/schemas/noesis-source-research-objective-v1.json",
  "title": "Noesis constrained research objective", "type": "object",
  "required": ["contract", "objective_id", "namespace", "question", "decomposition", "evidence_classes", "constraints", "generation", "observed_at_ms", "producer", "policy", "provenance", "input_hash", "created_at_ms"],
  "properties": {
    "contract": {"const": "noesis-source-research-objective-v1"}, "objective_id": {"type": "string"}, "namespace": {"type": "string"}, "question": {"type": "string"},
    "decomposition": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "evidence_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "constraints": {"type": "object"},
    "generation": {"type": "integer"}, "valid_from_ms": {"type": ["integer", "null"]}, "valid_to_ms": {"type": ["integer", "null"]}, "observed_at_ms": {"type": "integer"},
    "producer": {"type": "object"}, "policy": {"type": "object"}, "provenance": {"type": "object"}, "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at_ms": {"type": "integer"}, "idempotent": {"type": "boolean"}
  }, "additionalProperties": false
}
