{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noesis-social-protection-record-v2",
  "title": "Social protection series item: one series of one release (society.social-protection)",
  "description": "One published series as a source released it (Eurostat ESSPROS, OECD SOCX or ILOSTAT SDG 1.3.1): source, dataset or dataflow, measure (expenditure, beneficiaries or coverage), the publisher's own classification (ESSPROS function or pension category, SOCX policy area, ILO contingency), scheme or benefit type, source of financing, cash or in kind, gross or net basis, sex, unit as published, place, ILO's population denominator, the definition the source states (ESSPROS manual edition, SOCX methodology, ILO NOTE_SOURCE, NOTE_INDICATOR and NOTE_CLASSIF verbatim) and the observations (value text as published, cell status, the source-stated publication status, flags verbatim). Each release is appended as a vintage by src/kb/social_protection_store.py, never overwritten; removals, corrections and restating report editions are vintages. No record carries person- or household-level data; a confidential or unpublished cell carries no value ('c' is a status, never a value); nothing is nowcast, filled, recomputed, blended, re-classified, derived or forecast; COFOG functions are never stored here.",
  "type": "object",
  "required": ["provider", "dataset", "native_key", "measure", "function", "scheme_type", "financing", "cash_or_kind", "basis", "sex", "unit", "area", "frequency", "definition", "observations"],
  "definitions": {
    "code": {
      "type": "object",
      "required": ["code"],
      "properties": {"code": {"type": "string", "minLength": 1}, "label": {"type": ["string", "null"]}}
    },
    "observation": {
      "type": "object",
      "required": ["period", "status", "flags"],
      "properties": {
        "period": {"type": "string", "pattern": "^\\d{4}(-\\d{2})?$"},
        "value_text": {"type": ["string", "null"]},
        "value": {"type": ["string", "null"]},
        "status": {"enum": ["reported", "confidential", "not_published"]},
        "publication_status": {"enum": ["not-stated", "normal", "provisional", "estimated", "projected"]},
        "origin": {"const": "published"},
        "flags": {"type": "object", "additionalProperties": {"type": "string"}},
        "flag_meanings": {"type": "array", "items": {"type": "string"}},
        "attributes": {"type": "object"}
      },
      "if": {"properties": {"status": {"not": {"const": "reported"}}}},
      "then": {"properties": {"value": {"type": "null"}}}
    }
  },
  "properties": {
    "provider": {"enum": ["eurostat-esspros", "oecd-socx", "ilo-social-protection-coverage"]},
    "dataset": {"type": "string", "minLength": 1},
    "native_key": {"type": "string", "minLength": 1},
    "dataflow": {"type": "object"},
    "measure": {
      "type": "object",
      "required": ["concept"],
      "properties": {
        "concept": {"enum": ["expenditure", "beneficiaries", "coverage"]},
        "code": {"type": "string"},
        "label": {"type": "string"}
      }
    },
    "function": {
      "type": "object",
      "required": ["scheme", "code"],
      "properties": {
        "scheme": {"enum": ["esspros-spfunc", "esspros-pension-category", "socx-branch", "ilo-contingency"]},
        "code": {"type": "string", "minLength": 1},
        "label": {"type": ["string", "null"]}
      }
    },
    "scheme_type": {"$ref": "#/definitions/code"},
    "financing": {"$ref": "#/definitions/code"},
    "cash_or_kind": {"$ref": "#/definitions/code"},
    "basis": {"$ref": "#/definitions/code"},
    "sex": {"$ref": "#/definitions/code"},
    "unit": {"$ref": "#/definitions/code"},
    "area": {
      "type": "object",
      "required": ["scheme", "code"],
      "properties": {
        "scheme": {"enum": ["eurostat-geo", "iso3166-1-alpha3"]},
        "code": {"type": "string"},
        "label": {"type": ["string", "null"]}
      }
    },
    "population": {"type": ["object", "null"]},
    "frequency": {"enum": ["annual"]},
    "definition": {"type": "object", "required": ["provider", "function"]},
    "references": {"type": "array"},
    "source_notes": {"type": "array"},
    "observations": {"type": "array", "items": {"$ref": "#/definitions/observation"}}
  }
}
