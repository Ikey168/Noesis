{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.com/schemas/composition/noesis-workflow-template-v1.json",
  "title": "Noesis workflow template",
  "description": "Parameters, required capabilities with contract ranges, ordered steps with declared effects, permitted record kinds and expected artifacts. A template names capabilities, never providers, stores or code; resolution picks the providers. Templates compile to research recipes and run through the existing recipe runner. Runtime validation: src/composition/workflows.py:validate_template.",
  "type": "object",
  "required": ["contract", "template_id", "version", "owner_pack", "description", "parameters", "steps", "permitted_record_kinds", "expected_artifacts"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "noesis-workflow-template-v1"},
    "template_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$", "maxLength": 128},
    "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"},
    "owner_pack": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "mode": {"type": "string", "maxLength": 64},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "parameters": {
      "type": "object", "maxProperties": 30,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {
        "type": "object", "required": ["type"], "additionalProperties": false,
        "properties": {
          "type": {"enum": ["string", "number", "integer", "boolean", "array", "object"]},
          "description": {"type": "string", "maxLength": 500},
          "required": {"type": "boolean"},
          "default": {}
        }
      }
    },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "capability", "range", "effect"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "capability": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
          "range": {"type": "string", "minLength": 1, "maxLength": 64},
          "effect": {"enum": ["read-only", "local-mutation", "acquisition", "external-publication"]},
          "optional": {"type": "boolean"},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "arguments": {"type": "object"},
          "description": {"type": "string", "maxLength": 500}
        }
      }
    },
    "permitted_record_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_artifacts": {
      "type": "array", "maxItems": 20,
      "items": {"type": "object", "required": ["kind", "name"], "additionalProperties": false,
                "properties": {"kind": {"type": "string"}, "name": {"type": "string"}, "from_step": {"type": "string"}}}
    },
    "source_packs": {
      "type": "array", "maxItems": 20,
      "items": {"type": "object", "required": ["pack_id", "version"], "additionalProperties": false,
                "properties": {"pack_id": {"type": "string"}, "version": {"type": "string"}, "manifest_sha256": {"type": "string"}}}
    },
    "origin": {"type": "object", "description": "Present when adapted from an investigation template: its id and revision."}
  }
}
