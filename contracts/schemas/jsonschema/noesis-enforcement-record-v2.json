{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/noesis-enforcement-record-v2.json",
  "title": "Regulatory enforcement authority, action, respondent, notice, penalty or appeal as published",
  "description": "One record of the Legal pack's regulatory enforcement feature (#2651), stored as immutable revisions in the enforcement store. An action is keyed by authority and native identifier (SEC release or file number, FCA notice reference, ECHO case number, EDPB Article 60 register entry) with action type, legal bases and charges as cited, key dates, the outcome as published (a settlement keeps the published admission wording), court cases as citations, facilities by published FRS identifier and lead/concerned authorities. Respondents are organisational only, name and role as published, with published identifiers and no identity resolution; natural persons are counted on the action, never named (EN01 minimisation). Notices are versioned documents; penalties keep the published amount text and currency, with undisclosed amounts explicit; appeals keep forum, reference and status as published. Corrections and removals by the source are revisions. No record carries a risk or compliance score, an inferred finding of wrongdoing, a merged settlement finding, a personal profile or legal advice.",
  "type": "object",
  "required": ["contract", "kind", "record_key", "source", "authority"],
  "properties": {
    "contract": {"const": "noesis-enforcement-record-v2"},
    "kind": {"enum": ["authority", "enforcement_action", "respondent", "enforcement_decision", "penalty", "appeal"]},
    "record_key": {"type": "string", "pattern": "^enforcement:(authority|action|respondent|decision|penalty|appeal):"},
    "source": {
      "type": "object",
      "required": ["provider", "provider_record_id"],
      "properties": {
        "provider": {"enum": ["us-sec", "uk-fca", "us-epa-echo", "edpb-art60"]},
        "provider_record_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "publisher": {"type": "string"},
        "license": {"type": "string"},
        "revision": {"type": ["string", "null"]},
        "evidence_origin": {"enum": ["fixture", "live"]},
        "locator": {"type": "object"},
        "note": {"type": "string"},
        "retrieved_at_ms": {"type": "integer"},
        "raw_sha256": {"type": "string"}
      },
      "additionalProperties": false
    },
    "authority": {"type": "string", "pattern": "^[a-z]{2}-[a-z0-9-]{2,40}$"},
    "action_number": {"type": "string", "minLength": 1},
    "action_key": {"type": "string", "pattern": "^enforcement:action:"},
    "action_type": {"enum": ["civil_action", "administrative_proceeding", "final_notice", "civil_judicial", "administrative_formal", "criminal", "art60_final_decision", "other"]},
    "source_status": {"enum": ["published", "corrected", "removed_by_source"]},
    "initiated_on": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "decided_on": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "published_on": {"type": ["string", "null"], "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "legal_bases": {"type": ["array", "null"], "items": {"type": "string"}},
    "charges_as_published": {"type": ["array", "null"], "items": {"type": "string"}},
    "outcome_as_published": {"type": ["string", "null"]},
    "settlement": {
      "type": ["object", "null"],
      "properties": {
        "settled_as_published": {"type": ["boolean", "null"]},
        "admission_as_published": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "natural_person_respondents": {"type": ["integer", "null"], "minimum": 0},
    "court_cases": {"type": ["array", "null"], "items": {"type": "object", "required": ["docket_number"]}},
    "facilities": {"type": ["array", "null"], "items": {"type": "object"}},
    "respondent_type": {"const": "organisation"},
    "role": {"enum": ["respondent", "defendant", "firm", "controller", "processor", "other"]},
    "identifiers": {"type": ["array", "null"], "items": {"type": "object", "required": ["scheme", "value"]}},
    "penalty_type": {"enum": ["civil_penalty", "disgorgement", "prejudgment_interest", "financial_penalty", "penalty_before_settlement_discount", "federal_penalty", "state_local_penalty", "supplemental_environmental_project", "cost_recovery", "compliance_action_cost", "administrative_fine", "other"]},
    "amount_as_published": {"type": ["string", "null"]},
    "amount_status": {"enum": ["stated", "not_published"]},
    "currency": {"type": ["string", "null"]},
    "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "unknowns": {"type": ["array", "null"], "items": {"type": "string"}}
  },
  "not": {"anyOf": [{"required": ["risk_score"]}, {"required": ["compliance_score"]}, {"required": ["finding_of_wrongdoing"]},
                    {"required": ["violation_found"]}, {"required": ["guilty"]}, {"required": ["legal_advice"]},
                    {"required": ["date_of_birth"]}, {"required": ["home_address"]}, {"required": ["nationality"]}]}
}
