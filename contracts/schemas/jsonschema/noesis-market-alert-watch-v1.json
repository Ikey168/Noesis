{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-market-alert-watch-v1.json",
  "type": "object",
  "required": ["contract", "namespace", "watch_id", "watch_key", "version", "owner", "rules", "notification", "status", "record_hash", "recorded_at_ms"],
  "properties": {
    "contract": {"const": "noesis-market-alert-watch-v1"},
    "namespace": {"type": "string", "minLength": 1},
    "watch_id": {"type": "string", "minLength": 1},
    "watch_key": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "owner": {"type": "string", "minLength": 1},
    "rules": {"type": "object", "required": ["triggers"], "properties": {"triggers": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object"}}}, "additionalProperties": true},
    "notification": {"type": "object"},
    "status": {"enum": ["active", "paused", "retired"]},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recorded_at_ms": {"type": "integer", "minimum": 0},
    "idempotent": {"type": "boolean"}
  },
  "additionalProperties": true
}
