{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-standard-catalogue-v1.json",
  "title": "Noesis standard catalogue record v1",
  "description": "One ISO Open Data deliverable as acquired: reference, edition, stage/status, ICS, replaces/replaced-by. Catalogue metadata only.",
  "type": "object",
  "required": [
    "contract",
    "provider",
    "native_id",
    "reference",
    "status",
    "catalogue_url",
    "content_access"
  ],
  "properties": {
    "contract": {
      "const": "noesis-standard-catalogue-v1"
    },
    "provider": {
      "const": "iso-open-data"
    },
    "native_id": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "published",
        "under-review",
        "withdrawn",
        "under-development",
        "unknown"
      ]
    },
    "catalogue_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "content_access": {
      "const": "protected-link-only"
    },
    "replaces": {
      "type": "array"
    },
    "replaced_by": {
      "type": "array"
    }
  }
}
