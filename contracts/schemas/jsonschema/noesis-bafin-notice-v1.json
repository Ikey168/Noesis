{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noesis-bafin-notice-v1",
  "title": "BaFin capital-market notice: voting-rights notification, managers' transaction, net short position, warning, measure or authorised entity",
  "description": "What one source publishes, with event, notification and publication dates explicit and corrections as links to the notice they correct. Percentages keep their WpHG basis (§ 33 shares, § 38 instruments, § 39 total) and are never summed across notifiers; a net short position below 0.5 % is a publication-end marker, never 0 %. Managers are held by a pseudonymous, issuer-scoped person reference. Absent values are null and listed in unknowns. No record carries advice, a signal or a sentiment score.",
  "type": "object",
  "required": ["contract", "kind", "source", "unknowns"],
  "definitions": {
    "day": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "pct": {"type": ["string", "null"], "pattern": "^\\d{1,3}(\\.\\d+)?$"},
    "decimal": {"type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d+)?$"},
    "issuer": {
      "type": "object",
      "properties": {
        "name": {"type": ["string", "null"]},
        "isin": {"type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"},
        "isin_stated": {"type": ["string", "null"]},
        "lei": {"type": ["string", "null"], "pattern": "^[0-9A-Z]{18}[0-9]{2}$"}
      },
      "additionalProperties": false
    },
    "party": {
      "type": "object",
      "properties": {
        "name": {"type": ["string", "null"]},
        "ref": {"type": ["string", "null"]},
        "kind": {"enum": ["natural_person", "legal_person", "unknown"]},
        "seat": {"type": ["string", "null"]},
        "country": {"type": ["string", "null"]},
        "lei": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "closely_associated": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "percentages": {
      "type": "object",
      "properties": {
        "s33": {"$ref": "#/definitions/pct"},
        "s38_1_1": {"$ref": "#/definitions/pct"},
        "s38_1_2": {"$ref": "#/definitions/pct"},
        "s38": {"$ref": "#/definitions/pct"},
        "s39": {"$ref": "#/definitions/pct"}
      },
      "additionalProperties": false
    },
    "citation": {
      "type": "object",
      "required": ["raw"],
      "properties": {
        "raw": {"type": "string"},
        "statute": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "celex": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "contract": {"const": "noesis-bafin-notice-v1"},
    "kind": {"enum": ["voting_rights_notification", "managers_transaction", "net_short_position", "bafin_warning", "bafin_measure", "authorised_entity"]},
    "source": {
      "type": "object",
      "required": ["provider", "source_id", "source_id_basis"],
      "properties": {
        "provider": {"enum": ["bafin-voting-rights", "bafin-managers-transactions", "bundesanzeiger-short-positions", "bafin-company-database", "bafin-warnings-measures"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_id_basis": {"enum": ["stated", "derived"]},
        "url": {"type": ["string", "null"], "pattern": "^https://"},
        "locator": {"type": ["object", "null"]},
        "retrieved_at_ms": {"type": ["integer", "null"]},
        "file_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "document": {"type": ["string", "null"]},
        "evidence_origin": {"enum": ["fixture", "live", null]}
      },
      "additionalProperties": false
    },
    "event_date": {"$ref": "#/definitions/day"},
    "notification_date": {"$ref": "#/definitions/day"},
    "publication_date": {"$ref": "#/definitions/day"},
    "correction_of": {
      "type": ["object", "null"],
      "properties": {
        "source_id": {"type": ["string", "null"]},
        "publication_date": {"$ref": "#/definitions/day"},
        "stated": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "withdrawn": {"type": ["boolean", "null"]},
    "legal_basis": {"type": ["array", "null"], "items": {"$ref": "#/definitions/citation"}},
    "native": {"type": ["object", "null"]},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "issuer": {"$ref": "#/definitions/issuer"},
    "notifier": {"$ref": "#/definitions/party"},
    "chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position", "name"],
        "properties": {
          "position": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "voting_rights_pct": {"$ref": "#/definitions/pct"},
          "instruments_pct": {"$ref": "#/definitions/pct"},
          "total_pct": {"$ref": "#/definitions/pct"}
        },
        "additionalProperties": false
      }
    },
    "thresholds": {"type": "array", "items": {"type": "string"}},
    "percentages": {"$ref": "#/definitions/percentages"},
    "previous_percentages": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/percentages"}]},
    "reason": {"type": ["string", "null"]},
    "person": {"$ref": "#/definitions/party"},
    "instrument": {
      "type": "object",
      "properties": {
        "isin": {"type": ["string", "null"]},
        "isin_stated": {"type": ["string", "null"]},
        "type": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "nature": {"type": ["string", "null"]},
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "price": {"$ref": "#/definitions/decimal"},
          "volume": {"$ref": "#/definitions/decimal"},
          "currency": {"type": ["string", "null"]},
          "date": {"$ref": "#/definitions/day"},
          "venue": {"type": ["string", "null"]},
          "row": {"type": ["integer", "null"]}
        },
        "additionalProperties": false
      }
    },
    "aggregate": {
      "type": ["object", "null"],
      "properties": {
        "price": {"$ref": "#/definitions/decimal"},
        "volume": {"$ref": "#/definitions/decimal"},
        "currency": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "venue": {"type": ["string", "null"]},
    "transaction_date": {"$ref": "#/definitions/day"},
    "amendment": {"type": ["boolean", "null"]},
    "holder": {"$ref": "#/definitions/party"},
    "position_pct": {"$ref": "#/definitions/pct"},
    "position_date": {"$ref": "#/definitions/day"},
    "publication_ended": {"type": ["boolean", "null"]},
    "title": {"type": "string"},
    "named_entities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "category": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"]},
    "summary": {"type": ["string", "null"]},
    "bafin_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "name": {"type": "string"},
    "place": {"type": ["string", "null"]},
    "country": {"type": ["string", "null"]},
    "lei": {"type": ["string", "null"]},
    "entity_type": {"type": ["string", "null"]},
    "licences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string"},
          "start": {"$ref": "#/definitions/day"},
          "end": {"$ref": "#/definitions/day"},
          "status": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "not": {"anyOf": [{"required": ["signal"]}, {"required": ["sentiment"]}, {"required": ["recommendation"]}]}
}
