{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/contracts/noesis-workflow-watermark-v1.json",
  "type": "object",
  "required": ["contract", "namespace", "workflow_id", "watermark", "run_id", "state_hash", "coverage", "committed_at_ms"],
  "properties": {
    "contract": {"const": "noesis-workflow-watermark-v1"},
    "namespace": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "watermark": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string"},
    "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coverage": {"type": "object"},
    "committed_at_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
