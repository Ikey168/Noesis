{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-economic-release-snapshot-v1.json",
  "type": "object",
  "required": ["contract", "snapshot_id", "namespace", "owner", "release_id", "release_cutoff_ms", "acquired_cutoff_ms", "domain", "series", "coverage", "limitations", "created_at_ms", "request_hash"],
  "properties": {
    "contract": {"const": "noesis-economic-release-snapshot-v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "release_cutoff_ms": {"type": "integer", "minimum": 0},
    "acquired_cutoff_ms": {"type": "integer", "minimum": 0},
    "domain": {"type": "string", "minLength": 1},
    "series": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/definitions/series"}},
    "coverage": {"enum": ["complete_for_retained_selection", "incomplete"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true,
  "definitions": {
    "observation": {
      "type": "object", "required": ["period", "value", "observation_id"],
      "properties": {"period": {"type": "string", "minLength": 1}, "value": {"type": ["number", "null"]}, "observation_id": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": ["series_id", "indicator_id", "provider", "provider_code", "concept", "unit", "scaling", "geography", "frequency", "price_basis", "seasonal_adjustment", "status", "unavailable_reason", "provider_release_id", "provider_release_id_provenance", "methodology_id", "source_revision_id", "source_document_id", "vintage_id", "provider_vintage_ms", "release_at_ms", "retrieved_at_ms", "observations"],
      "properties": {
        "series_id": {"type": "string", "minLength": 1},
        "indicator_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "provider_code": {"type": "string", "minLength": 1},
        "concept": {"type": "string"},
        "unit": {"type": ["string", "null"]},
        "scaling": {"type": "number"},
        "geography": {"type": ["string", "null"]},
        "frequency": {"type": "string"},
        "price_basis": {"type": "string"},
        "seasonal_adjustment": {"type": "string"},
        "status": {"enum": ["available", "unavailable"]},
        "unavailable_reason": {"type": ["string", "null"]},
        "provider_release_id": {"type": ["string", "null"]},
        "provider_release_id_provenance": {"enum": ["caller_supplied", "unavailable"]},
        "methodology_id": {"type": ["string", "null"]},
        "source_revision_id": {"type": ["string", "null"]},
        "source_document_id": {"type": ["string", "null"]},
        "vintage_id": {"type": ["string", "null"]},
        "provider_vintage_ms": {"type": ["integer", "null"]},
        "release_at_ms": {"type": ["integer", "null"]},
        "retrieved_at_ms": {"type": ["integer", "null"]},
        "release_at_basis": {"enum": ["caller_supplied", "provider_reported", "provider_vintage_fallback", null]},
        "retrieved_at_basis": {"enum": ["caller_supplied", "connector_acquisition", "record_as_of_fallback", null]},
        "vintage_basis": {"type": ["string", "null"]},
        "release_time_status": {"type": ["string", "null"]},
        "observations": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/definitions/observation"}}
      },
      "additionalProperties": true
    }
  }
}
