{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-knowledge-mutation-v1.json",
  "title": "Noesis Knowledge Mutation Envelope v1",
  "type": "object",
  "required": [
    "contract", "batch_id", "namespace", "actor", "reason", "provenance",
    "evidence", "idempotency_key", "partial_batch", "mutations"
  ],
  "properties": {
    "contract": {"const": "noesis-knowledge-mutation-v1"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$"},
    "actor": {
      "type": "object",
      "required": ["principal_id", "kind"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["user", "agent", "service"]}
      },
      "additionalProperties": false
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "provenance": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["source-derived", "user-assertion", "agent-assertion"]},
        "method": {"type": "string", "maxLength": 300},
        "model": {"type": "string", "maxLength": 300}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "claim_id": {"type": "string", "minLength": 1},
          "note": {"type": "string", "maxLength": 1000}
        },
        "anyOf": [
          {"required": ["document_id"]},
          {"required": ["uri"]},
          {"required": ["claim_id"]}
        ],
        "additionalProperties": false
      }
    },
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 200},
    "partial_batch": {"const": "atomic"},
    "mutations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/definitions/mutation"}
    }
  },
  "definitions": {
    "target": {
      "type": "object",
      "required": ["kind", "id", "expected_revision"],
      "properties": {
        "kind": {"enum": ["object", "relation"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 300},
        "expected_revision": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "required": ["mutation_id", "type", "target"],
      "properties": {
        "mutation_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "type": {"enum": ["assert", "correct", "link", "retract", "set_metadata"]},
        "target": {"$ref": "#/definitions/target"},
        "object_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "value": {"type": "object"},
        "metadata": {"type": "object"},
        "relation": {
          "type": "object",
          "required": ["subject_id", "predicate", "object_id"],
          "properties": {
            "subject_id": {"type": "string", "minLength": 1},
            "predicate": {"type": "string", "minLength": 1, "maxLength": 100},
            "object_id": {"type": "string", "minLength": 1},
            "metadata": {"type": "object"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "assert"}}},
          "then": {"required": ["object_type", "value"]}
        },
        {
          "if": {"properties": {"type": {"const": "correct"}}},
          "then": {"required": ["value"]}
        },
        {
          "if": {"properties": {"type": {"const": "link"}}},
          "then": {"required": ["relation"]}
        },
        {
          "if": {"properties": {"type": {"const": "set_metadata"}}},
          "then": {"required": ["metadata"]}
        }
      ]
    }
  },
  "additionalProperties": false
}
