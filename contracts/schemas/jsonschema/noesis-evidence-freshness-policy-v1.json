  "properties": {
    "contract": {"const": "noesis-evidence-freshness-policy-v1"},
    "policy_id": {"type": "string"}, "namespace": {"type": "string"},
    "domain": {"type": "string"}, "source_type": {"type": "string"}, "object_type": {"type": "string"},
    "semantic_version": {"type": "string"}, "rules": {"type": "object"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["active", "superseded"]}, "supersedes_policy_id": {"type": ["string", "null"]},
    "generation": {"type": "integer"}, "valid_from_ms": {"type": ["integer", "null"]}, "valid_to_ms": {"type": ["integer", "null"]},
    "observed_at_ms": {"type": "integer"}, "producer": {"type": "object"}, "policy": {"type": "object"}, "provenance": {"type": "object"},
    "principal_id": {"type": "string"}, "created_at_ms": {"type": "integer"}, "idempotent": {"type": "boolean"}
  },
  "additionalProperties": false
}
