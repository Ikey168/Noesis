{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/schemas/noesis-claim-state-v1.json",
  "title": "Noesis immutable semantic claim state",
  "type": "object",
  "required": ["contract", "state_id", "namespace", "claim_id", "revision", "predecessor_state_id", "wording", "stance", "certainty", "epistemic_status", "attribution", "quantities", "scope", "interpretations", "evidence", "source_id", "source_revision_id", "source_retracted", "evidence_status", "generation", "valid_from_ms", "valid_to_ms", "observed_at_ms", "producer", "policy", "provenance", "principal_id", "input_hash", "created_at_ms"],
  "properties": {
    "contract": {"const": "noesis-claim-state-v1"}, "state_id": {"type": "string", "pattern": "^claim-state:"},
    "namespace": {"type": "string"}, "claim_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1},
    "predecessor_state_id": {"type": ["string", "null"]}, "wording": {"type": "string"},
    "stance": {"enum": ["supports", "opposes", "neutral", "mixed", "unknown"]}, "certainty": {"type": "number", "minimum": 0, "maximum": 1},
    "epistemic_status": {"type": "string"}, "attribution": {"type": "object"}, "quantities": {"type": "array", "items": {"type": "object"}},
    "scope": {"type": "object"}, "interpretations": {"type": "array", "items": {"type": "object"}}, "evidence": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "source_id": {"type": "string"}, "source_revision_id": {"type": "string"}, "source_retracted": {"type": "boolean"}, "evidence_status": {"enum": ["active", "retracted-source"]},
    "generation": {"type": "integer", "minimum": 0}, "valid_from_ms": {"type": ["integer", "null"]}, "valid_to_ms": {"type": ["integer", "null"]}, "observed_at_ms": {"type": "integer"},
    "producer": {"type": "object"}, "policy": {"type": "object"}, "provenance": {"type": "object"}, "principal_id": {"type": "string"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "created_at_ms": {"type": "integer"}, "idempotent": {"type": "boolean"}
  }, "additionalProperties": false
}
