{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/noesis-policy-monitor-v1.json",
  "title": "Noesis policy monitor receipt v1",
  "type": "object",
  "required": [
    "contract",
    "scenario_id",
    "as_of_ms",
    "visibility",
    "statements",
    "metrics",
    "n",
    "method",
    "assumptions"
  ],
  "properties": {
    "contract": {"const": "noesis-policy-monitor-v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "as_of_ms": {"type": "integer", "minimum": 0},
    "visibility": {"enum": ["public", "authorized-private"]},
    "n": {"type": "integer", "minimum": 0},
    "method": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_records_and_predictions_separated": {"const": true},
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "verdict", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "verdict": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/locator"}
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "public_document_count",
        "supporting_publications",
        "probable_reporting_origins",
        "contradictions",
        "votes"
      ],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "private_guidance": {
      "type": "object",
      "required": ["status", "comparison_id", "differences", "evidence"],
      "properties": {
        "status": {"enum": ["current", "stale"]},
        "comparison_id": {"type": "string", "minLength": 1},
        "differences": {"type": "array"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/locator"}
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"visibility": {"const": "authorized-private"}}},
      "then": {"required": ["private_guidance"]},
      "else": {"not": {"required": ["private_guidance"]}}
    }
  ],
  "$defs": {
    "locator": {
      "type": "object",
      "required": ["document_id", "source", "path", "cited", "visibility"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "claim_id": {"type": ["string", "null"]},
        "source": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]},
        "path": {"type": "string", "minLength": 1},
        "cited": {"const": true},
        "visibility": {"enum": ["public", "private"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
