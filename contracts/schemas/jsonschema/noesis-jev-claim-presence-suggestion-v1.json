{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/noesis-jev-claim-presence-suggestion-v1.json",
  "title": "Source-bound Jev factual claim presence suggestion",
  "type": "object",
  "required": ["contract", "status", "accepted", "sentence_index", "text", "span", "context_span", "source_binding", "p_claim", "p_nonclaim", "selected_class_confidence", "suggested_class", "decision_run"],
  "properties": {
    "contract": {"const": "noesis-jev-claim-presence-suggestion-v1"},
    "status": {"enum": ["suggested", "abstained"]},
    "accepted": {"const": false},
    "sentence_index": {"type": "integer", "minimum": 0},
    "text": {"type": "string", "minLength": 1},
    "span": {"$ref": "#/$defs/span"},
    "context_span": {"$ref": "#/$defs/span"},
    "source_binding": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "p_claim": {"$ref": "#/$defs/probabilityOrNull"},
    "p_nonclaim": {"$ref": "#/$defs/probabilityOrNull"},
    "selected_class_confidence": {"$ref": "#/$defs/probabilityOrNull"},
    "suggested_class": {"enum": ["claim", "nonclaim", null]},
    "decision_run": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "suggested"}}, "required": ["status"]}, "then": {"properties": {"p_claim": {"type": "number"}, "p_nonclaim": {"type": "number"}, "suggested_class": {"enum": ["claim", "nonclaim"]}}}},
    {"if": {"properties": {"p_claim": {"type": "number"}}, "required": ["p_claim"]}, "then": {"properties": {"p_nonclaim": {"type": "number"}}}}
  ],
  "$defs": {
    "probabilityOrNull": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "span": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
