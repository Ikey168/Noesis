{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/noesis-jev-rerank-suggestion-v1.json",
  "title": "Source-bound Jev reranking suggestion",
  "type": "object",
  "required": ["contract", "status", "accepted", "candidate_count", "ranking", "decision_run", "selection_policy_applied"],
  "properties": {
    "contract": {"const": "noesis-jev-rerank-suggestion-v1"},
    "status": {"enum": ["suggested", "fallback_original_order"]},
    "accepted": {"const": false},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 20},
    "ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["original_index", "original_score", "source_ref", "source_binding", "locator", "content", "relevance_score", "answer_bearing_score", "suggested_score", "rerank_score", "final_score"],
        "properties": {
          "original_index": {"type": "integer", "minimum": 0},
          "original_score": {"type": "number"},
          "source_ref": {"type": "object"},
          "source_binding": {"type": "object"},
          "locator": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}, "additionalProperties": true},
          "source": {}, "origin": {}, "citation": {},
          "content": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string"},
          "relevance_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "answer_bearing_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "suggested_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "rerank_score": {"type": "number"}, "final_score": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "decision_run": {"type": "object"},
    "selection_policy_applied": {"const": false}
  },
  "additionalProperties": true
}
