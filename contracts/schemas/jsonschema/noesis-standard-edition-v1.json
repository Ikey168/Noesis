{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-standard-edition-v1.json",
  "title": "Noesis standard edition v1",
  "description": "A standard edition with its Technical object ID, supersession/amendment relations and certificates citing it.",
  "type": "object",
  "required": [
    "contract",
    "technical_object_id",
    "reference",
    "status",
    "relations",
    "inbound_relations",
    "certificates",
    "notice"
  ],
  "properties": {
    "contract": {
      "const": "noesis-standard-edition-v1"
    },
    "technical_object_id": {
      "type": "string",
      "pattern": "^standard:iso:"
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "relations": {
      "type": "array"
    },
    "inbound_relations": {
      "type": "array"
    },
    "certificates": {
      "type": "array"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    }
  }
}
