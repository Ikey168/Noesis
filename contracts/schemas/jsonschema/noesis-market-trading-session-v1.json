{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-market-trading-session-v1.json",
  "title": "Noesis market trading session v1",
  "description": "A revisioned exchange calendar session plus explicit observation coverage. A holiday or no-trade day is not a missing OHLCV bar.",
  "type": "object",
  "required": ["contract", "namespace", "owner", "calendar_id", "mic", "venue_timezone", "session_date", "session_status", "data_status", "session_open_ms", "session_close_ms", "public_at_ms", "retrieved_at_ms", "revision_id", "revision", "source_refs", "recorded_at_ms", "record_hash"],
  "properties": {
    "contract": {"const": "noesis-market-trading-session-v1"},
    "namespace": {"type": "string", "minLength": 1},
    "owner": {"type": ["string", "null"]},
    "calendar_id": {"type": "string", "minLength": 1},
    "mic": {"type": "string", "pattern": "^[A-Z0-9]{4}$"},
    "venue_timezone": {"type": "string", "minLength": 1},
    "session_date": {"type": "string", "format": "date"},
    "session_status": {"enum": ["trading", "holiday", "weekend", "special_closed"]},
    "data_status": {"enum": ["not_requested", "present", "no_trade", "missing", "unknown"]},
    "session_open_ms": {"type": ["integer", "null"], "minimum": 0},
    "session_close_ms": {"type": ["integer", "null"], "minimum": 0},
    "public_at_ms": {"type": ["integer", "null"], "minimum": 0},
    "retrieved_at_ms": {"type": "integer", "minimum": 0},
    "revision_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/source_ref"}},
    "recorded_at_ms": {"type": "integer", "minimum": 0},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "definitions": {
    "source_ref": {
      "type": "object",
      "required": ["source_ref_id", "provider", "provider_object_id", "source_revision_id", "public_at_ms", "source_snapshot_id", "source_url", "retrieved_at_ms", "content_hash", "license_id", "entitlement_id"],
      "properties": {
        "source_ref_id": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "provider_object_id": {"type": "string", "minLength": 1},
        "source_revision_id": {"type": ["string", "null"]}, "public_at_ms": {"type": ["integer", "null"], "minimum": 0}, "source_snapshot_id": {"type": ["string", "null"]}, "source_url": {"type": ["string", "null"], "format": "uri"},
        "retrieved_at_ms": {"type": "integer", "minimum": 0}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "license_id": {"type": "string", "minLength": 1}, "entitlement_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
