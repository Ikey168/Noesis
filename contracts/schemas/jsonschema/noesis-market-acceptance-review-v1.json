{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-market-acceptance-review-v1.json",
  "type": "object",
  "required": [
    "contract", "namespace", "journey_id", "journey_version",
    "journey_record_hash", "reviewer_id", "reviewed_at_ms", "decision",
    "criteria", "notes", "live_evidence_refs", "human_attestation",
    "limitations", "artifact_id", "version", "owner", "input_manifest",
    "record_hash"
  ],
  "properties": {
    "contract": {"const": "noesis-market-acceptance-review-v1"},
    "namespace": {"type": "string"},
    "journey_id": {"type": "string"},
    "journey_version": {"type": "integer", "minimum": 1},
    "journey_record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_id": {"type": "string"},
    "reviewed_at_ms": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["accepted", "changes_requested", "rejected"]},
    "criteria": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["criterion_id", "outcome", "notes"],
        "properties": {
          "criterion_id": {"type": "string"},
          "outcome": {"enum": ["passed", "failed"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string"},
    "live_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "human_attestation": {"const": true},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "artifact_id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "owner": {"type": "string"},
    "input_manifest": {"type": "object"},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
