{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-market-brief-delivery-v1.json",
  "type": "object",
  "required": [
    "contract",
    "delivery_key",
    "status",
    "attempts",
    "history",
    "deduplicated"
  ],
  "properties": {
    "contract": {
      "const": "noesis-market-brief-delivery-v1"
    },
    "delivery_key": {
      "type": "string"
    },
    "status": {
      "enum": [
        "delivered",
        "retrying",
        "withheld"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 1
    },
    "history": {
      "type": "array"
    },
    "deduplicated": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
