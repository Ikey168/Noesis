{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noesis-intake-research-bundle-v1",
  "title": "Project-bound Deep Research synthesis",
  "type": "object",
  "required": [
    "contract",
    "bundle_id",
    "namespace",
    "owner",
    "project_id",
    "project_revision",
    "question_revision",
    "revision",
    "document",
    "checks",
    "updated_at_ms"
  ],
  "properties": {
    "contract": {
      "const": "noesis-intake-research-bundle-v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^research-bundle:[0-9a-f]{32}$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1
    },
    "question_revision": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "document": {
      "type": "object",
      "required": [
        "cards",
        "claims",
        "concepts",
        "brief",
        "mental_model",
        "map",
        "known",
        "uncertain",
        "unresolved",
        "definition_of_done"
      ],
      "additionalProperties": false,
      "properties": {
        "cards": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "claims": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "concepts": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/concept"
          }
        },
        "brief": {
          "$ref": "#/$defs/synthesis"
        },
        "mental_model": {
          "$ref": "#/$defs/synthesis"
        },
        "map": {
          "$ref": "#/$defs/synthesis"
        },
        "known": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/knowledgePoint"
          }
        },
        "uncertain": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/knowledgePoint"
          }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/knowledgePoint"
          }
        },
        "definition_of_done": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/review"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "ready",
        "source_status",
        "independent_hosts",
        "reasons",
        "source_independence"
      ],
      "additionalProperties": false,
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "source_status": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "current",
              "superseded"
            ]
          }
        },
        "independent_hosts": {
          "type": "integer",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_independence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "status",
              "group_count",
              "distinct_host_count",
              "verified"
            ],
            "additionalProperties": false,
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "unreviewed",
                  "independent",
                  "dependent",
                  "uncertain"
                ]
              },
              "group_count": {
                "type": "integer",
                "minimum": 0
              },
              "distinct_host_count": {
                "type": "integer",
                "minimum": 0
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "verified": {
                "type": "boolean"
              },
              "review_id": {
                "type": "string",
                "pattern": "^research-independence-review:[0-9a-f]{32}$"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "const": "manual_origin_review"
              },
              "reviewed_at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "provenance": {
                "type": "object",
                "required": [
                  "bundle_revision",
                  "claim_hash",
                  "source_pins"
                ],
                "additionalProperties": false,
                "properties": {
                  "bundle_revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "claim_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "source_pins": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "group_id",
                        "card_id",
                        "namespace",
                        "source_id",
                        "source_version",
                        "quote_hash"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "group_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "card_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "namespace": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_version": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "quote_hash": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "verified": {
                      "const": true
                    }
                  },
                  "required": [
                    "verified"
                  ]
                },
                "then": {
                  "required": [
                    "review_id",
                    "reviewer",
                    "method",
                    "reviewed_at_ms",
                    "provenance"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "updated_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "iteration_history": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "contract", "session_id", "session_revision", "bundle_id",
          "concept_id", "before_revision", "expected", "outcome",
          "before_after_rationale", "proposal_sha256", "proposal_recorded_at_ms"
        ],
        "properties": {
          "contract": {"const": "noesis-intake-iteration-concept-v1"},
          "session_id": {"type": "string", "minLength": 1},
          "session_revision": {"type": "integer", "minimum": 1},
          "bundle_id": {"type": "string", "minLength": 1},
          "concept_id": {"type": "string", "minLength": 1},
          "before_revision": {"type": "integer", "minimum": 1},
          "expected": {"type": "string", "minLength": 1},
          "outcome": {"type": "object"},
          "before_after_rationale": {"type": "string", "minLength": 1},
          "proposal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "proposal_recorded_at_ms": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "idempotent": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "required": [
        "namespace",
        "id",
        "version",
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^(feed|explore):"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "source",
        "quote",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "supports",
        "contradicts",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "$ref": "#/$defs/ids"
        },
        "contradicts": {
          "$ref": "#/$defs/ids"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "independence_review": {
          "type": "object",
          "required": [
            "status",
            "basis",
            "groups"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "independent",
                "dependent",
                "uncertain"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": [
                  "group_id",
                  "card_ids"
                ],
                "additionalProperties": false,
                "properties": {
                  "group_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "card_ids": {
                    "$ref": "#/$defs/ids"
                  }
                }
              }
            }
          }
        }
      }
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "name",
        "explanation",
        "card_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "card_ids": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "synthesis": {
      "type": "object",
      "required": [
        "text",
        "card_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "card_ids": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "knowledgePoint": {
      "type": "object",
      "required": [
        "text",
        "card_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "card_ids": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "criterion",
        "met",
        "rationale",
        "card_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "met": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "card_ids": {
          "$ref": "#/$defs/ids"
        }
      }
    }
  }
}
