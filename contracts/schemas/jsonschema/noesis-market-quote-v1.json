{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-market-quote-v1.json",
  "title": "Noesis market quote v1",
  "description": "A revisioned point-in-time quote for a listing. Bid, ask and last are source values; derived midpoint calculations are represented separately.",
  "type": "object",
  "required": ["contract", "namespace", "owner", "quote_id", "listing_id", "provider", "quote_at_ms", "public_at_ms", "retrieved_at_ms", "revision_id", "revision", "provider_record_id", "provider_revision_id", "venue", "conditions", "bid", "ask", "bid_size", "ask_size", "last", "last_size", "currency", "prior_revision_id", "source_refs", "recorded_at_ms", "record_hash"],
  "properties": {
    "contract": {"const": "noesis-market-quote-v1"},
    "namespace": {"type": "string", "minLength": 1},
    "owner": {"type": ["string", "null"]},
    "quote_id": {"type": "string", "minLength": 1, "description": "Stable logical provider/listing/time/venue/condition observation identity."},
    "listing_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "quote_at_ms": {"type": "integer", "minimum": 0},
    "public_at_ms": {"type": ["integer", "null"], "minimum": 0},
    "retrieved_at_ms": {"type": "integer", "minimum": 0},
    "revision_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "provider_record_id": {"type": ["string", "null"]},
    "provider_revision_id": {"type": ["string", "null"]},
    "venue": {"type": ["string", "null"]},
    "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "bid": {"type": ["number", "null"], "minimum": 0},
    "ask": {"type": ["number", "null"], "minimum": 0},
    "bid_size": {"type": ["number", "null"], "minimum": 0},
    "ask_size": {"type": ["number", "null"], "minimum": 0},
    "last": {"type": ["number", "null"], "minimum": 0},
    "last_size": {"type": ["number", "null"], "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "prior_revision_id": {"type": ["string", "null"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/source_ref"}},
    "recorded_at_ms": {"type": "integer", "minimum": 0},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "anyOf": [
    {"properties": {"bid": {"type": "number"}}},
    {"properties": {"ask": {"type": "number"}}},
    {"properties": {"last": {"type": "number"}}}
  ],
  "additionalProperties": false,
  "definitions": {
    "source_ref": {
      "type": "object",
      "required": ["source_ref_id", "provider", "provider_object_id", "source_revision_id", "public_at_ms", "source_snapshot_id", "source_url", "retrieved_at_ms", "content_hash", "license_id", "entitlement_id"],
      "properties": {
        "source_ref_id": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "provider_object_id": {"type": "string", "minLength": 1},
        "source_revision_id": {"type": ["string", "null"]}, "public_at_ms": {"type": ["integer", "null"], "minimum": 0}, "source_snapshot_id": {"type": ["string", "null"]}, "source_url": {"type": ["string", "null"], "format": "uri"},
        "retrieved_at_ms": {"type": "integer", "minimum": 0}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "license_id": {"type": "string", "minLength": 1}, "entitlement_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
