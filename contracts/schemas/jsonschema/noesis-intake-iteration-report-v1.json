{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/noesis-intake-iteration-report-v1.json",
  "title": "Authored Report Iteration receipt",
  "type": "object",
  "required": [
    "contract", "session_id", "session_revision", "report_id",
    "before_revision", "expected", "outcome", "before_after_rationale",
    "proposal_sha256", "proposal_recorded_at_ms"
  ],
  "properties": {
    "contract": {"const": "noesis-intake-iteration-report-v1"},
    "session_id": {"type": "string", "minLength": 1},
    "session_revision": {"type": "integer", "minimum": 1},
    "report_id": {"type": "string", "minLength": 1},
    "before_revision": {"type": "integer", "minimum": 1},
    "expected": {"type": "string", "minLength": 1},
    "outcome": {
      "type": "object",
      "required": [
        "observed", "learning", "measurements", "uncertainty",
        "external_causes", "evidence", "basis", "at_ms"
      ],
      "properties": {
        "observed": {"type": "string", "minLength": 1},
        "learning": {"type": "string", "minLength": 1},
        "measurements": {"type": "array", "minItems": 1, "maxItems": 20},
        "uncertainty": {"type": "string", "minLength": 1},
        "external_causes": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "maxItems": 20},
        "basis": {"const": "caller_reported"},
        "at_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "before_after_rationale": {"type": "string", "minLength": 1},
    "proposal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposal_recorded_at_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
