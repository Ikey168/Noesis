{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noesis-intake-research-assessment-v1",
  "title": "Durable paired Deep Research workflow assessment",
  "type": "object",
  "required": [
    "contract", "assessment_id", "namespace", "owner", "session_id",
    "command_key", "assessed_at_ms", "input_hash", "snapshot",
    "assessment", "idempotent"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "noesis-intake-research-assessment-v1"},
    "assessment_id": {"type": "string", "pattern": "^research-progress-assessment:[0-9a-f]{32}$"},
    "namespace": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "command_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "assessed_at_ms": {"type": "integer", "minimum": 0},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot": {"$ref": "#/$defs/progress"},
    "idempotent": {"type": "boolean"},
    "assessment": {
      "type": "object",
      "required": [
        "ready", "bundle_ready", "required_stage_ids", "stage_receipt_count",
        "completed_stage_receipt_count", "definition_of_done", "blockers",
        "limitations", "substantive_support_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "ready": {"type": "boolean"},
        "bundle_ready": {"type": "boolean"},
        "required_stage_ids": {"type": "array", "items": {"type": "string"}},
        "stage_receipt_count": {"type": "integer", "minimum": 0},
        "completed_stage_receipt_count": {"type": "integer", "minimum": 0},
        "definition_of_done": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["criterion", "status", "reviewed", "recorded_met", "cited_card_count"],
            "additionalProperties": false,
            "properties": {
              "criterion": {"type": "string"},
              "status": {"enum": ["met", "not_met", "unreviewed", "needs_review"]},
              "reviewed": {"type": "boolean"},
              "recorded_met": {"type": "boolean"},
              "cited_card_count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "target", "next_action"],
            "additionalProperties": false,
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "target": {"type": "object", "minProperties": 1},
              "next_action": {"type": "string", "minLength": 1}
            }
          }
        },
        "limitations": {"type": "array", "items": {"type": "string"}},
        "substantive_support_verified": {"const": false}
      }
    }
  },
  "$defs": {
    "progress": {
      "type": "object",
      "required": ["contract", "session", "project", "bundle", "loops", "blockers", "limitations", "assessment"],
      "additionalProperties": false,
      "properties": {
        "contract": {"const": "noesis-intake-research-progress-v1"},
        "session": {"type": "object", "required": ["id", "revision", "status", "unmet_completion_checks"], "properties": {
          "id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1},
          "status": {"type": "string"}, "unmet_completion_checks": {"type": "array", "items": {"type": "string"}}
        }},
        "project": {"type": "object", "required": ["id", "revision", "question_revision", "status", "questions", "success_criteria", "budget", "spent", "source_status"], "properties": {
          "id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1},
          "question_revision": {"type": "integer", "minimum": 1}, "status": {"type": "string"},
          "questions": {"type": "array", "items": {"type": "string"}},
          "success_criteria": {"type": "array", "items": {"type": "string"}},
          "budget": {"type": "object"}, "spent": {"type": "object"},
          "source_status": {"type": "array", "items": {"type": "object"}}
        }},
        "bundle": {"type": ["object", "null"], "required": ["id", "revision", "checks"], "properties": {
          "id": {"type": "string"}, "revision": {"type": ["integer", "null"]},
          "checks": {"type": "object", "required": ["ready", "source_status", "independent_hosts", "reasons"]},
          "definition_of_done": {"type": "array", "items": {"type": "object", "required": ["criterion", "met", "cited_card_count"], "properties": {
            "criterion": {"type": "string"}, "met": {"type": "boolean"}, "cited_card_count": {"type": "integer", "minimum": 0}
          }}}
        }},
        "loops": {"type": "array", "maxItems": 20, "items": {"type": "object", "required": ["loop_id", "status", "stop_reason", "coverage", "required_independent_sources_per_domain", "completed_iterations", "result_count", "actions"], "properties": {
          "loop_id": {"type": "string"}, "status": {"type": "string"}, "stop_reason": {"type": ["string", "null"]},
          "coverage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "required_independent_sources_per_domain": {"type": "integer", "minimum": 1},
          "completed_iterations": {"type": "integer", "minimum": 0}, "result_count": {"type": "integer", "minimum": 0},
          "actions": {"type": "array", "maxItems": 100, "items": {"type": "object"}}
        }}},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "assessment": {"type": "object", "required": ["ready", "bundle_ready", "required_stage_ids", "stage_receipt_count", "completed_stage_receipt_count", "definition_of_done", "blockers", "limitations", "substantive_support_verified"]}
      }
    }
  }
}
