{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/schemas/noesis-epistemic-assessment-v1.json",
  "title": "Noesis versioned epistemic assessment",
  "type": "object",
  "required": ["contract", "assessment_id", "namespace", "statement_id", "revision", "predecessor_assessment_id", "statement_text", "taxonomy_id", "machine_status", "effective_status", "assessment_state", "confidence", "uncertainty", "evidence", "factors", "classifier", "override", "transitions", "source_revision_id", "created_at_ms", "generation", "valid_from_ms", "valid_to_ms", "observed_at_ms", "producer", "policy", "principal_id", "input_hash"],
  "properties": {
    "contract": {"const": "noesis-epistemic-assessment-v1"},
    "assessment_id": {"type": "string", "pattern": "^epistemic-assessment:"},
    "namespace": {"type": "string", "minLength": 1},
    "statement_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "predecessor_assessment_id": {"type": ["string", "null"]},
    "statement_text": {"type": "string", "minLength": 1},
    "taxonomy_id": {"type": "string", "pattern": "^epistemic-taxonomy:"},
    "machine_status": {"type": "string", "minLength": 1},
    "effective_status": {"type": "string", "minLength": 1},
    "assessment_state": {"enum": ["supported", "contested", "insufficient"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "factors": {"type": "object"},
    "classifier": {"type": "object"},
    "override": {"type": ["object", "null"]},
    "transitions": {"type": "array", "items": {"type": "object"}},
    "source_revision_id": {"type": ["string", "null"]},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "generation": {"type": "integer", "minimum": 0},
    "valid_from_ms": {"type": ["integer", "null"]},
    "valid_to_ms": {"type": ["integer", "null"]},
    "observed_at_ms": {"type": "integer", "minimum": 0},
    "producer": {"type": "object", "required": ["name", "version"]},
    "policy": {"type": "object"},
    "principal_id": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotent": {"type": "boolean"}
  },
  "additionalProperties": false
}
