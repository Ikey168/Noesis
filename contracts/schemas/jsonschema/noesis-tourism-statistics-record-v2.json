{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noesis-tourism-statistics-record-v2",
  "title": "Tourism statistics series item: one series of one release (economics.tourism)",
  "description": "One published series as Eurostat released it (tourism occupancy: nights spent and arrivals; tourism capacity: establishments, bedrooms and bed places): dataset, indicator, residence of guest (c_resid), accommodation type (nace_r2), unit, frequency, geography with its NUTS version, the definition the source states (including each country's establishment-size threshold and the capacity reference date) and the observations (value text as published, status, OBS_FLAG letters verbatim). Each release is appended as a vintage by src/kb/tourism_store.py, never overwritten; revised provisional months and removals are vintages. No record carries person-, guest- or establishment-level data; a confidential cell (c) is a status and carries no value; monthly and annual series are never converted into each other; nothing is nowcast, filled, adjusted, blended or derived.",
  "type": "object",
  "required": ["provider", "dataset", "native_key", "indicator", "residence", "accommodation", "area", "unit", "frequency", "definition", "observations"],
  "definitions": {
    "observation": {
      "type": "object",
      "required": ["period", "status", "flags"],
      "properties": {
        "period": {"type": "string", "pattern": "^\\d{4}(-\\d{2})?$"},
        "value_text": {"type": ["string", "null"]},
        "value": {"type": ["string", "null"]},
        "status": {"enum": ["reported", "confidential", "not_published"]},
        "flags": {"type": "object", "additionalProperties": {"type": "string"}},
        "flag_meanings": {"type": "array", "items": {"type": "string"}},
        "attributes": {"type": "object"}
      },
      "if": {"properties": {"status": {"not": {"const": "reported"}}}},
      "then": {"properties": {"value": {"type": "null"}}}
    }
  },
  "properties": {
    "provider": {"enum": ["eurostat-tourism-occupancy", "eurostat-tourism-capacity"]},
    "dataset": {"enum": ["tour_occ_nim", "tour_occ_arm", "tour_occ_nin2", "tour_cap_nuts2"]},
    "native_key": {"type": "string", "minLength": 1},
    "dataflow": {"type": "object"},
    "indicator": {
      "type": "object",
      "required": ["code", "concept"],
      "properties": {
        "code": {"type": "string"},
        "concept": {"enum": ["nights_spent", "arrivals", "establishments", "bedrooms", "bed_places"]},
        "label": {"type": "string"}
      }
    },
    "residence": {
      "type": "object",
      "required": ["code"],
      "properties": {"code": {"enum": ["TOTAL", "DOM", "FOR", "not_applicable"]}, "label": {"type": "string"}}
    },
    "accommodation": {
      "type": "object",
      "required": ["scheme", "version", "code"],
      "properties": {
        "scheme": {"const": "NACE"},
        "version": {"const": "Rev.2"},
        "code": {"enum": ["I551-I553", "I551", "I552", "I553"]},
        "label": {"type": ["string", "null"]}
      }
    },
    "area": {
      "type": "object",
      "required": ["scheme", "code", "nuts_version"],
      "properties": {
        "scheme": {"const": "eurostat-geo"},
        "code": {"type": "string"},
        "nuts_version": {"enum": ["2016", "2021", "2024"]},
        "level": {"type": "integer"},
        "label": {"type": ["string", "null"]}
      }
    },
    "unit": {
      "type": "object",
      "required": ["code"],
      "properties": {"code": {"type": "string"}, "label": {"type": ["string", "null"]}}
    },
    "frequency": {"enum": ["monthly", "annual"]},
    "dimensions": {"type": "object"},
    "definition": {"type": "object", "required": ["provider", "coverage_thresholds"]},
    "references": {"type": "array"},
    "source_notes": {"type": "array"},
    "observations": {"type": "array", "items": {"$ref": "#/definitions/observation"}}
  }
}
