{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-schema-module-v1.json",
  "title": "Noesis Schema Registry Module v1",
  "type": "object",
  "required": ["contract", "name", "kind", "semantic_version", "content", "owner", "dependencies", "compatibility_policy", "provenance", "actor"],
  "properties": {
    "contract": {"const": "noesis-schema-module-v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$"},
    "kind": {"enum": ["schema", "ontology", "constraint", "vocabulary", "crosswalk"]},
    "semantic_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "content": {"type": "object"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"enum": ["active"]},
    "dependencies": {
      "type": "array",
      "items": {"$ref": "#/definitions/reference"}
    },
    "compatibility_policy": {"enum": ["none", "backward", "full"]},
    "provenance": {"$ref": "#/definitions/provenance"},
    "actor": {"$ref": "#/definitions/actor"}
  },
  "definitions": {
    "reference": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {"enum": ["schema", "ontology", "constraint", "vocabulary", "crosswalk"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "source"],
      "properties": {
        "kind": {"enum": ["builtin", "user", "agent", "imported"]},
        "source": {"type": "string", "minLength": 1},
        "uri": {"type": "string"},
        "commit": {"type": "string"}
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["principal_id", "kind"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["user", "agent", "service"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
