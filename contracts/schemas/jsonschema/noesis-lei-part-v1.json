{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-lei-part-v1.json",
  "title": "Noesis LEI part v1",
  "description": "One GLEIF API part (record, parent relationship, reporting exception) of one LEI.",
  "type": "object",
  "required": [
    "contract",
    "provider",
    "lei",
    "part",
    "attributes",
    "raw_sha256"
  ],
  "properties": {
    "contract": {
      "const": "noesis-lei-part-v1"
    },
    "provider": {
      "const": "gleif"
    },
    "lei": {
      "type": "string",
      "pattern": "^[0-9A-Z]{18}[0-9]{2}$"
    },
    "part": {
      "enum": [
        "record",
        "direct-parent-relationship",
        "ultimate-parent-relationship",
        "direct-parent-reporting-exception",
        "ultimate-parent-reporting-exception"
      ]
    },
    "attributes": {
      "type": "object"
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
