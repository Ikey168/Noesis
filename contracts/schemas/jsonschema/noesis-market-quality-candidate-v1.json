{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-market-quality-candidate-v1.json",
  "title": "Noesis rejected market ingest candidate v1",
  "type": "object",
  "required": ["contract", "candidate_id", "namespace", "request_key", "provider", "listing_id", "interval", "record_hash", "error_code", "status", "created_at_ms"],
  "properties": {
    "contract": {"const": "noesis-market-quality-candidate-v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "request_key": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "listing_id": {"type": "string", "minLength": 1},
    "interval": {"type": "string", "minLength": 1},
    "provider_record_id": {"type": ["string", "null"]},
    "record_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "error_code": {"type": "string", "minLength": 1},
    "status": {"const": "quarantined"},
    "created_at_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
