{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/contracts/noesis-memory-object-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "memory_id", "scope", "kind", "subject", "content", "content_type", "epistemic_status", "author", "evidence", "confidence", "sensitivity", "lifecycle", "state", "revision", "created_at_ms", "updated_at_ms"],
  "properties": {
    "contract": {"const": "noesis-memory-object-v1"},
    "memory_id": {"type": "string", "pattern": "^memory:[a-f0-9]{24}$"},
    "scope": {"type": "object", "required": ["namespace", "tenant_id", "task_id"], "properties": {"namespace": {"type": "string"}, "tenant_id": {"type": "string"}, "task_id": {"type": ["string", "null"]}}, "additionalProperties": false},
    "kind": {"enum": ["episodic", "semantic", "preference", "task-state"]},
    "subject": {},
    "content": {},
    "content_type": {"enum": ["value", "reference"]},
    "epistemic_status": {"enum": ["observation", "inferred-summary", "user-confirmed"]},
    "author": {"type": "string"},
    "evidence": {"type": "array"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "valid_from_ms": {"type": ["integer", "null"]},
    "valid_to_ms": {"type": ["integer", "null"]},
    "sensitivity": {"type": "string"},
    "lifecycle": {"type": "object"},
    "state": {"enum": ["active", "archived", "expired", "superseded", "forgotten"]},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes_id": {"type": ["string", "null"]},
    "created_at_ms": {"type": "integer"},
    "updated_at_ms": {"type": "integer"}
  }
}
