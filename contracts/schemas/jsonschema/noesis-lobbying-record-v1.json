{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noesis-lobbying-record-v1",
  "title": "Political lobbying record: export, registrant or meeting entry, register revision, client, declared interest, spend declaration, declared grant or document",
  "description": "Every record carries its register, native register identifier, register revision, source and namespace, with acquisition time kept apart from the dates the register states. Registers are never merged: identity is per register and a cross-register or entity match is a reviewable identity decision, not a record. Spend is the declared range (lower/upper bound, either open) with currency and period; no record carries a midpoint, total, estimate or influence claim.",
  "type": "object",
  "required": ["contract", "record_type"],
  "definitions": {
    "day": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "register": {"enum": ["eu-tr", "de-lobbyregister", "uk-orcl", "ep-meetings", "ec-meetings", "us-lda"]},
    "amount": {"type": ["string", "null"], "pattern": "^\\d+(\\.\\d+)?$"},
    "source_revision": {"type": "object", "required": ["export_id", "file_sha256", "publication_date"], "properties": {
      "export_id": {"type": "string"}, "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "publication_date": {"$ref": "#/definitions/day"}, "url": {"type": ["string", "null"]},
      "evidence_origin": {"enum": ["fixture", "live"]}}},
    "citation": {"type": "object", "required": ["register", "native_id", "revision_id", "source_revision"],
      "properties": {"register": {"$ref": "#/definitions/register"}, "native_id": {"type": "string"},
                     "revision_id": {"type": "string"}, "source_revision": {"$ref": "#/definitions/source_revision"}}}
  },
  "properties": {
    "contract": {"const": "noesis-lobbying-record-v1"},
    "record_type": {"enum": ["export", "registrant", "meeting", "register_revision", "client", "declared_interest",
                             "spend_declaration", "declared_grant", "document"]},
    "namespace": {"type": "string"},
    "register": {"$ref": "#/definitions/register"},
    "native_id": {"type": "string", "minLength": 1},
    "record_key": {"type": "string", "pattern": "^lobbying:(eu-tr|de-lobbyregister|uk-orcl|ep-meetings|ec-meetings|us-lda):"},
    "revision_id": {"type": "string"},
    "revision_no": {"type": "integer", "minimum": 1},
    "previous_revision_id": {"type": ["string", "null"]},
    "change": {"enum": ["registered", "amended", "reregistered", "deregistered"]},
    "lifecycle": {"enum": ["active", "deregistered"]},
    "effective_on": {"$ref": "#/definitions/day"},
    "declared_on": {"$ref": "#/definitions/day"},
    "native_version": {"type": ["string", "null"]},
    "statement": {"type": ["object", "null"]},
    "source_revision": {"$ref": "#/definitions/source_revision"},
    "evidence_origin": {"enum": ["fixture", "live"]},
    "observed_at_ms": {"type": "integer"},
    "kind": {"type": ["string", "null"]},
    "lower": {"$ref": "#/definitions/amount"},
    "upper": {"$ref": "#/definitions/amount"},
    "lower_open": {"type": "boolean"},
    "upper_open": {"type": "boolean"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "period": {"type": ["object", "null"]},
    "as_filed": {"type": ["string", "null"]},
    "references": {"type": "array", "items": {"type": "object", "required": ["scheme", "value", "key", "jurisdiction"]}},
    "citation": {"$ref": "#/definitions/citation"}
  },
  "allOf": [
    {"if": {"properties": {"record_type": {"const": "register_revision"}}},
     "then": {"required": ["register", "native_id", "revision_id", "revision_no", "change", "lifecycle", "effective_on",
                           "source_revision", "evidence_origin", "observed_at_ms"]}},
    {"if": {"properties": {"record_type": {"enum": ["registrant", "meeting"]}}},
     "then": {"required": ["register", "native_id", "record_key"]}},
    {"if": {"properties": {"record_type": {"const": "spend_declaration"}}},
     "then": {"required": ["kind", "lower", "upper", "lower_open", "upper_open", "currency", "period", "citation"]}},
    {"if": {"properties": {"record_type": {"enum": ["client", "declared_interest", "declared_grant", "document"]}}},
     "then": {"required": ["citation"]}}
  ],
  "not": {"anyOf": [{"required": ["midpoint"]}, {"required": ["total"]}, {"required": ["estimate"]},
                    {"required": ["influence"]}, {"required": ["point_estimate"]}]}
}
