{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/schemas/noesis-ontology-v1.json",
  "title": "Noesis versioned ontology content",
  "type": "object",
  "required": ["contract", "namespace_uri", "concepts", "object_types", "relation_types", "generation", "valid_from_ms", "valid_to_ms", "observed_at_ms", "producer", "policy"],
  "properties": {
    "contract": {"const": "noesis-ontology-v1"},
    "namespace_uri": {"type": ["string", "null"]},
    "concepts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["concept_id", "labels", "definition", "broader", "constraints", "lifecycle"]}},
    "object_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relation_types": {"type": "array", "items": {"type": "string"}},
    "generation": {"type": "integer", "minimum": 0},
    "valid_from_ms": {"type": ["integer", "null"]},
    "valid_to_ms": {"type": ["integer", "null"]},
    "observed_at_ms": {"type": "integer", "minimum": 0},
    "producer": {"type": "object", "required": ["name", "version"]},
    "policy": {"type": "object"}
  },
  "additionalProperties": false
}
