{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-typed-decision-v1.json",
  "title": "Noesis Typed Decision Receipt v1",
  "type": "object",
  "required": ["contract", "status", "task_id", "rubric_id", "source_binding", "model_requested", "model_returned", "answers", "usage", "attempts", "execution", "policy_id", "calibration_id"],
  "properties": {
    "contract": {"const": "noesis-typed-decision-v1"},
    "status": {"enum": ["answered", "abstained", "unavailable"]},
    "task_id": {"type": "string", "minLength": 1},
    "rubric_id": {"type": "string", "minLength": 1},
    "source_binding": {"oneOf": [{"$ref": "#/definitions/binding"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/binding"}}]},
    "model_requested": {"type": "string", "minLength": 1},
    "model_returned": {"type": ["string", "null"]},
    "answers": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/answer"}},
    "usage": {
      "type": "object", "required": ["input_tokens", "output_tokens"], "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "attempts": {"type": "integer", "minimum": 0},
    "execution": {
      "type": "object", "required": ["provider", "endpoint"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "request_id": {"type": ["string", "null"]},
        "provider_request_id": {"type": ["string", "null"]},
        "http_status": {"type": ["integer", "null"]},
        "error_code": {"type": "string"},
        "reserved_cost_micros": {"type": "integer", "minimum": 0}
      }, "additionalProperties": true
    },
    "policy_id": {"type": ["string", "null"]},
    "calibration_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "answered"}}}, "then": {"properties": {"model_returned": {"type": "string", "minLength": 1}}}}
  ],
  "additionalProperties": false,
  "definitions": {
    "binding": {
      "type": "object", "required": ["kind"],
      "properties": {
        "kind": {"enum": ["document_revision", "inbox_item_version", "user_input_version"]},
        "document_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": ["string", "integer"]},
        "item_id": {"type": "string", "minLength": 1},
        "source_version": {"type": ["string", "integer"]},
        "input_id": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "integer"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "document_revision"}}}, "then": {"required": ["document_id", "revision_id"]}},
        {"if": {"properties": {"kind": {"const": "inbox_item_version"}}}, "then": {"required": ["item_id", "source_version"]}},
        {"if": {"properties": {"kind": {"const": "user_input_version"}}}, "then": {"required": ["input_id", "version"]}}
      ], "additionalProperties": true
    },
    "answer": {
      "type": "object",
      "required": ["kind", "status", "value", "probabilities", "selected_probability", "vendor_confidence", "legend"],
      "properties": {
        "kind": {"enum": ["choice", "score", "noul"]},
        "status": {"enum": ["answered", "abstained", "unavailable"]},
        "value": {"type": ["string", "number", "null"]},
        "probabilities": {"type": ["object", "null"], "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "selected_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "vendor_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "legend": {"type": ["object", "null"]}
      }, "additionalProperties": false
    }
  }
}
