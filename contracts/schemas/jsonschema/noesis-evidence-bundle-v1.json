{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/contracts/noesis-evidence-bundle-v1.json",
  "title": "Noesis Evidence Bundle v1",
  "description": "Portable content-addressed evidence and verification metadata. Integrity proves bundle consistency, not factual truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "bundle_id",
    "created_at_ms",
    "operation",
    "roots",
    "objects",
    "external_references",
    "completeness",
    "manifest"
  ],
  "properties": {
    "contract": {"const": "noesis-evidence-bundle-v1"},
    "bundle_id": {"$ref": "#/definitions/digest"},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "inputs"],
      "properties": {
        "type": {"enum": ["answer", "claim", "integrity", "receipt"]},
        "inputs": {"type": "object"},
        "as_of_ms": {"type": "integer", "minimum": 0}
      }
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/objectId"}
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/bundleObject"}
    },
    "external_references": {
      "type": "array",
      "items": {"$ref": "#/definitions/externalReference"}
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "omissions"],
      "properties": {
        "status": {"enum": ["complete", "partial"]},
        "omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason"],
            "properties": {
              "reason": {"type": "string", "minLength": 1},
              "object_id": {"$ref": "#/definitions/objectId"}
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "canonicalization", "entry_count", "entries"],
      "properties": {
        "hash_algorithm": {"const": "sha256"},
        "canonicalization": {"const": "noesis-json-c14n-v1"},
        "entry_count": {"type": "integer", "minimum": 1},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/manifestEntry"}
        }
      }
    }
  },
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "bundleObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "payload", "references", "sha256"],
      "properties": {
        "id": {"$ref": "#/definitions/objectId"},
        "type": {"enum": ["answer", "claim", "integrity", "receipt", "evidence", "model_pin"]},
        "payload": {},
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/objectId"}
        },
        "sha256": {"$ref": "#/definitions/digest"}
      }
    },
    "manifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sha256"],
      "properties": {
        "id": {"$ref": "#/definitions/objectId"},
        "type": {"enum": ["answer", "claim", "integrity", "receipt", "evidence", "model_pin"]},
        "sha256": {"$ref": "#/definitions/digest"}
      }
    },
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "locator", "required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["external", "adjacent"]},
        "locator": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "sha256": {"$ref": "#/definitions/digest"},
        "media_type": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "adjacent"}}},
          "then": {"required": ["sha256"]}
        }
      ]
    }
  }
}
