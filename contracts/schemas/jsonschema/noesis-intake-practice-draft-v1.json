{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/contracts/noesis-intake-practice-draft-v1.json",
  "title": "Noesis reviewable intake practice draft",
  "type": "object",
  "required": ["contract", "namespace", "owner", "cards", "limitations", "sha256"],
  "properties": {
    "contract": {"const": "noesis-intake-practice-draft-v1"},
    "namespace": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "cards": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["kind", "proposed_prompt", "answer_reference", "mastery_criterion", "answer_status", "requires_author_answer"],
        "properties": {
          "kind": {"enum": ["recall", "procedure", "explanation"]},
          "proposed_prompt": {"type": "string", "minLength": 1},
          "answer_reference": {"type": "object"},
          "mastery_criterion": {"type": "string", "minLength": 1},
          "answer_status": {"const": "pending_author_review"},
          "requires_author_answer": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
