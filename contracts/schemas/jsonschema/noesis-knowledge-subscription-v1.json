{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/contracts/noesis-knowledge-subscription-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "subscription_id", "version", "owner_principal", "namespace", "domain", "query", "filters", "cadence", "delivery", "status", "created_at_ms", "updated_at_ms"],
  "properties": {
    "contract": {"const": "noesis-knowledge-subscription-v1"},
    "subscription_id": {"type": "string", "pattern": "^subscription:[a-f0-9]{24}$"},
    "version": {"type": "integer", "minimum": 1},
    "owner_principal": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "query": {"type": "object", "required": ["operation"]},
    "filters": {"type": "object"},
    "cadence": {"type": "object", "required": ["trigger"]},
    "delivery": {"type": "object", "required": ["kind"]},
    "status": {"enum": ["active", "paused", "expired", "deleted"]},
    "expires_at_ms": {"type": ["integer", "null"]},
    "created_at_ms": {"type": "integer"},
    "updated_at_ms": {"type": "integer"},
    "last_watermark": {"type": ["integer", "null"]}
  }
}
