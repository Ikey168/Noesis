{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-schema-migration-v1.json",
  "title": "Noesis Reversible Schema Migration v1",
  "type": "object",
  "required": ["contract", "migration_id", "from", "to", "affected_types", "preconditions", "transforms", "postconditions", "reverse_transforms", "owner", "provenance", "actor"],
  "properties": {
    "contract": {"const": "noesis-schema-migration-v1"},
    "migration_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,199}$"},
    "from": {"$ref": "#/definitions/reference"},
    "to": {"$ref": "#/definitions/reference"},
    "affected_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "preconditions": {
      "type": "object",
      "properties": {
        "required_fields": {"type": "array", "items": {"type": "string"}},
        "field_equals": {"type": "object"},
        "minimum_revision": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "transforms": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/transform"}},
    "postconditions": {
      "type": "object",
      "required": ["validate_target"],
      "properties": {"validate_target": {"type": "boolean"}},
      "additionalProperties": false
    },
    "reverse_transforms": {"type": "array", "items": {"$ref": "#/definitions/transform"}},
    "owner": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "#/definitions/provenance"},
    "actor": {"$ref": "#/definitions/actor"},
    "fixture_namespace": {"type": "string"}
  },
  "definitions": {
    "reference": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {"enum": ["schema", "ontology", "constraint", "vocabulary", "crosswalk"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "source"],
      "properties": {
        "kind": {"enum": ["builtin", "user", "agent", "imported"]},
        "source": {"type": "string", "minLength": 1},
        "uri": {"type": "string"},
        "commit": {"type": "string"}
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["principal_id", "kind"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["user", "agent", "service"]}
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"enum": ["rename_field", "set_default", "remove_field", "map_value", "set", "rename_type"]},
        "field": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "value": {},
        "mapping": {"type": "object"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"op": {"enum": ["rename_field", "rename_type"]}}},
          "then": {"required": ["from", "to"]}
        },
        {
          "if": {"properties": {"op": {"enum": ["set_default", "remove_field", "set"]}}},
          "then": {"required": ["field"]}
        },
        {
          "if": {"properties": {"op": {"const": "map_value"}}},
          "then": {"required": ["field", "mapping"]}
        }
      ]
    }
  },
  "additionalProperties": false
}
