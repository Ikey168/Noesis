{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-lei-entity-v1.json",
  "title": "Noesis LEI entity v1",
  "description": "An LEI entity with legal and headquarters addresses kept apart, the registration-authority pointer, registration staleness, parent assertion history and reporting exceptions.",
  "type": "object",
  "required": [
    "contract",
    "lei",
    "legal_name",
    "places",
    "official_register",
    "registration",
    "parents",
    "reporting",
    "identity_links",
    "notice"
  ],
  "properties": {
    "contract": {
      "const": "noesis-lei-entity-v1"
    },
    "lei": {
      "type": "string",
      "pattern": "^[0-9A-Z]{18}[0-9]{2}$"
    },
    "places": {
      "type": "object",
      "required": [
        "legal_address",
        "headquarters",
        "registration_jurisdiction"
      ]
    },
    "official_register": {
      "type": "object",
      "required": [
        "authority_id",
        "registered_as"
      ]
    },
    "registration": {
      "type": "object",
      "required": [
        "status",
        "stale"
      ]
    },
    "parents": {
      "type": "object",
      "required": [
        "direct",
        "ultimate"
      ]
    },
    "reporting": {
      "type": "array"
    },
    "identity_links": {
      "type": "array"
    },
    "notice": {
      "type": "string"
    }
  }
}
