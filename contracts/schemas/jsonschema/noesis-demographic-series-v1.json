{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noesis-demographic-series-v1",
  "title": "Demographic record: release, definition revision, geography level, series, vintage, observation or series break",
  "description": "Every record carries its namespace and cites the source revision it came from (an acquired statistical publication or an operator's figure sheet for a PDF-only publication). Release and retrieval clocks are kept apart, each with its basis label. A series cannot exist without a definition revision; a changed definition is a new revision plus a marked break, and a value stays with the definition revision it was published under. Series from different publishers, definitions or geography levels are separate records. No record carries a population projection, a causal claim or a merged, averaged, netted, chained or apportioned value.",
  "type": "object",
  "required": ["contract", "record_type"],
  "definitions": {
    "day": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {
      "type": "object",
      "required": ["release_id", "provider", "file_sha256", "published_on", "release_basis", "evidence_origin"],
      "properties": {
        "release_id": {"type": "string"},
        "provider": {"type": "string"},
        "source_id": {"type": ["string", "null"]},
        "file_sha256": {"$ref": "#/definitions/sha256"},
        "published_on": {"$ref": "#/definitions/day"},
        "release_basis": {"type": "string"},
        "url": {"type": ["string", "null"]},
        "evidence_origin": {"enum": ["fixture", "live", "operator"]},
        "retrieved_at_ms": {"type": "integer"}
      }
    },
    "definition_content": {
      "type": "object",
      "required": ["concept", "measure", "breakdown", "procedure", "reference", "population_base"],
      "properties": {
        "concept": {"enum": ["population_stock", "immigration_flow", "emigration_flow", "asylum_applications", "asylum_decisions", "refugee_stock", "asylum_seeker_stock", "idp_stock", "stateless_stock", "others_of_concern_stock", "displacement_stock"]},
        "measure": {"enum": ["stock", "flow"]},
        "breakdown": {"enum": ["citizenship", "country_of_birth", "country_of_origin", "none"]},
        "procedure": {"enum": ["application", "decision", "none"]},
        "reference": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["date", "period"]}, "label": {"type": ["string", "null"]}}},
        "population_base": {"enum": ["register", "census-2011", "census-2022", "estimate", "government-estimate", "unhcr-estimate", "not-stated"]},
        "source_text": {"type": ["string", "null"]},
        "metadata_url": {"type": ["string", "null"]},
        "code_labels": {"type": "object"}
      }
    }
  },
  "properties": {
    "contract": {"const": "noesis-demographic-series-v1"},
    "record_type": {"enum": ["release", "definition_revision", "geography_level", "series", "vintage", "observation", "series_break"]},
    "namespace": {"type": "string"},
    "release_id": {"type": "string"},
    "provider": {"type": "string"},
    "published_on": {"$ref": "#/definitions/day"},
    "release_basis": {"type": "string"},
    "file_sha256": {"$ref": "#/definitions/sha256"},
    "evidence_origin": {"enum": ["fixture", "live", "operator"]},
    "definition_id": {"type": "string"},
    "definition_key": {"type": "string"},
    "revision_no": {"type": "integer", "minimum": 1},
    "valid_from": {"$ref": "#/definitions/day"},
    "content": {"$ref": "#/definitions/definition_content"},
    "level_id": {"type": "string"},
    "scheme": {"enum": ["eu-country", "nuts", "iso3166-1-alpha3", "ags", "berlin-bezirk", "cod-ab-pcode"]},
    "level": {"type": "string"},
    "code_list_version": {"type": ["string", "null"]},
    "series_id": {"type": "string"},
    "series_code": {"type": "string"},
    "indicator": {"type": "string"},
    "dimensions": {"type": "object"},
    "geography_code": {"type": "string"},
    "unit_label": {"enum": ["persons", "thousand persons", "per 1000 persons", "percent"]},
    "vintage_id": {"type": "string"},
    "release_at_ms": {"type": "integer"},
    "release_at_basis": {"type": "string"},
    "retrieved_at_ms": {"type": "integer"},
    "retrieved_at_basis": {"type": "string"},
    "revision_of": {"type": ["string", "null"]},
    "period": {"type": ["string", "null"]},
    "value_text": {"type": ["string", "null"]},
    "value": {"type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d+)?$"},
    "flags": {"type": "array", "items": {"type": "string"}},
    "kind": {"enum": ["publisher_flag", "definition_revision", "census_base_change"]},
    "source_revision": {"$ref": "#/definitions/source_revision"}
  },
  "allOf": [
    {"if": {"properties": {"record_type": {"const": "release"}}},
     "then": {"required": ["release_id", "provider", "published_on", "release_basis", "file_sha256", "evidence_origin"]}},
    {"if": {"properties": {"record_type": {"const": "definition_revision"}}},
     "then": {"required": ["definition_id", "definition_key", "revision_no", "valid_from", "content", "source_revision"]}},
    {"if": {"properties": {"record_type": {"const": "geography_level"}}},
     "then": {"required": ["level_id", "scheme", "level"]}},
    {"if": {"properties": {"record_type": {"const": "series"}}},
     "then": {"required": ["series_id", "provider", "series_code", "indicator", "geography_code", "level_id", "definition_key", "unit_label"]}},
    {"if": {"properties": {"record_type": {"const": "vintage"}}},
     "then": {"required": ["vintage_id", "series_id", "release_at_ms", "release_at_basis", "retrieved_at_ms", "retrieved_at_basis", "definition_id", "source_revision"]}},
    {"if": {"properties": {"record_type": {"const": "observation"}}},
     "then": {"required": ["period", "value_text", "value", "flags", "definition_id"]}},
    {"if": {"properties": {"record_type": {"const": "series_break"}}},
     "then": {"required": ["kind", "series_id"]}}
  ],
  "not": {"anyOf": [{"required": ["projection"]}, {"required": ["forecast"]}, {"required": ["cause"]}, {"required": ["driver"]},
                    {"required": ["merged_value"]}, {"required": ["average"]}, {"required": ["net"]}]}
}
