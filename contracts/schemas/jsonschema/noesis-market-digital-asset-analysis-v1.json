    "contract": {"const": "noesis-market-digital-asset-analysis-v1"},
    "asset_class": {"const": "digital_asset"},
    "formula_version": {"type": "string"},
    "status": {"enum": ["complete", "no_data"]},
    "identity": {"type": "object"},
    "calendar": {"type": "object"},
    "observations": {"type": "array"},
    "supply_history": {"type": "array"},
    "chain_reorganizations": {"type": "array"},
    "liquidity": {"type": "object"},
    "source_revision_ids": {"type": "array", "items": {"type": "string"}},
    "source_rights": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
