{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-market-digital-asset-analysis-v1.json",
  "type": "object",
  "required": ["contract", "asset_class", "formula_version", "status", "identity", "calendar", "observations", "supply_history", "chain_reorganizations", "liquidity", "source_revision_ids", "source_rights", "limitations"],
