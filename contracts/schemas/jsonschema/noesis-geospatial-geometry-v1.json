{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.local/schemas/noesis-geospatial-geometry-v1.json",
  "title": "Noesis time-bounded geometry",
  "type": "object",
  "required": ["contract", "geometry_id", "namespace", "place_id", "geometry", "crs", "precision_m", "simplified_from", "disputed", "admin_hierarchy", "source", "evidence", "generation", "valid_from_ms", "valid_to_ms", "observed_at_ms", "producer", "policy", "principal_id", "content_hash", "created_at_ms"],
  "properties": {
    "contract": {"const": "noesis-geospatial-geometry-v1"},
    "geometry_id": {"type": "string", "pattern": "^geometry:"},
    "namespace": {"type": "string", "minLength": 1},
    "place_id": {"type": ["string", "null"]},
    "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"enum": ["Point", "LineString", "Polygon"]}, "coordinates": {"type": "array"}}, "additionalProperties": false},
    "crs": {"const": "EPSG:4326"},
    "precision_m": {"type": "number", "minimum": 0},
    "simplified_from": {"type": ["string", "null"]},
    "disputed": {"type": "boolean"},
    "admin_hierarchy": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "generation": {"type": "integer", "minimum": 0},
    "valid_from_ms": {"type": ["integer", "null"]},
    "valid_to_ms": {"type": ["integer", "null"]},
    "observed_at_ms": {"type": "integer", "minimum": 0},
    "producer": {"type": "object", "required": ["name", "version"]},
    "policy": {"type": "object"},
    "principal_id": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at_ms": {"type": "integer", "minimum": 0},
    "idempotent": {"type": "boolean"}
  },
  "additionalProperties": false
}
