{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.local/schemas/noesis-schema-crosswalk-v1.json",
  "title": "Noesis Schema Crosswalk v1",
  "type": "object",
  "required": ["contract", "name", "semantic_version", "source", "target", "direction", "confidence", "conditions", "mappings", "owner", "provenance", "actor"],
  "properties": {
    "contract": {"const": "noesis-schema-crosswalk-v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$"},
    "semantic_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source": {"$ref": "#/definitions/reference"},
    "target": {"$ref": "#/definitions/reference"},
    "direction": {"enum": ["forward", "reverse", "bidirectional"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "conditions": {"type": "array", "items": {"type": "object"}},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "source", "target", "lossy"],
        "properties": {
          "kind": {"enum": ["field", "type", "relation"]},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "lossy": {"type": "boolean"},
          "condition": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "owner": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "#/definitions/provenance"},
    "actor": {"$ref": "#/definitions/actor"}
  },
  "definitions": {
    "reference": {
      "type": "object",
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {"enum": ["schema", "ontology", "constraint", "vocabulary", "crosswalk"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "source"],
      "properties": {
        "kind": {"enum": ["builtin", "user", "agent", "imported"]},
        "source": {"type": "string", "minLength": 1},
        "uri": {"type": "string"},
        "commit": {"type": "string"}
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["principal_id", "kind"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["user", "agent", "service"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
