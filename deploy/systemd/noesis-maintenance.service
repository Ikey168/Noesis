[Unit]
Description=Noesis continuous knowledge maintenance worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/noesis
ExecStart=/opt/noesis/.venv/bin/python scripts/knowledge_maintenance_worker.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
