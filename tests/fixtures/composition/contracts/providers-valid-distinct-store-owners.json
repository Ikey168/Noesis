   "contract": "noesis-capability-provider-v1",
   "description": "The existing Geospatial service: places, geometries, reviewable resolutions, spatial relations and acquired vector features in src/kb/geospatial.py and src/kb/geospatial_features.py, exposed through noesis-knowledge-engine tools. Coordinates are stored in WGS84 (EPSG:4326); projected source coordinates are transformed on import and keep their source CRS in provenance.",
   "implementation": {
    "identity": "src.kb.geospatial:GeospatialStore+src.kb.geospatial_features:GeospatialFeatureStore",
    "version": "1.0.0"
   },
   "provider_id": "noesis.geospatial",
   "source_packs": [
    {
     "config": "config/source_packs/geospatial.json",
     "pack_id": "geospatial-berlin",
     "range": "^1.0.0"
    }
   ],
   "stores": [
    {
     "record_kind": "place",
     "revision_addressing": "immutable",
     "tables": [
      "geospatial_places",
      "geospatial_place_revisions",
      "geospatial_place_current"
     ]
    },
    {
     "record_kind": "geometry",
     "revision_addressing": "immutable",
     "tables": [
      "geospatial_geometries"
     ]
    },
    {
     "record_kind": "geocode_resolution",
     "revision_addressing": "immutable",
     "tables": [
      "geocode_resolutions",
      "geocode_reviews"
     ]
    },
    {
     "record_kind": "spatial_receipt",
     "revision_addressing": "immutable",
     "tables": [
      "spatial_receipts"
     ]
    },
    {
     "record_kind": "geospatial_feature",
     "revision_addressing": "immutable",
     "tables": [
      "geospatial_features",
      "geospatial_feature_revisions",
      "geospatial_feature_current"
     ]
    }
   ],
   "version": "1.0.0"
