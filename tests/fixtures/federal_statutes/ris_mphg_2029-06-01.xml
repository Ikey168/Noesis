        <akn:FRBRExpression><akn:FRBRthis value="eli/bund/bgbl-1/2029/101/2029-06-01/1/deu/regelungstext-1"/><akn:FRBRdate date="2029-06-01" name="inkraft"/></akn:FRBRExpression>
      </akn:identification>
    </akn:meta>
    <akn:preface><akn:longTitle><akn:p><akn:docTitle>Gesetz über den Handel mit Musterpapieren (fiktiv)</akn:docTitle></akn:p></akn:longTitle></akn:preface>
    <akn:body>
      <akn:section eId="abschnitt-1"><akn:num>Abschnitt 1</akn:num><akn:heading>Allgemeine Vorschriften</akn:heading>
        <akn:article eId="para-1"><akn:num>§ 1</akn:num><akn:heading>Anwendungsbereich</akn:heading>
          <akn:paragraph eId="para-1_abs-1"><akn:num>(1)</akn:num><akn:content><akn:p>Dieses Gesetz gilt für den Handel mit Musterpapieren.</akn:p></akn:content></akn:paragraph>
          <akn:paragraph eId="para-1_abs-2"><akn:num>(2)</akn:num><akn:content><akn:p>Es gilt nicht für Staatsanleihen.</akn:p></akn:content></akn:paragraph>
        </akn:article>
        <akn:article eId="para-5"><akn:num>§ 5</akn:num><akn:heading>Meldepflichten</akn:heading>
          <akn:paragraph eId="para-5_abs-1"><akn:num>(1)</akn:num><akn:content><akn:p>Wer Musterpapiere erwirbt, hat dies der Aufsichtsstelle zu melden.</akn:p></akn:content></akn:paragraph>
          <akn:paragraph eId="para-5_abs-2"><akn:num>(2)</akn:num><akn:content><akn:p>Die Meldung ist innerhalb von zehn Handelstagen abzugeben.</akn:p></akn:content></akn:paragraph>
        </akn:article>
        <akn:article eId="para-8"><akn:num>§ 8</akn:num><akn:heading>Aufsicht</akn:heading>
          <akn:paragraph eId="para-8_abs-0"><akn:content><akn:p>Die Aufsichtsstelle überwacht die Einhaltung dieses Gesetzes.</akn:p></akn:content></akn:paragraph>
        </akn:article>
      </akn:section>
    </akn:body>
  </akn:act>
