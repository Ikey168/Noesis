# Terraform specific ignores
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local dev
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform lock files
.terraform.lock.hcl

# Terraform plan output
tfplan
*.tfplan

# Terraform variable files that might contain sensitive data
terraform.tfvars
terraform.tfvars.json

# Project organization
# Keep logs directory but ignore runtime artifacts written by local service backends
logs/*.log
logs/*.txt
logs/*.json
logs/*.jsonl
# Local cloud-emulator data stores (S3/DynamoDB/dashboards local backends)
dashboards_local/
data/dashboards/

# Temporary files and artifacts
*.tmp
*.temp
temp/
tmp/

# Demo results (keep structure but ignore generated files)
demo/results/*.json
demo/results/*.csv
demo/results/*.html

# Validation results
validation_results.json
validation/*.json

# Docker and containerization
.docker/
docker-compose.override.yml

# Artifacts directory
.artifacts/
backup_*/

# MLflow local tracking artifacts
mlruns/

# editor/backup files
*.bak

# Vendored dbt packages (regenerated by 'dbt deps')
dbt_packages/
**/dbt_packages/

# Local DuckDB analytics warehouse (generated on first run)
*.duckdb
*.duckdb.wal

# Local encryption artifacts (Issue #62)
data/tls/server.key
data/tls/server.crt
data/backups/*.enc
artifacts/figures/
