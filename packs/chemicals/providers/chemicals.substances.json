        "substance_revisions",
        "substance_identifiers",
        "substance_source_runs"
      ],
      "revision_addressable": true,
      "namespace_scoped": true
    },
    {
      "record_type": "substance-identity-candidate",
      "store": "src.kb.substances_identity",
      "tables": [
        "substance_identity_candidates"
      ],
      "revision_addressable": true,
      "namespace_scoped": true
    },
    {
      "record_type": "substance-link",
      "store": "src.kb.substances_links",
      "tables": [
        "substance_links"
      ],
      "revision_addressable": true,
      "namespace_scoped": true
    }
  ],
  "readiness_probes": [
