      "id": "political.campaign-finance",
      "contract": {
        "name": "noesis-campaign-finance-record",
        "version": "1.0.0"
      },
      "operations": [
        "committee-totals-as-of",
        "filing-amendment-chain",
        "list-filing-items",
        "affiliate-donations",
        "contest-filings",
        "export-evidence-bundle",
        "list-identity-candidates",
