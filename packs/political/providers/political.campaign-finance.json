        "revert-identity-match",
        "link-contests",
        "link-lobbying",
        "link-ownership",
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "records": "US FEC (OpenFEC committees, candidates, filings, Schedules A, B and E) and UK Electoral Commission (donations and spending exports) records as published, keyed by official identifiers, each with source, record revision, filing revision and observation time",
        "amendments": "every filing version is its own record with its amendment chain and most-recent flag as published; amended versions are never overwritten or re-aggregated without naming the versions used",
        "totals": "totals are as reported per filing version; any cross-period sum is labelled derived and lists the versions used",
        "matching": "committee, candidate, party and organisational-donor matches are reviewable, reversible identity decisions; nothing is merged or auto-accepted",
        "minimisation": "the CF01 donor data-minimisation decision: individual donors and payees keep no name, address, employer, occupation or donor id, are never matched or expanded, and individual contributions are returned only with the individual-items scope",
        "exclusions": "no influence scoring, no dark-money or undisclosed-funding inference and no profiling of individual donors"
      }
    }
  ],
