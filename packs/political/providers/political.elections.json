    }
  ],
  "readiness_probes": [
    {
      "id": "vintages",
      "kind": "table-exists",
      "target": "election_result_vintages"
    }
  ],
  "source_packs": [
    {
      "pack_id": "official-political-records",
      "version": "1.2.0",
      "range": "^1.2.0"
    }
  ]
}
