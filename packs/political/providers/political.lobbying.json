{
  "contract": "noesis-provider-descriptor-v1",
  "id": "political.lobbying",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.lobbying",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "political.lobbying",
      "contract": {
        "name": "noesis-lobbying-record",
        "version": "1.0.0"
      },
      "operations": [
        "list-dossier-declared-interests",
        "list-registrant-declarations",
        "list-official-meetings",
        "list-identity-candidates",
        "propose-identity-matches",
        "review-identity-match",
        "revert-identity-match",
        "link-dossier",
        "review-dossier-link",
        "revert-dossier-link"
      ],
      "semantic_constraints": {
        "registers": "EU Transparency Register, Lobbyregister, EP and Commission meeting declarations and the UK consultant-lobbyist register stay separate records with their own native identifiers and revision chains",
        "declarations": "what a registrant or official filed; spend stays the declared range with currency and period",
        "matching": "identity matches and dossier links are reviewable, reversible decisions; a shared keyword is only a candidate",
        "exclusions": "no influence, corruption or undeclared-lobbying claim and no point estimate of a spend range"
      }
    }
  ],
  "operations": [
    {
      "id": "list-dossier-declared-interests",
