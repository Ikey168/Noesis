  "capabilities": [
    {
      "id": "political.legislation",
      "contract": {
        "name": "noesis-legislation-record",
        "version": "1.0.0"
      },
      "operations": [
        "bill-dossier-as-of",
        "list-bill-votes",
        "lookup-sponsor-bills",
        "list-bill-records",
        "export-bill-evidence-bundle",
        "build-bill-dossier",
        "list-bill-link-candidates",
        "review-bill-record-link",
        "revert-bill-record-link",
        "list-identity-candidates",
        "propose-identity-matches",
        "review-identity-match",
        "revert-identity-match",
        "link-bill-lobbying",
        "link-bill-enactment",
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "records": "US Congress (congress.gov, senate.gov, GovInfo BILLS and BILLSTATUS) and UK Parliament (Bills, Commons and Lords Votes, Hansard) records as published, keyed by official identifiers, each a committed document revision cited by the existing legislative dossier store",
        "dossiers": "bills are dossiers in the existing LegislativeDossierStore; no parallel dossier store",
        "as_of": "stage and text version selected by source dates on or before the day, naming the revision used",
        "matching": "member identity, record-to-bill candidates and lobbying links are reviewable, reversible decisions; official member ids are external identifiers, never merged by name",
        "sources": "congress.gov and BILLSTATUS disagreements are shown, never reconciled",
        "exclusions": "no passage prediction, member scoring, ideology rating or summary presented as legal effect"
      }
    }
  ],
