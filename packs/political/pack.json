{
  "pack_format": "noesis-pack-v1",
  "name": "political",
  "version": "1.0.0",
  "description": "Official political knowledge with scoped identity and bitemporal research queries.",
  "source_types": ["note", "web"],
  "ui_flags": {},
  "panels": [],
  "planner_keywords": {
    "actors": ["officeholder", "party", "institution", "registrant", "interest representative", "lobbyist"],
    "events": ["election", "proposal", "vote", "regulation", "meeting", "registration", "deregistration"],
    "sources": ["transparency register", "lobbyregister", "register of consultant lobbyists", "federal returning officer", "electoral commission", "poll"]
  },
  "enrichers": [
    {
      "name": "political-keyword",
      "kind": "keyword_tag",
      "description": "Tag explicitly political official records.",
      "source_types": ["note", "web"],
      "params": {
        "field": "title",
        "label": "political",
        "keywords": ["election", "proposal", "vote", "regulation", "executive order"]
      }
    }
  ],
  "provisioning_templates": [],
  "capabilities": [
    "official-source-manifests",
    "scoped-entity-resolution",
    "bitemporal-office-terms",
    "proposal-vote-lifecycle",
    "political-research-queries",
    "lobbying-register-declarations",
    "lobbying-register-revisions",
    "declared-spend-ranges",
    "official-meeting-declarations",
    "lobbying-dossier-links",
    "lobbying-identity-review",
    "lobbying-monitoring",
    "election-result-vintages",
    "election-poll-series",
    "election-identity-review",
    "election-boundaries-as-of",
    "election-forecast-resolution",
    "election-news-evidence",
    "election-monitoring",
    "legislation-bill-dossiers",
    "legislation-as-of",
    "legislation-identity-review",
    "legislation-links",
    "legislation-monitoring",
    "campaign-finance-filings",
    "campaign-finance-amendment-history",
    "campaign-finance-totals-as-of",
    "campaign-finance-affiliate-donations",
    "campaign-finance-contest-filings",
    "campaign-finance-identity-review",
    "campaign-finance-links",
    "campaign-finance-monitoring"
  ],
  "schema_versions": {
    "source": "1.0.0",
    "model": "1.0.0",
    "research": "1.0.0",
    "source-pack": "1.2.0",
    "lobbying-record": "1.0.0",
    "lobbying-answer": "1.0.0",
    "lobbying-dossier-link": "1.0.0",
    "lobbying-notification": "1.0.0",
    "election-record": "1.0.0",
    "election-answer": "1.0.0",
    "election-notification": "1.0.0",
    "legislation-record": "1.0.0",
    "legislation-answer": "1.0.0",
    "legislation-link": "1.0.0",
    "legislation-notification": "1.0.0",
    "campaign-finance-record": "1.0.0",
    "campaign-finance-answer": "1.0.0",
    "campaign-finance-link": "1.0.0",
    "campaign-finance-notification": "1.0.0"
  },
  "ontology_extensions": {
    "extends": "noesis-canonical-entity-relation-ontology",
    "object_types": [
      "election", "institution", "instrument", "jurisdiction", "office",
      "office_term", "party", "person", "proposal", "vote", "lobbying_registrant",
      "lobbying_client", "declared_interest", "spend_declaration", "register_revision",
      "official_meeting", "election_release", "contest", "constituency", "candidate_or_list",
      "result_vintage", "poll_series", "poll_reading"
    ],
    "relation_types": [
      "adopted_as", "contests", "corrects", "holds_office", "in_jurisdiction",
      "institutional_position", "member_of_party", "part_of", "proposal_amends",
      "proposal_sponsored_by", "roll_call_on", "succeeds", "term_for_office",
      "term_holder", "vote_cast_by", "declares_interest_in", "represents_client",
      "met_official", "revision_of", "declared_in_register", "contest_of_election", "contest_in_constituency",
      "vintage_of_contest", "result_for", "poll_about_election", "successor_constituency", "successor_party"
    ]
  },
  "exclusions": [
    "influence or corruption claims",
    "undeclared-lobbying inference",
    "point estimates, totals or averages of declared spend ranges",
    "merged cross-register registrant records",
    "dossier links from shared keywords alone",
    "scraped register or aggregator portals",
    "seat or outcome predictions",
    "poll aggregation into a single true number",
    "causal claims from news framing or sentiment",
    "overwriting preliminary results with certified ones",
    "bill passage prediction",
    "member scoring or ideology ratings",
    "summaries presented as a bill's legal effect",
    "influence scoring of donors or recipients",
    "dark-money or undisclosed-funding inference",
    "profiling of individual donors beyond the published minimised record"
  ]
}
