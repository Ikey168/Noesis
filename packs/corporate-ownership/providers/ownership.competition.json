{
  "contract": "noesis-provider-descriptor-v1",
  "id": "ownership.competition",
  "version": "1.0.0",
  "description": "Competition-authority cases (European Commission merger, antitrust and state-aid cases, UK CMA cases, US FTC and DOJ Antitrust Division actions) with append-only stages, parties and decision documents as published, and EU State Aid Transparency Award Module awards; parties and beneficiaries reach ownership entities only through reviewable identity; exact citation links to Legal works and related cases; as-of answers and subscription monitors.",
  "implementation": {
    "name": "src.kb.competition",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "ownership.competition",
      "contract": {
        "name": "noesis-competition-case",
        "version": "1.0.0"
      },
      "operations": [
        "competition-source-contracts",
        "competition-readiness",
        "lookup-competition-cases",
        "competition-case-history",
        "state-aid-awards-for-beneficiary",
        "build-competition-dossier",
        "list-competition-identity-candidates",
        "propose-competition-identity-matches",
        "review-competition-identity-match",
        "revert-competition-identity-match",
        "link-competition-citations",
        "list-competition-citation-links",
        "create-competition-monitor",
        "run-competition-monitor",
        "poll-competition-monitor"
      ],
      "semantic_constraints": {
        "records": "noesis-competition-record-v1 cases, append-only stages, parties, decision documents and state-aid awards as published, persisted through the ownership record store with one revision per published change; documents linked, not mirrored",
        "identity": "case parties and aid beneficiaries reach ownership entities only through reviewable, reversible candidates in ownership.identity: published identifiers first, names as low evidence, never auto-accepted; unmatched parties stay as published; conflicts surfaced",
        "citations": "legal acts (CELEX/ELI, TFEU articles, UK Acts, US Code) and related cases linked by exact citation only; unresolved references stay as source text; each link records the citing revision",
        "authorities": "cases and awards of different authorities are kept side by side and never merged; totals are computed views listing their inputs, never stored",
        "exclusions": "no prediction of case outcomes, no market-power or market-definition assessment, no assessment of the compatibility or legality of aid, no legal advice"
      }
    }
  ],
