{
  "pack_format": "noesis-pack-v2",
  "name": "geospatial",
  "version": "1.0.0",
  "description": "Acquired vector features with source identity, revision history and replayable points-inside-boundary queries.",
  "requires": [
    {
      "capability": "transit.schedules",
      "range": "^1.0.0"
    }
  ],
  "contributes": {
    "providers": [
      {
        "provider_id": "noesis.geospatial",
        "version": "1.0.0"
      },
      {
        "provider_id": "noesis.transit",
        "version": "1.0.0"
      }
    ]
  },
  "references": {
    "source_packs": [
      {
        "pack_id": "geospatial-berlin",
        "range": "^1.0.0",
        "config": "config/source_packs/geospatial.json"
      }
    ]
  },
  "aliases": {
    "capability_labels": {
      "bounded-geojson-featurecollection-import": "spatial.feature-import",
      "complete-snapshot-removal-semantics": "sources.acquire",
      "durable-spatial-projection": "spatial.geometry-store",
      "native-wfs-2.0.0-geojson-acquisition": "sources.acquire",
      "points-inside-boundary-query": "spatial.points-within-boundary",
      "provenance-preserving-feature-revisions": "spatial.feature-inspect",
      "reviewable-boundary-name-resolution": "spatial.boundary-resolution"
    }
  }
}
