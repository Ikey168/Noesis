        "infra_asset_revisions",
        "infra_status_revisions",
        "infra_capacity_revisions",
        "infra_owner_assertions",
        "infra_receipts",
        "infra_provider_state"
      ],
      "revision_addressable": true,
      "namespace_scoped": true
    },
    {
      "record_type": "infrastructure-identity-match",
      "store": "src.kb.infrastructure_identity",
      "tables": [
        "infra_asset_matches",
        "infra_match_reviews"
      ],
      "revision_addressable": true,
      "namespace_scoped": true
    },
    {
      "record_type": "infrastructure-link",
      "store": "src.kb.infrastructure_identity",
      "tables": [
        "infra_links",
        "infra_link_reviews"
      ],
      "revision_addressable": true,
