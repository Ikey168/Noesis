{
  "contract": "noesis-provider-descriptor-v1",
  "id": "geospatial.infrastructure",
  "version": "1.0.0",
  "description": "Critical infrastructure registries in the Geospatial pack (optional infrastructure feature): power plants, generating units, pipelines, LNG terminals, transmission lines, substations, gas points and mines as published by WRI GPPD, Global Energy Monitor, OpenStreetMap (Overpass), EIA and ENTSOG, with status and capacity revisions, owner assertions, reviewable identity, citation links and monitors. No new spatial store; no vulnerability assessment or valuation.",
  "implementation": {
    "name": "src.kb.infrastructure_*",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "source_packs": [
    {
      "pack_id": "geospatial-infrastructure",
      "version": "1.0.0",
      "range": "^1.0.0"
    }
  ],
  "capabilities": [
    {
      "id": "geospatial.infrastructure-assets",
      "contract": {
        "name": "noesis-infrastructure-asset-record",
        "version": "1.0.0"
      },
      "operations": [
        "infrastructure-source-contracts",
        "infrastructure-readiness",
        "acquire-infrastructure-source",
        "register-infrastructure-schemas",
        "list-infrastructure-assets",
        "infrastructure-asset-history"
      ],
      "semantic_constraints": {
        "revisions": "every distinct publication is an asset revision; status and capacity changes append revisions, earlier ones kept",
        "vocabulary": "the publisher's status text is kept beside the normalized status",
        "owners": "owner, operator and parent names and shares as published; never resolved in the record",
        "geometry": "projected onto the existing geospatial store with a CRS and precision receipt; unlocated assets are never geocoded",
        "sensitivity": "only attributes the publisher releases; no vulnerability, criticality or valuation",
        "coverage": "explicit bounded selections (docs/development/infrastructure-evidence/source-audit.md)"
      }
    },
    {
      "id": "geospatial.infrastructure-answers",
      "contract": {
        "name": "noesis-infrastructure-answer",
        "version": "1.0.0"
      },
      "operations": [
        "create-infrastructure-monitor",
        "infrastructure-assets-in-place",
        "infrastructure-assets-of-operator",
        "link-infrastructure-records",
        "list-infrastructure-asset-matches",
        "list-infrastructure-links",
        "list-infrastructure-operator-candidates",
        "poll-infrastructure-monitor",
        "propose-infrastructure-asset-matches",
        "propose-infrastructure-operator-matches",
        "review-infrastructure-asset-match",
        "review-infrastructure-link",
        "review-infrastructure-operator-match",
        "run-infrastructure-monitor"
      ],
      "semantic_constraints": {
        "as_of": "status by effective date (else first publication), capacity per metric and direction, owners from the revision published by the date; optional known_by cutoff",
        "side_by_side": "sources grouped only by accepted same_asset matches; disagreements listed, never resolved",
        "identity": "published cross-references are identifier matches; proximity+name+class pairs are review candidates; operators through the shared ownership identity state machine",
        "links": "energy, legal and environment links only by explicit identifier or citation; overlap is a candidate; absent packs are skipped",
        "coverage": "outside the selected areas is not_covered; empty answers are none on record",
        "monitoring": "knowledge subscriptions at committed watermarks; no scheduler"
      }
    }
  ],
  "operations": [
    {
      "id": "infrastructure-source-contracts",
      "tool": "noesis-knowledge-engine.infrastructure_source_contracts",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "infrastructure-readiness",
      "tool": "noesis-knowledge-engine.infrastructure_readiness",
      "side_effect": "read-only",
      "idempotency": {
