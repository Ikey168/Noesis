{
  "contract": "noesis-provider-descriptor-v1",
  "id": "geospatial.housing",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.housing",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "source_packs": [
    {
      "pack_id": "geospatial-berlin",
      "version": "1.3.0",
      "range": "^1.3.0"
    }
  ],
  "capabilities": [
    {
      "id": "geospatial.housing-records",
      "contract": {
        "name": "noesis-housing-record",
        "version": "1.0.0"
      },
      "operations": [
        "list-records",
        "inspect-record",
        "compare-land-value-revisions",
        "rent-index-edition",
        "statistics",
        "indicator-values",
        "projection-outcomes"
      ],
      "semantic_constraints": {
        "values": "every value keeps its published text, currency, unit and valuation date, edition or vintage; money is never converted and nothing is rounded",
        "revisions": "an entity is its source, identifier and the source's own date; unchanged re-reading adds nothing, a changed reading is a correction and a reversion is a further correction",
        "side_by_side": "different sources, valuation dates, editions and vintages are separate records, never merged or averaged",
        "unknown_dates": "a missing date stays unknown and never defaults to the acquisition time",
        "geometries": "zone, plan and residential-area records reference Geospatial feature revisions and geometries, never copy them",
        "value_surface": "no source offers an interpolable value surface; values apply inside their published zone, cell or reporting area",
        "exclusions": "no property valuation, rent or investment advice, tenancy legal advice or interpolated value"
      }
    },
    {
      "id": "geospatial.housing-dossiers",
      "contract": {
        "name": "noesis-housing-dossier",
        "version": "1.0.0"
      },
      "operations": [
        "housing-dossier",
        "replay-dossier",
        "links"
      ],
      "semantic_constraints": {
        "places": "addresses and parcels through reviewable place resolution; districts by the published ALKIS Bezirk code",
        "containment": "calculate-spatial-relation against each record's pinned geometry and point-in-feature for districts; boundary-edge points count as inside every touching zone and are reported, never resolved",
        "as_of": "latest valuation date, dated stage, edition valid_from and vintage not after the requested date, with the selection basis",
        "links": "explicit published citations only; name or place similarity is a reviewable discovery candidate; news is discovery context only",
        "transit": "stops are accessibility context only and carry no valuation meaning"
      }
    }
  ],
  "operations": [
    {
      "id": "list-records",
      "tool": "noesis-knowledge-engine.list_housing_records",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:housing:read"
