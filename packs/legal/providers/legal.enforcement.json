    {
      "id": "legal.enforcement",
      "contract": {
        "name": "noesis-enforcement-record",
        "version": "2.0.0"
      },
      "operations": [
        "enforcement-source-contracts",
        "enforcement-readiness",
        "enforcement-actions-for-entity",
        "enforcement-actions-by-authority",
        "enforcement-action-history",
        "export-enforcement-evidence-bundle",
        "list-enforcement-links",
        "link-enforcement-records",
        "list-enforcement-identity-candidates",
        "propose-enforcement-identity-matches",
        "review-enforcement-identity-match",
        "revert-enforcement-identity-match",
        "create-enforcement-monitor",
        "run-enforcement-monitor",
        "poll-enforcement-monitor"
      ],
      "semantic_constraints": {
        "records": "SEC litigation releases and administrative proceedings, FCA final notices, EPA ECHO cases and EDPB Article 60 final decisions as published: authority, action, organisational respondents, notices as versioned documents, penalties and appeals; every published change, correction or removal is an immutable revision with source, record revision and as-of time",
        "outcomes": "outcomes, settlement admission wording ('without admitting or denying') and penalties are quoted as published; a settled outcome is never merged into a finding and an initiated action is never treated as proof of wrongdoing",
        "penalties": "amounts are the published text with their currency; undisclosed amounts stay explicit; nothing is converted or summed across currencies or authorities",
        "minimisation": "EN01: organisational respondents only; individuals are counted, never named, matched, profiled or monitored; personal attributes are rejected at write time and in every tool output",
        "identity": "respondents reach ownership entities only through reviewable, reversible identity candidates (published identifiers before names), never auto-accepted; authorities are source identities",
        "links": "competition cases, court dockets and Legal works by exact citation, market filings by a published CIK, ownership entities by accepted match; missing providers or targets are reported, never dropped; no causal link to market events",
        "exclusions": "no risk or compliance scoring, no inference of wrongdoing from an initiated action, no merging of settled outcomes into findings, no profiling of named individuals, no legal advice"
      }
    }
  ],
