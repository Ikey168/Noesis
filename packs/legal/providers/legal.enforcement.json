        "review-enforcement-respondent-match",
        "revert-enforcement-respondent-match",
        "create-enforcement-monitor",
        "run-enforcement-monitor",
        "poll-enforcement-monitor"
      ],
      "semantic_constraints": {
        "records": "SEC litigation releases and administrative proceedings, FCA final notices, EPA ECHO case reports and EDPB Article 60 register entries as published: authority, native identifier, respondents, legal bases, key dates, outcome, penalties and appeals; every published update is an immutable revision and a correction or removal by the source is a revision, never a deletion",
        "outcomes": "outcomes are quoted as published; a settlement keeps its stated admission wording ('without admitting or denying') and is never merged into a finding; an initiated action is not a finding of wrongdoing",
        "penalties": "type, amount text, amount and currency as published; before and after a settlement discount kept apart; never converted or summed across currencies or authorities; unpublished figures stay explicit unknowns",
        "minimisation": "natural-person respondents keep an action-scoped pseudonym and role only; names, reference numbers, addresses and dates of birth are never stored; individual-only actions are not recorded; natural persons are never matched, queried or monitored; no personal profile",
        "identity": "authorities are source identities; organisation respondents reach entities only through reviewable, reversible identity candidates (published identifiers before names), never auto-accepted; unmatched respondents stay visible",
        "links": "legislation and rules, competition cases, court dockets and Market issuers are linked by exact citation, published identifier or accepted match only, at specific revisions; missing providers and targets are reported; no causal inference",
        "exclusions": "no risk or compliance scoring, no inference of wrongdoing, no profiling of named individuals, no legal advice"
      }
    }
  ],
