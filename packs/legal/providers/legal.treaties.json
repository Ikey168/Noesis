        "list-treaty-links",
        "create-treaties-monitor",
        "run-treaties-monitor",
        "poll-treaties-monitor"
      ],
      "semantic_constraints": {
        "records": "treaties, language expressions, participants, treaty actions and statements exactly as the UN Treaty Collection, CELLAR and the Council of Europe Treaty Office publish them; every record carries its source, record revision and as-of time; depositary corrections are new revisions and rows a source no longer shows are removed-by-source revisions, never deletions",
        "as_of": "a participant's status at a date is selected by the action, deposit and effective dates as published; pending and unclear statuses are returned with the source text and answers cite the depositary revision; nothing is inferred",
        "statements": "reservations, declarations, objections and notes are kept verbatim with their anchors, linked to the action and to the objected reservation only where the source links them",
        "minimisation": "TR01: no natural person is a field, a key, a match or a monitor target; contact details in declarations are withheld at ingestion and any personal field is refused at write time",
        "identity": "participants match places and each other through reviewable, reversible candidates (published ISO codes before names); treaties match across sources through published cross-references only; nothing is merged or auto-accepted",
        "links": "Legal works, sanctions legal bases and Trade flows reporters are linked by citation, shared identifier or accepted match only, pointing at record revisions; missing providers and targets are reported",
        "exclusions": "no legal advice, no inference of obligations or compliance, no interpretation of the legal effect of reservations, no treaty-text redistribution beyond what each source licenses (texts are linked)"
      }
    }
  ],
