  },
  "capabilities": [
    {
      "id": "legal.courts",
      "contract": {
        "name": "noesis-court-docket",
        "version": "1.0.0"
      },
      "operations": [
        "courts-justice-source-contracts",
        "courts-justice-readiness",
        "lookup-dockets",
        "dockets-citing-provision",
        "docket-as-of",
        "list-court-citation-links",
        "link-court-citations",
        "list-court-identity-candidates",
        "propose-court-party-matches",
        "review-court-party-match",
        "revert-court-party-match",
        "create-courts-justice-monitor",
        "run-courts-justice-monitor",
        "poll-courts-justice-monitor"
      ],
      "semantic_constraints": {
        "records": "CourtListener dockets, RECAP docket entries and opinion clusters as published, projected onto Legal works, expressions and versions; one revision per provider modification",
        "minimisation": "parties keep role as published and an organisation/natural-person flag; organisation names only; natural persons are pseudonymised, never matched, aggregated, queried or monitored; no personal profile",
        "outcomes": "case outcomes are quoted disposition text with a locator; no derived win/loss label or outcome prediction",
        "links": "provisions and decisions are linked by exact citation parsing only; unresolved citations stay as source text; the citing relationship is never characterised",
        "identity": "courts by CourtListener court id; organisational parties only through reviewable, reversible identity candidates, never auto-accepted",
        "exclusions": "no recidivism or risk scoring, no legal advice, no personal profiles of private individuals"
      }
    }
  ],
