{
  "contract": "noesis-provider-descriptor-v1",
  "id": "legal.justice-statistics",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.justice_statistics",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "legal.justice-statistics",
      "contract": {
        "name": "noesis-justice-statistic",
        "version": "1.0.0"
      },
      "operations": [
        "justice-statistics-for-place",
        "compare-justice-statistics",
        "resolve-justice-places",
        "list-justice-place-resolutions",
        "review-justice-place",
        "record-justice-comparability",
        "review-justice-comparability"
      ],
      "semantic_constraints": {
        "records": "FBI Crime Data Explorer, data.police.uk and Eurostat crime statistics as released: definitions (UCR/NIBRS, ICCS, publisher categories) with revisions, observations with flags and coverage, and vintages",
        "as_of": "the vintage released on or before the date; earlier vintages stay queryable; gaps and suppressed values are explicit",
        "comparability": "series of different jurisdictions are returned separately; an aligned comparison needs a stated comparability note for every pair",
        "places": "reporting areas map to geospatial places by exact published code; ambiguous mappings stay review candidates",
        "minimisation": "police.uk crimes are counts only; locations and persistent IDs are not stored",
        "exclusions": "no rankings of places, no neighbourhood safety ratings, no risk scores"
      }
    }
  ],
  "operations": [
    {
      "id": "justice-statistics-for-place",
      "tool": "noesis-knowledge-engine.justice_statistics_for_place",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "vintages",
      "required_scopes": [
        "knowledge:legal:read"
