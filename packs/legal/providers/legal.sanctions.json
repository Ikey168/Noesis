{
  "contract": "noesis-provider-descriptor-v1",
  "id": "legal.sanctions",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.sanctions",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "legal.sanctions",
      "contract": {
        "name": "noesis-sanctions-record",
        "version": "1.0.0"
      },
      "operations": [
        "lookup-designation",
        "designation-history-as-of",
        "control-list-entry-as-of",
        "compare-control-list-editions",
        "trade-context"
      ],
      "semantic_constraints": {
        "lists": "EU, UN, OFAC and UK lists stay separate records with their own revision chains",
        "matching": "cross-list and entity matches are reviewable, reversible identity decisions only",
        "versioning": "listing revisions derived from successive snapshots; control lists by annex edition",
        "exclusions": "no screening verdict, compliance determination or legal advice"
      }
    }
  ],
  "operations": [
    {
      "id": "lookup-designation",
      "tool": "noesis-knowledge-engine.lookup_sanctions_designation",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "designations",
      "required_scopes": [
        "knowledge:legal:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "designation-history-as-of",
      "tool": "noesis-knowledge-engine.designation_history_as_of",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "designations",
      "required_scopes": [
        "knowledge:legal:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "control-list-entry-as-of",
      "tool": "noesis-knowledge-engine.control_list_entry_as_of",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "designations",
      "required_scopes": [
        "knowledge:legal:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "compare-control-list-editions",
      "tool": "noesis-knowledge-engine.compare_control_list_editions",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "designations",
      "required_scopes": [
        "knowledge:legal:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "trade-context",
      "tool": "noesis-knowledge-engine.sanctions_trade_context",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "designations",
      "required_scopes": [
        "knowledge:legal:read"
      ],
      "required_context": [
        "namespace"
      ]
    }
  ],
  "stores": [
    {
      "record_type": "sanctions-record",
      "store": "src.kb.sanctions",
      "tables": [
        "sanctions_snapshots",
        "sanctions_designations",
        "sanctions_revisions",
        "sanctions_snapshot_members",
        "sanctions_aliases",
        "sanctions_programmes",
        "sanctions_legal_bases",
        "sanctions_control_entries"
      ],
      "revision_addressable": true,
      "namespace_scoped": true
    }
  ],
  "readiness_probes": [
    {
      "id": "designations",
      "kind": "table-exists",
      "target": "sanctions_designations"
    }
  ],
  "source_packs": [
    {
      "pack_id": "legal-research",
      "version": "1.2.0",
      "range": "^1.1.0"
    }
  ]
}
