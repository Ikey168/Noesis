{
  "contract": "noesis-provider-descriptor-v1",
  "id": "news.fact-checks",
  "version": "1.0.0",
  "description": "Published fact-checks in the News pack (#2659): ClaimReview records from the Google Fact Check Tools API and Data Commons ClaimReview releases, and IFCN signatory status history, as published, each with source, record revision and as-of time; reviewable claimant, claim and publisher identity, citation and accepted-match links to news articles, OSINT corroboration, claim timelines and source identities, as-of answers and subscription monitors.",
  "implementation": {
    "name": "src.kb.fact_checks_records",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "news.fact-checks",
      "contract": {
        "name": "noesis-fact-check-record",
        "version": "2.0.0"
      },
      "operations": [
        "fact-check-source-contracts",
        "fact-check-readiness",
        "fact-checks-of-claim-or-claimant",
        "fact-checks-citing-article",
        "fact-check-revision-history",
        "export-evidence-bundle",
        "list-identity-candidates",
        "list-links",
        "propose-identity-matches",
        "review-identity-match",
        "revert-identity-match",
        "link-fact-checks",
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "optional_features": "fact-checks-google, fact-checks-datacommons and fact-checks-ifcn, each default off and independent",
        "records": "fact-checks keyed by publisher, review URL and reviewed claim; publishers keyed by website domain; every record with source, record revision and as-of time; publisher updates, corrections and removals are revisions, never deletions",
        "ratings": "rating text and any numeric rating with its scale exactly as published; differing ratings across publishers are shown side by side and never reconciled",
        "matching": "claimant, claim and publisher matches are reviewable, reversible identity decisions (published identifiers before names); nothing is merged or auto-accepted",
        "links": "news articles by cited URL (wa-canon-v1), OSINT corroboration, claim timelines and source identities only through accepted matches; absent providers degrade to an unavailable report",
        "minimisation": "the FC01 decision: no claimant image, job title, contact details, birth date or social profile, no individual review author, social-platform appearances only as a URL digest",
        "exclusions": "no truth verdicts by Noesis, no rating normalisation presented as the publisher's, no automatic claim matching without review, no scraping beyond each publisher's terms",
        "live": "every source is unverified-live; offline fixture coverage only until the FC13 live run"
      }
    }
  ],
  "operations": [
    {
      "id": "fact-check-source-contracts",
      "tool": "noesis-knowledge-engine.fact_check_source_contracts",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:read"
      ]
    },
    {
      "id": "fact-check-readiness",
