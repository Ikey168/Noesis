  "capabilities": [
    {
      "id": "news.fact-checks",
      "contract": {
        "name": "noesis-fact-check-record",
        "version": "1.0.0"
      },
      "operations": [
        "fact-checks-for-claim",
        "fact-checks-for-claimant",
        "fact-checks-citing-url",
        "fact-check-history",
        "publisher-status-as-of",
        "export-evidence-bundle",
        "list-matches",
        "list-links",
        "propose-matches",
        "review-match",
        "revert-match",
        "link-records",
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "records": "ClaimReview fact-checks from the Google Fact Check Tools API and the Data Commons ClaimReview feed, keyed by publisher site and review URL, and IFCN signatories with status history, each with source, record revision and as-of time",
        "ratings": "ratings are the publisher's text and any numeric value with the publisher's own scale, verbatim; conflicting ratings are shown side by side, never merged, averaged or normalised",
        "revisions": "a publisher's update, a status change and a removal by the source are revisions, never deletions; each release of the Data Commons feed is a vintage",
        "matching": "claimant, claim and publisher matches are reviewable, reversible assertions with method, evidence and confidence; nothing is merged or auto-accepted and a claim reaches fact-checks only through an accepted match",
        "links": "news-article links by citation (wa-canon-v1 URL rules) and argument-claim, OSINT-corroboration and claim-timeline links through accepted matches, each pointing at specific revisions; absent providers and targets are reported",
        "minimisation": "the FC01 decision: natural-person review authors, images, job titles and other personal attributes are never stored; claimant queries, matches and monitors need knowledge:news:fact-checks:claimant:read",
        "exclusions": "no truth verdicts by Noesis, no rating normalisation presented as the publisher's, no automatic claim matching without review, no scraping beyond each publisher's terms",
        "features": "fact-checks-google, fact-checks-datacommons and fact-checks-ifcn are separate optional features of the News bundle, default off"
      }
    }
  ],
  "operations": [
