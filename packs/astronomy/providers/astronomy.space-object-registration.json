{
  "contract": "noesis-provider-descriptor-v1",
  "id": "astronomy.space-object-registration",
  "version": "1.0.0",
  "description": "Space-object registration, operator assertions and re-entry records as published: UNOOSA Online Index entries and UN registration documents (symbol, locator, language, verbatim; transfers and status changes as dated entries), ESA DISCOS under its account terms (optional, never redistributed) and Aerospace Corporation re-entry predictions and confirmed reports, linked to SATCAT/GCAT objects and parties through reviewable identity and to Legal and Science records by citation.",
  "implementation": {
    "name": "src.kb.astronomy_registration_queries",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "astronomy.space-object-registration",
      "contract": {
        "name": "noesis-astronomy-space-object-registration",
        "version": "1.0.0"
      },
      "operations": [
        "object-registration-as-of",
        "reentry-record",
        "export-registration-evidence",
        "registration-status",
        "list-registration-candidates",
        "list-registration-citations",
        "match-registration-objects",
        "match-registration-parties",
        "review-registration-party",
        "revert-registration-party",
        "link-registration-citations",
        "revert-registration-citation",
        "project-reentry-locations",
        "create-registration-monitor",
        "run-registration-monitor",
        "poll-registration-monitor"
      ],
      "semantic_constraints": {
        "as_of": "published by the as-of cutoff (a date counts as its end, UTC) and, when given, acquired by acquired_by_ms; missing registration is 'none on record' with the sources consulted",
        "registration": "UN document symbol, paragraph locator, language and verbatim quotation; registered orbital values never reconciled with catalogue elements; transfers and status changes are dated entries beside the original",
        "identity": "exact COSPAR/NORAD links with evidence; conflicts and name-only registrations reviewable; parties through ownership.identity (space-registration: keys); records never merged",
        "exclusions": "no re-entry or collision prediction; no attribution beyond published registrations and operator assertions"
      }
    },
    {
      "id": "astronomy.discos",
      "contract": {
        "name": "noesis-astronomy-discos-access",
        "version": "1.0.0"
      },
      "operations": [
        "discos-access-status"
      ],
      "semantic_constraints": {
        "access": "account-gated (NOESIS_ESA_DISCOS_TOKEN); disabled without a token; permitted subset or citation only; never redistributed or exported"
      }
    }
  ],
