      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "create-monitor",
      "tool": "noesis-knowledge-engine.create_astronomy_monitor",
      "side_effect": "local-mutation",
      "idempotency": {
