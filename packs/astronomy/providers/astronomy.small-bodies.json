{
  "contract": "noesis-provider-descriptor-v1",
  "id": "astronomy.small-bodies",
  "version": "1.0.0",
  "description": "Small bodies as the MPC and JPL publish them: designations, MPC identifications, orbit solution vintages per publisher and quoted Sentry listings; also the pack's record owner (every astronomy record), reviewable identity, citation links to Science papers and monitors.",
  "implementation": {
    "name": "src.kb.astronomy_queries",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "astronomy.small-bodies",
      "contract": {
        "name": "noesis-astronomy-small-body",
        "version": "1.0.0"
      },
      "operations": [
        "small-body-history",
        "orbit-solution-as-of",
        "impact-risk-listing-as-of"
      ],
      "semantic_constraints": {
        "as_of": "published by the as-of cutoff (a date counts as its end, UTC) and, when given, acquired by acquired_by_ms; not_yet_published before the first publication",
        "solutions": "one vintage per publisher solution ID with epoch, arc and observation count; never averaged or merged across publishers",
        "identity": "designations link only through MPC identifications and source-stated designations",
        "exclusions": "no orbit, ephemeris, conjunction, risk verdict, disposition or advice is computed by Noesis"
      }
    },
    {
      "id": "astronomy.identity",
      "contract": {
        "name": "noesis-astronomy-identity-candidate",
        "version": "1.0.0"
      },
      "operations": [
        "propose-identity",
        "review-identity",
        "revert-identity",
        "list-identity"
      ],
      "semantic_constraints": {
        "matching": "source-stated identifiers link deterministically; everything else is a reviewable candidate recorded as an entity identity decision; similar names are never accepted"
      }
    },
    {
      "id": "astronomy.citations",
      "contract": {
        "name": "noesis-astronomy-citation-link",
        "version": "1.0.0"
      },
      "operations": [
        "link-citations",
        "revert-citation",
        "list-citations"
      ],
      "semantic_constraints": {
        "composition": "links point to Science literature records (science.literature) by exact bibcode or DOI; the Science pack owns the paper; unresolved references stay visible"
      }
    },
    {
      "id": "astronomy.monitoring",
      "contract": {
        "name": "noesis-astronomy-monitor",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "refresh": "platform.subscriptions watermarks; no separate scheduler"
      }
    }
  ],
  "operations": [
    {
      "id": "small-body-history",
      "tool": "noesis-knowledge-engine.small_body_history",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "orbit-solution-as-of",
      "tool": "noesis-knowledge-engine.orbit_solution_as_of",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "impact-risk-listing-as-of",
      "tool": "noesis-knowledge-engine.impact_risk_listing_as_of",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "propose-identity",
      "tool": "noesis-knowledge-engine.propose_astronomy_identity_matches",
      "side_effect": "local-mutation",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:read",
        "knowledge:astronomy:write"
      ],
      "required_context": [
        "namespace",
        "principal"
      ]
    },
    {
      "id": "review-identity",
      "tool": "noesis-knowledge-engine.review_astronomy_identity_match",
      "side_effect": "local-mutation",
      "idempotency": {
        "supported": true,
        "receipt": "entity identity decisions"
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:review"
      ],
      "required_context": [
        "namespace",
        "principal"
      ]
    },
    {
      "id": "revert-identity",
      "tool": "noesis-knowledge-engine.revert_astronomy_identity_match",
      "side_effect": "local-mutation",
      "idempotency": {
        "supported": true,
        "receipt": "entity identity decisions"
