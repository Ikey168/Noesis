      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:read",
        "knowledge:subscriptions:read"
      ],
      "required_context": [
        "principal"
      ]
    }
  ],
  "stores": [
    {
      "record_type": "astronomy-record",
      "store": "src.kb.astronomy_store",
      "tables": [
        "astronomy_records",
        "astronomy_record_revisions",
        "astronomy_record_keys",
        "astronomy_listing_observations",
        "astronomy_page_receipts",
        "astronomy_identity_candidates",
        "astronomy_site_resolutions",
        "astronomy_citation_links"
      ],
      "revision_addressable": true,
      "namespace_scoped": true
    }
  ],
  "readiness_probes": [
