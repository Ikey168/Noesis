      "side_effect": "local-mutation",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:read",
        "knowledge:astronomy:write"
      ],
      "required_context": [
        "namespace",
        "principal"
      ]
    },
    {
      "id": "revert-citation",
      "tool": "noesis-knowledge-engine.revert_astronomy_citation",
      "side_effect": "local-mutation",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:review"
      ],
      "required_context": [
        "namespace",
        "principal"
      ]
    },
    {
      "id": "list-citations",
      "tool": "noesis-knowledge-engine.astronomy_citations",
      "side_effect": "read-only",
      "idempotency": {
