      "tool": "noesis-knowledge-engine.list_astronomy_identity_candidates",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "records",
      "required_scopes": [
        "knowledge:astronomy:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "link-citations",
