    "name": "src.kb.demographics",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "economics.demographics",
      "contract": {
        "name": "noesis-demographic-series",
        "version": "1.0.0"
      },
      "operations": [
        "list-series",
        "inspect-series",
        "series-values",
        "compare-publishers",
        "convert-units",
        "comparability-notes",
        "boundary-query",
        "replay-query",
        "resolutions",
        "pins",
        "links",
        "series-citing"
      ],
      "semantic_constraints": {
        "definitions": "every series has a first-class definition revision (stock or flow, citizenship, country of birth or origin, application or decision, reference date or period, population base); a changed definition is a new revision and a marked break, and values stay with the revision they were published under",
        "separation": "series from different publishers, definitions or geography levels are separate records; comparability is an explicit, reviewable note and unnoted pairs are comparability_unknown",
        "vintages": "release and retrieval clocks with basis labels; revision_of by release clock; as-of selection by release cutoff with historical_vintage_unavailable; pins turn stale, never replaced",
        "geography": "codes resolve to Geospatial boundaries and places by the published code only, with code-list version and boundary vintage; other levels are listed, never aggregated or apportioned",
        "links": "acts, court decisions and dossiers by publisher reference or reviewed assertion only; keyword overlap is a discovery candidate",
        "exclusions": "no population projection, no causal claim about migration drivers or policy effect, no merged, averaged, netted, chained or apportioned value"
      }
    }
  ],
  "operations": [
