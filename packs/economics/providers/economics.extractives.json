    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "economics.extractives",
      "contract": {
        "name": "noesis-extractives-record",
        "version": "1.0.0"
      },
      "operations": [
        "list-series",
        "payments-for-company",
        "payments-for-country",
        "commodity-production",
        "series-history",
        "report-history",
        "identity-assertions",
        "company-matches",
        "links",
        "evidence-bundle",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "reports": "an EITI report is keyed by country and fiscal period; each changed summary is a new report revision with revision_of, a withdrawn summary is a revision stating the withdrawal, never a deletion; as-of answers select the revision released by the date",
        "payments": "government-reported and company-reported figures are separate lines per company, revenue stream (GFS code as reported), agency and project as reported, shown side by side with the report's own discrepancies; amounts keep the currency the report states and are never converted, summed across reports or reconciled",
        "series": "a commodity series is keyed by source, commodity and form as published, statistic, unit and country; USGS Mineral Commodity Summaries and BGS World Mineral Statistics are always different series and never blended; values live in the Economics series storage (economic_vintages, dataset_observations)",
        "vintages": "each USGS release or BGS publication that changes a series is an appended vintage recording new, revised and removed years; withheld (W), unavailable and estimated values stay marked and are never filled",
        "identity": "companies match ownership entities through reviewable candidates (published identifiers first, names as low evidence), commodities map to HS through stated HS codes or cited concordances, countries through published codes or cited code lists, projects to infrastructure assets through published identifiers or coordinates; nothing is auto-merged and unmatched records stay visible",
        "links": "public finance, trade, energy and infrastructure links rest on a citation, a shared identifier or an accepted match, point at record revisions, and report missing providers or targets as unresolved",
        "minimisation": "no natural-person field is stored or returned (contact persons excluded, natural-person entities redacted)",
        "exclusions": "no reconciliation of payment discrepancies beyond those EITI reports, no own reserve estimates, no corruption or governance risk scoring, no price forecasts, no inferred project ownership"
      }
    }
  ],
