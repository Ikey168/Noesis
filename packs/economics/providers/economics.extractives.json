{
  "contract": "noesis-provider-descriptor-v1",
  "id": "economics.extractives",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.extractives_store",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "economics.extractives",
      "contract": {
        "name": "noesis-extractives-record",
        "version": "2.0.0"
      },
      "operations": [
        "source-contracts",
        "list-series",
        "series-values",
        "production-reserves",
        "company-payments",
        "country-payments",
        "record-history",
        "evidence-bundle",
        "matches",
        "links",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "records": "EITI report, government agency, revenue stream, company, project and company payment records are immutable revisions per report version; a revised report is a new version and records it no longer states become removed revisions, never deletions",
        "series": "production, reserves, imports and exports are keyed by source, commodity, statistic, unit and country; each publication that changes values is an appended vintage in the Economics series storage, withheld, estimated and revised markers kept as published",
        "as_of": "answers select the report version or vintage published by the date and cite source, record revision and as-of time; all versions and vintages can be listed",
        "payments": "government- and company-reported figures are shown side by side with the discrepancy the EITI report publishes, in the currency as reported; currencies are never converted or summed across reports",
        "sources": "USGS and BGS series are separate series, listed side by side and never blended",
        "identity": "companies reach ownership entities only through reviewed matches (published identifiers first, names as low evidence), commodities reach HS headings only through a recorded published concordance and projects reach infrastructure only through published identifiers or coordinates; nothing is auto-merged and unmatched records stay visible",
        "links": "links to public finance, trade flows, Energy and infrastructure rest on an explicit citation, a shared published identifier or an accepted match and point at record revisions; absent providers and targets are reported, never dropped",
        "minimisation": "contact persons and beneficial owners are never stored; individual payers keep their amounts with name and identifier withheld",
        "exclusions": "no reconciliation of payment discrepancies beyond the EITI reports, no own reserve estimates, no corruption or governance risk scoring, no price forecasts"
      }
    }
  ],
  "operations": [
