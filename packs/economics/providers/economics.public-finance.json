  "contract": "noesis-provider-descriptor-v1",
  "id": "economics.public-finance",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.public_finance",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "economics.public-finance",
      "contract": {
        "name": "noesis-public-finance-record",
        "version": "1.0.0"
      },
      "operations": [
        "list-lines",
        "inspect-line",
        "compare-line",
        "line-dossier",
        "beneficiary-payments",
        "beneficiary-dossier",
        "audit-findings",
        "identity-candidates",
        "links",
        "line-place",
        "gfs-series"
      ],
      "semantic_constraints": {
        "hierarchy": "budget lines keep each source's own codes and labels (Einzelplan/Kapitel/Titel, Berlin Bereich and district, EU budget line); no cross-source hierarchy is synthesised",
        "figures": "plan, supplementary-plan, outturn and payment figures are distinct revisioned records with amount text, unit, a pint-normalised value, accounting basis and source revision; the revision in force follows the source's publication date",
        "comparisons": "a difference only between figures on the same accounting basis and currency, or under a cited reconciliation method; conflicting sources are flagged side by side, never averaged or preferred",
        "identity": "beneficiaries stay source strings; links to ownership, funding, canonical entities and procurement suppliers are reviewable, reversible identity decisions",
        "exclusions": "no fiscal forecast, no waste or fraud determination and no netting of figures across accounting bases without a cited method"
      }
    }
  ],
  "operations": [
    {
      "id": "list-lines",
      "tool": "noesis-knowledge-engine.list_budget_lines",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
