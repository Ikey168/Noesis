{
  "contract": "noesis-provider-descriptor-v1",
  "id": "economics.logistics",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.logistics_series",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "economics.logistics",
      "contract": {
        "name": "noesis-logistics-record",
        "version": "1.0.0"
      },
      "operations": [
        "list-series",
        "series-values",
        "port-as-of",
        "country-as-of",
        "route-as-of",
        "value-history",
        "freight-indices",
        "port-lookup",
        "port-matches",
        "links",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "ports": "a port record is a UN/LOCODE entry as published in one code-list release; changed entries add revisions and removed codes are marked removed, never deleted",
        "series": "a logistics series maps one published source series (concept, unit, frequency, port, country or published route geography, definition reference, licence) onto the Economics series storage; each release that changes values is an appended vintage",
        "as_of": "answers select the vintage released by the date and cite its release; all vintages of a value can be listed",
        "identity": "source port codes reach UN/LOCODE only through accepted matches: embedded UN/LOCODEs and published crosswalks are exact, name or coordinate matches are candidates until reviewed; changes and removals record a re-match",
        "links": "links to trade flows and other Economics series rest on a shared published identifier or an explicit citation; units and frequencies are listed side by side and never combined",
        "freight_indices": "only indices with an in-scope licence decision are acquired; excluded indices are reported with the reason",
        "exclusions": "no freight-rate forecasting, no derived, rebased or interpolated index, no route inferred from port totals, no merged series and no commercial index redistribution without a licence"
      }
    }
  ],
  "operations": [
    {
      "id": "list-series",
      "tool": "noesis-knowledge-engine.list_logistics_series",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "vintages",
      "required_scopes": [
        "knowledge:logistics:read"
