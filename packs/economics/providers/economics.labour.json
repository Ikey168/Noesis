      "readiness_probe": "vintages",
      "required_scopes": [
        "knowledge:labour:read",
        "knowledge:subscriptions:read"
      ],
      "required_context": []
    }
  ],
  "stores": [
    {
      "record_type": "labour-statistics-record",
      "store": "src.kb.labour_statistics",
      "tables": [
