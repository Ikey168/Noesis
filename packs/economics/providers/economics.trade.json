{
  "contract": "noesis-provider-descriptor-v1",
  "id": "economics.trade",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.trade_flows",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "economics.trade",
      "contract": {
        "name": "noesis-trade-flow-record",
        "version": "1.0.0"
      },
      "operations": [
        "list-series",
        "series-values",
        "flows-as-of",
        "mirror-comparison",
        "sanctioned-product-flows",
        "evidence-bundle",
        "product-mapping",
        "concordances",
        "identity-assertions",
        "links",
        "comparability-notes",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "series": "a trade series is keyed by reporter, partner, flow direction, product code, classification scheme and vintage, frequency, CIF/FOB basis and role; the pair reporter's report and the partner's mirror report are always separate series",
        "vintages": "each release is an appended vintage with release and retrieval clocks and revision_of; as-of answers select the vintage released by the date and cite it per figure; a revised value never overwrites an earlier vintage",
        "asymmetry": "reporter and mirror figures are shown side by side with a displayed difference; they are never reconciled, averaged or replaced by one value",
        "classifications": "a product in another classification vintage is matched only through a cited concordance (or the CN structure); 1:n, n:1 and n:n mappings are flagged non-exact and no weight is invented",
        "missing": "a pair without a reported figure is none_reported, never zero; confidential and unpublished cells carry no value",
        "links": "sanctions links rest on product codes and areas a measure cites (lookup aid); ownership links need an explicit citation; missing providers or targets are reported",
        "exclusions": "no estimation or imputation of flows, no nowcasting, no reconciliation, no re-allocation between areas, no sanctions-evasion inference or compliance determination"
      }
    }
  ],
  "operations": [
    {
      "id": "list-series",
      "tool": "noesis-knowledge-engine.list_trade_series",
      "side_effect": "read-only",
      "idempotency": {
