{
  "contract": "noesis-provider-descriptor-v1",
  "id": "clinical.surveillance",
  "version": "1.0.0",
  "description": "Public-health surveillance series of the Clinical Evidence bundle: notifiable-disease and health-indicator series with case-definition revisions, reporting and reference dates kept apart, vintages, MeSH/ICD alignment, boundary projections, explicit-citation links and user-threshold monitors. No outbreak prediction, nowcast or health advice.",
  "implementation": {
    "name": "src.kb.surveillance",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "clinical.surveillance-series",
      "contract": {
        "name": "noesis-surveillance-series",
        "version": "1.0.0"
      },
      "operations": [
        "surveillance-readiness",
        "list-series",
        "series-values",
        "definition-history",
        "expand-condition",
        "boundary-series",
        "replay-query",
        "resolutions",
        "series-links",
        "series-claims",
        "import-export",
        "align-terms",
        "resolve-geographies",
        "review-resolution",
        "link-series"
      ],
      "semantic_constraints": {
        "dates": "every value keeps reporting_date and reference_period as separate fields and lists the unknown one; as-of queries select by reporting date and list values without one apart",
        "kinds": "observation, estimate and model-output are separate series; a bounded value is an estimate, never an observation",
        "case_definitions": "first-class revisions with valid-from, valid-to, text or locator and ICD scope; a change is a marked break and earlier values are never restated",
        "sources": "sources and code systems stay side by side; nothing is merged, averaged or preferred",
        "terms": "conditions align to MeSH and ICD through the clinical term crosswalks with kinds preserved; unmapped terms are gaps",
        "geography": "codes resolve to Geospatial boundaries by the published code only, with code-list version and boundary revision; boundary changes are geography breaks, never re-aggregated",
        "links": "publications and trials by explicit dataset citation only; mentions are review candidates",
        "exclusions": "no outbreak prediction, nowcast, completeness estimate, threshold suggestion or health advice"
      }
    },
    {
      "id": "clinical.surveillance-vintages",
      "contract": {
        "name": "noesis-surveillance-vintages",
        "version": "1.0.0"
      },
      "operations": [
        "compare-vintages",
        "reporting-delay",
        "pin-status",
        "pin-vintages"
      ],
      "semantic_constraints": {
        "comparison": "differences between published vintages through the shared environment_vintages logic, both vintages cited; no cause is inferred",
        "reporting_delay": "first-reported and later values per reference period with the source's own note; incompleteness only as the source states it",
        "pins": "a pinned view reports stale when a newer vintage exists and never follows it silently"
      }
    },
    {
      "id": "clinical.surveillance-monitoring",
      "contract": {
        "name": "noesis-surveillance-monitor",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "thresholds": "user-configured only, unit-checked through pint; never derived, suggested or adjusted",
        "events": "threshold-exceeded, new-vintage, value-revised, case-definition-changed, geography-break and stale-source; replay-safe at a committed watermark",
        "schedule": "source-pack runtime schedules and the maintenance orchestrator; no new scheduler"
      }
    }
  ],
