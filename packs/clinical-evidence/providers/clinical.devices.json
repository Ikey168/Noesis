{
  "contract": "noesis-provider-descriptor-v1",
  "id": "clinical.devices",
  "version": "1.0.0",
  "description": "Medical devices of the Clinical Evidence bundle: openFDA 510(k) clearances, PMA approvals with supplements, classifications, recalls, enforcement reports and MAUDE adverse-event reports and report counts, AccessGUDID device identifiers and EUDAMED public actor, device and certificate records, each with source, record revision and as-of time; a device's regulatory history as of a date, report counts with MAUDE's caveats, reviewable identity across registries, citation links to Product safety, Medicines, trials, ownership and Products, and monitors. No safety-signal detection, causality or clinical advice.",
  "implementation": {
    "name": "src.kb.medical_devices_records",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "clinical.devices-records",
      "contract": {
        "name": "noesis-medical-device-record",
        "version": "1.0.0"
      },
      "operations": [
        "source-contracts",
        "devices-readiness",
        "regulatory-history",
        "adverse-event-report-counts",
        "record-history",
        "list-links",
        "link-records",
        "export-evidence-bundle"
      ],
      "semantic_constraints": {
        "records": "openFDA device classifications, 510(k) clearances, PMA approvals and supplements, recalls, enforcement reports, MAUDE reports and report counts, AccessGUDID device identifiers and EUDAMED public actors, devices and certificates as published, keyed by K and P numbers, supplement numbers, product codes, recall and report numbers, DIs, SRNs and certificate numbers; every record carries its source, record revision and as-of time",
        "revisions": "a changed publication is a new revision (recall status and class, supplements listed on an approval, GUDID versions, certificate status); corrections and removals are revisions, never deletions; as-of lookup by the source's own date or by observation",
        "history": "a device's clearances, approvals with supplements, recalls, device identifiers, registrations and certificates in force at a date, jurisdictions (US, EU) shown separately, each event citing its record revision; EUDAMED modules that are not acquired are stated",
        "adverse_events": "MAUDE report counts per event type and period as published, labelled as reports, never rates, incidence or causal events; MAUDE's caveats, the query window and the source revisions come with every answer",
        "links": "recalls to Product safety notices by recall number, combination products to Medicines records by a cited application number, devices to trials naming them by identifier, manufacturers to ownership and devices to Products identities through accepted matches; each link cites both revisions and its basis; absent providers and targets are reported",
        "minimisation": "the MD01 decision: contact persons, street addresses, telephone numbers, e-mail addresses and MAUDE patient blocks are never stored; MAUDE narratives only as published and returned only with knowledge:clinical:devices:narratives:read",
        "exclusions": "no safety-signal detection, no causality from adverse-event reports, no clinical advice and no patient data beyond what regulators publish"
      }
    },
    {
      "id": "clinical.devices-identity",
      "contract": {
        "name": "noesis-medical-device-identity",
        "version": "1.0.0"
      },
      "operations": [
        "propose-identity-matches",
        "review-identity-match",
        "revert-identity-match",
        "list-identity-candidates",
        "list-unmatched"
      ],
      "semantic_constraints": {
        "matching": "devices across GUDID and EUDAMED by UDI-DI and devices and Products identities by GTIN; manufacturers through accepted device matches and shared K/P numbers, then by name and country (low confidence); every candidate carries method, evidence and confidence and is proposed, reviewed or reverted in the shared ownership identity state machine; nothing is merged or auto-accepted; devices are never matched by name alone; unmatched subjects stay visible"
      }
    },
    {
      "id": "clinical.devices-monitoring",
      "contract": {
        "name": "noesis-medical-device-monitor",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "events": "new clearances, approvals, supplements, recalls, recall status and class changes, certificate status changes and GUDID versions, each citing the new and previous record revisions; adverse-event reports and counts are never notified",
        "schedule": "source-pack runtime schedules and the maintenance orchestrator; no new scheduler"
      }
    }
  ],
