{
  "contract": "noesis-provider-descriptor-v1",
  "id": "clinical.health-capacity",
  "version": "1.0.0",
  "description": "Health-system capacity of the Clinical Evidence bundle: hospital beds, health workforce and expenditure by financing scheme from WHO GHO, OECD Health Statistics (SDMX) and Eurostat as indicators with definitions, definition breaks and release vintages over the surveillance series storage; Geospatial place resolution, reviewable indicator mappings and comparability notes, surveillance co-display, cited Economics denominators, as-of answers and monitors. No rankings or quality scores.",
  "implementation": {
    "name": "src.kb.health_capacity",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "clinical.health-capacity-indicators",
      "contract": {
        "name": "noesis-health-capacity-record",
        "version": "1.0.0"
      },
      "operations": [
        "capacity-readiness",
        "list-indicators",
        "capacity-as-of",
        "definition-history",
        "beside-surveillance",
        "series-links",
        "link-economics"
      ],
      "semantic_constraints": {
        "records": "capacity indicators, definitions, definition revisions and observations composed over the surveillance series and vintage storage; source code, unit, definition as published, flags verbatim, release vintage and as-of time on every value",
        "definitions": "declared with valid-from dates and the release's retrieval time; an edition change is a marked break and earlier values are never restated",
        "as_of": "the vintage released at or before the as-of time per series; vintage differences cite both vintages",
        "sources": "WHO GHO, OECD Health Statistics and Eurostat side by side per domain; never blended, averaged or preferred; missing values are unknown",
        "links": "surveillance series shown beside capacity for the same resolved place without a combined metric; Economics series only where the publisher cites the denominator",
        "exclusions": "no health-system performance ranking or quality score and no harmonised, adjusted or re-estimated value"
      }
    },
    {
      "id": "clinical.health-capacity-alignment",
      "contract": {
        "name": "noesis-health-capacity-comparability",
        "version": "1.0.0"
      },
      "operations": [
        "comparability",
        "resolve-places",
        "review-place",
        "propose-mapping",
        "review-mapping",
        "record-note",
        "review-note"
      ],
      "semantic_constraints": {
        "places": "codes resolve to Geospatial places by the published code only; aggregates are never treated as countries; resolutions are reviewable, rejectable and revertible",
        "mappings": "equivalent, broader or narrower with evidence and both definitions cited; reviewable, rejectable and revertible",
        "notes": "comparability notes cite both definitions and their source revisions; a reverted note never reactivates an earlier one"
      }
    },
    {
      "id": "clinical.health-capacity-monitoring",
      "contract": {
        "name": "noesis-health-capacity-monitor",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "events": "new releases, revisions with old and new values and both vintages cited, definition changes as breaks and stale sources; deduplicated at committed watermarks",
        "thresholds": "user-configured only and unit-checked; the pack derives none",
        "schedule": "source-pack runtime schedules and the maintenance orchestrator; no new scheduler"
      }
    }
  ],
  "operations": [
