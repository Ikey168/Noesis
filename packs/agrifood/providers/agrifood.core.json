{
  "contract": "noesis-provider-descriptor-v1",
  "id": "agrifood.core",
  "version": "1.0.0",
  "description": "Agriculture and Food Systems: FAOSTAT, USDA NASS Quick Stats, USDA FAS PSD, Eurostat agriculture and EU Agri-food portal figures kept as release vintages with flags verbatim (numeric values in the Economics series storage); reviewable commodity crosswalks and place resolution by code; series as of a date; citation links to trade flows, climate/weather records and RASFF notices; subscription monitors. No forecasting, projection or food-security scoring.",
  "implementation": {
    "name": "src.kb.agrifood_*",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "agrifood.series",
      "contract": {
        "name": "noesis-agrifood-series",
        "version": "1.0.0"
      },
      "operations": [
        "source-contracts",
        "bundle-status",
        "acquire-sources",
        "series-as-of",
        "revision-history"
      ],
      "semantic_constraints": {
        "records": "figures as published with unit, period type, flag verbatim, release vintage and citation",
        "vintages": "a revision is a new vintage; as-of selects the vintage released at or before the time",
        "sources": "per-source series side by side; never blended, summed, forecast or imputed",
        "absence": "a commodity and place without series has none on record"
      }
    },
    {
      "id": "agrifood.crosswalks",
      "contract": {
        "name": "noesis-agrifood-crosswalk",
        "version": "1.0.0"
      },
      "operations": [
        "resolve-commodity",
        "resolve-place",
        "publish-codelists",
        "register-places",
        "propose-crosswalks",
        "propose-crosswalk-manual",
        "review-crosswalk",
        "revert-crosswalk",
        "list-crosswalks",
        "list-unmapped"
      ],
      "semantic_constraints": {
        "matching": "exact code or exact published name; other codes only through accepted crosswalks",
        "kinds": "equivalent, broader, narrower (ontology mapping kinds); differently defined commodities are never aggregated",
        "places": "exact source codes through geospatial place resolution"
      }
    },
    {
      "id": "agrifood.citations",
      "contract": {
        "name": "noesis-agrifood-link",
        "version": "1.0.0"
      },
      "operations": [
        "link-citations",
        "list-links"
      ],
      "semantic_constraints": {
        "trade": "reviewed crosswalk and place; provider_unavailable while no trade provider is composed",
        "climate_weather": "explicit place and period citation only",
        "rasff": "explicit commodity mention",
        "claims": "no causal or correlational link"
      }
    },
    {
      "id": "agrifood.monitoring",
      "contract": {
        "name": "noesis-agrifood-notification",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "schedule": "committed complete agrifood runs; no scheduler of its own",
        "events": "release, revision (old and new with both citations), linked alert; user thresholds only"
      }
    }
  ],
  "operations": [
