  "query_examples": [
    {
      "intent": "What did each source state about a CVE on a date",
      "tool": "inspect_vulnerability",
      "arguments": {
        "namespace": "global",
        "identifier": "CVE-2099-0001",
        "as_of": "2099-02-01"
      },
      "semantics": "advisory revisions per source side by side, aliases with asserting sources, ranges and their agreement, CWE, CVSS per publisher, dated EPSS and KEV listings; no verdict"
    },
    {
      "intent": "Which advisories name a package",
      "tool": "search_component_advisories",
      "arguments": {
        "namespace": "global",
        "coordinate": "pkg:pypi:fixture-parser"
      },
      "semantics": "advisories whose as-of revision names the exact coordinate or a reviewed CPE product; none found is unknown"
    },
    {
      "intent": "What did each source state about a model on a date",
      "tool": "ai_model_records_as_of",
      "arguments": {
        "namespace": "global",
        "subject": "example-org/fixture-model",
        "as_of": "2096-06-01"
      },
      "semantics": "each source's revision current at the date side by side (Hub sha, Epoch vintage), self-reported results and Epoch estimates with who reported them; never merged or ranked"
    },
    {
      "intent": "What did each source state about a declared ASN on a date",
      "tool": "internet_infrastructure_records_as_of",
      "arguments": {
        "namespace": "global",
        "resource": "AS64500",
        "as_of": "2096-01-01"
      },
      "semantics": "RIPEstat observations, the PeeringDB self-declaration and RDAP registrations side by side, each cited with source, revision and as-of time; never merged, no verdict"
    }
  ],
  "exclusions": [
    "exploitability or risk verdicts",
    "patch or remediation advice",
    "severity inferred where the source states none",
    "averaged or merged scores",
    "merged cross-source advisories",
    "model weights or dataset file downloads",
    "capability, safety, quality, risk or openness verdicts on models or datasets",
    "model or dataset leaderboards, rankings and download, like or trending counts",
    "licence-compliance interpretation of declared model or dataset licences",
    "merged self-reported results, OpenML evaluations and Epoch estimates",
    "exposed-service, port or banner data",
    "subdomain enumeration or attack-surface mapping",
    "IP-keyed or person-keyed infrastructure lookups",
    "reputation, risk, hijack or misconfiguration verdicts",
    "ranking of networks",
    "merged RIPEstat, PeeringDB and RDAP records"
  ]
}
