{
  "contract": "noesis-provider-descriptor-v1",
  "id": "science.media-metadata",
  "version": "1.0.0",
  "description": "Books, music and authority metadata beside Cultural Collections: Open Library works, editions and authors, MusicBrainz recordings, releases, works and artists (CC0 core data only), Wikidata items, GND and DNB catalogue records and Library of Congress LCNAF and catalogue records as work, edition, recording, release, creator and authority-link records keyed by source, native ID and provider revision; reviewable identity, citation-only links to cultural objects and News entity candidates, as-of answers and monitors. No full text, media content, popularity ranking or rights clearance determination.",
  "implementation": {
    "name": "src.kb.media_metadata",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "science.media-metadata",
      "contract": {
        "name": "noesis-media-metadata-record",
        "version": "1.0.0"
      },
      "operations": [
        "media-source-contracts",
        "media-status",
        "resolve-media-identifier",
        "search-media-titles",
        "media-authority-history",
        "export-media-evidence-bundle",
        "list-media-identity-matches",
        "propose-media-identity-matches",
        "review-media-identity-match",
        "revert-media-identity-match",
        "link-media-cultural-objects",
        "review-media-link",
        "assert-media-link",
        "create-media-monitor",
        "run-media-monitor",
        "poll-media-monitor"
      ],
      "semantic_constraints": {
        "levels": "work, edition (manifestation), recording, release, creator and authority-link records are distinct; a record's level is fixed at its first revision, so an edition never becomes a work",
        "revisions": "immutable revisions keyed by the provider's revision marker (Open Library revision, Wikidata revision ID, MARC 005, MusicBrainz CC0 core digest); redirects, merges and deprecations are history revisions and entity-history redirect decisions",
        "identity": "explicit identifier statements are matches citing the asserting revision; title, creator and date similarity only proposes candidates; conflicting claims stay visible; records are never merged",
        "links": "cultural objects link only through identifiers or provider relations in the object record or a reviewed assertion; keyword overlap is a candidate; links cite both revisions",
        "licences": "MusicBrainz CC0 core data only (supplementary data dropped); Open Library dumps only as named slices; DNB and Library of Congress under their documented access decisions",
        "exclusions": "no full text, audio, cover images, popularity ranking or rights clearance determination"
      }
    },
    {
      "id": "science.media-news-candidates",
      "contract": {
        "name": "noesis-media-metadata-link",
        "version": "1.0.0"
      },
      "operations": [
        "link-media-news-entities",
        "review-media-link",
        "assert-media-link"
      ],
      "semantic_constraints": {
        "news": "authority records are reviewable candidates for News canonical entities; canonical entities and aliases are only read and never re-labelled"
      }
    }
  ],
  "operations": [
