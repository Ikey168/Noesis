    {
      "id": "science.research-entities",
      "contract": {
        "name": "noesis-research-entity-record",
        "version": "1.0.0"
      },
      "operations": [
        "source-contracts",
        "readiness",
        "organisation-as-of",
        "researcher-assertions-as-of",
        "datasets-for-paper",
        "record-history",
        "identity-matches",
        "links",
        "evidence-bundle",
        "poll-monitor",
        "propose-identity-matches",
        "review-identity-match",
        "revert-identity-match",
        "build-links",
        "create-monitor",
        "run-monitor"
      ],
      "semantic_constraints": {
        "records": "organisations keyed by ROR ID (names, types, status active/inactive/withdrawn, relationships, successors and GRID/ISNI/Wikidata/FundRef identifiers per data-dump release), researchers keyed by ORCID iD, datasets keyed by DOI (metadata versions, related identifiers as published) and projects keyed by CORDIS programme and project ID (participants with PIC, VAT number, role and contributions with currency as published)",
        "revisions": "immutable revisions with the provider's revision marker, effective time and acquired release; corrections and removals by the source (not_in_release, not_found, deactivated, locked) are revisions, never deletions; as-of answers select the revision in force and cite source, record revision and as-of time",
        "minimisation": "researcher records keep only the public ORCID fields of the RE01 data-minimisation decision (iD, display name, public employments with organisation and disambiguated identifier, public works as asserted identifiers), enforced at write time; DataCite creators keep only an ORCID iD, an organisational name and affiliation identifiers; researcher answers need knowledge:research-entities:researchers and withhold names once ORCID reports a record gone",
        "identity": "ROR organisations match CORDIS participants (website domain or name in one country) and ownership entities (published identifiers first, name and jurisdiction as low evidence) through reviewable proposals with method, evidence and confidence; accept, reject and revert are entity-history decisions; nothing is merged; researchers are never matched",
        "links": "researchers link to Scholarly works only through DOIs they assert in ORCID, datasets through related identifiers as published, projects to Funding records by shared identifier and organisations to ownership entities by accepted match; links cite both revisions; missing providers and targets are reported as provider_absent or target_missing",
        "exclusions": "no researcher rankings or metrics, no inference of affiliation from co-authorship, no author disambiguation by name, no personal data beyond the minimisation decision, no contributions summed across currencies, no inferred collaboration or influence links"
      }
    }
  ],
