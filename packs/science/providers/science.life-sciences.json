    {
      "id": "science.life-sciences",
      "contract": {
        "name": "noesis-lifesci-record",
        "version": "1.0.0"
      },
      "operations": [
        "lifesci-source-contracts",
        "lifesci-readiness",
        "entry-as-of",
        "target-activities",
        "export-lifesci-evidence-bundle",
        "list-lifesci-identity-matches",
        "list-lifesci-links",
        "register-lifesci-schemas",
        "propose-lifesci-identity-matches",
        "review-lifesci-identity-match",
        "revert-lifesci-identity-match",
        "link-lifesci-records",
        "create-lifesci-monitor",
        "run-lifesci-monitor",
        "poll-lifesci-monitor"
      ],
      "semantic_constraints": {
        "records": "UniProtKB entries (accession, reviewed/unreviewed label as UniProt states it, entry and sequence version, release) and UniSave versions, NCBI genes (Gene ID) and taxa (Tax ID, rank and lineage as published), experimental RCSB PDB entries (PDB ID, methods, resolution, revision history, entity-to-UniProt mappings as stated) and ChEMBL targets, compounds, activities and documents keyed by ChEMBL ID and release; each with source, record revision and as-of time",
        "revisions": "immutable revisions; a release is a revision; merged, demerged, deleted, replaced, discontinued, merged-taxon and obsolete records are obsoleted revisions naming their successors; activities absent from a later complete release page get a removed revision; nothing is deleted",
        "values": "activity type, relation, value and unit kept as published strings (published and ChEMBL-standardised side by side) with data-validity comments; never converted, compared or aggregated across assays or assay types",
        "identity": "published cross-references first (UniProt to PDB, GeneID and ChEMBL targets; PDB entity, gene and target component accessions), ChEMBL compound to Chemicals substance by standard InChIKey and NCBI taxon to Biodiversity taxon by published Tax ID; exact names only for taxa without an identifier; every match proposed, reviewed, accepted, rejected or reverted with method, evidence and confidence; nothing merged; unmatched records listed",
        "links": "Chemicals substances and Biodiversity occurrences through accepted matches only, Clinical medicines whose regulatory records name the ChEMBL ID, and papers by exact DOI or PubMed ID; links point at record revisions; absent packs are reported, never required",
        "minimisation": "no person names or contact details: author, depositor and submitter fields are dropped at acquisition, rejected at write and absent from every answer",
        "exclusions": "no biological or clinical inference, no activity prediction, no sequence analysis beyond storage, no conversion or aggregation of values, no redistribution beyond each source's licence, no computed structure models"
      }
    }
  ],
