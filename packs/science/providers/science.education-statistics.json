{
  "contract": "noesis-provider-descriptor-v1",
  "id": "science.education-statistics",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.education_statistics",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "science.education-statistics",
      "contract": {
        "name": "noesis-education-statistic-record",
        "version": "1.0.0"
      },
      "operations": [
        "list-series",
        "series-values",
        "institution-as-of",
        "country-as-of",
        "value-vintages",
        "identity-matches",
        "links",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "records": "institution statistics keyed by the source institution id (IPEDS UNITID, ETER ID) and education indicators keyed by the published country or area code, each with indicator definition, unit and currency as published, ISCED level, reference period, release vintage and stage, and an acquisition receipt",
        "vintages": "each release is an appended vintage (an IPEDS final release supersedes the provisional one without deleting it); as-of answers select the vintage published by the date, list every vintage of a value and cite each figure",
        "identity": "ROR (src/ingestion/ror.py) is the identity backbone: identifiers published by ROR or by the source are exact matches, name and location matches are candidates that answer ROR-keyed queries only once accepted; ROR status changes, mergers and splits are reported, never re-pointed",
        "comparability": "values of different sources for one concept are shown side by side with their definitions and the publisher's qualifiers, footnotes and break flags; nothing is merged, averaged, harmonised or converted",
        "missing": "missing, not applicable, confidential and suppressed values keep the publisher's code and no number; a subject without data is none_on_record",
        "links": "Science and Funding records are linked only through confirmed ROR matches or identifiers cited in the records, never by name or keyword; linked records are not recomputed",
        "exclusions": "no university rankings, league tables, quality or composite scores and no derived per-student or per-staff ratios"
      }
    }
  ],
  "operations": [
