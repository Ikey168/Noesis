{
  "requires": [
    {
      "capability": "geospatial.feature-query",
      "contract": "noesis-geospatial-feature-query",
      "range": "^1.0.0",
      "semantic_constraints": {
        "crs": "EPSG:4326"
      },
      "reason": "places are resolved against the shared spatial store"
    },
    {
      "capability": "platform.session-artifacts",
      "contract": "noesis-intake-session-artifact",
      "range": "^1.0.0"
    },
    {
      "capability": "science.literature-claims",
      "contract": "noesis-literature-claims",
      "range": "^1.0.0"
    },
    {
      "capability": "science.math-objects",
      "contract": "noesis-math-record",
      "range": "^1.0.0",
      "reason": "the bundle's own entry points use these operations"
    }
  ],
  "contributes": {
    "capabilities": [
      {
        "id": "science.literature-claims",
        "provider": "science.literature",
        "contract": {
          "name": "noesis-literature-claims",
          "version": "1.0.0"
        }
      },
      {
        "id": "science.math-objects",
        "provider": "science.mathematics",
        "contract": {
          "name": "noesis-math-record",
          "version": "1.0.0"
        }
      },
      {
        "id": "science.cultural-objects",
        "provider": "science.cultural",
        "contract": {
          "name": "noesis-cultural-object",
          "version": "1.0.0"
        }
      },
      {
        "id": "science.media-metadata",
        "provider": "science.media-metadata",
        "contract": {
          "name": "noesis-media-metadata-record",
          "version": "1.0.0"
        }
      },
      {
        "id": "science.media-news-candidates",
        "provider": "science.media-metadata",
        "contract": {
          "name": "noesis-media-metadata-link",
          "version": "1.0.0"
        }
      }
    ],
    "providers": [
      {
        "id": "science.literature",
        "version": "1.0.0"
      },
      {
        "id": "science.mathematics",
        "version": "1.0.0"
      },
      {
        "id": "science.cultural",
        "version": "1.0.0"
      },
      {
        "id": "science.media-metadata",
        "version": "1.0.0"
      }
    ],
    "workflow_templates": [
      {
        "id": "science.place-evidence",
        "version": "1.0.0"
      }
    ],
    "profiles": [
      {
        "id": "science.place-review",
        "description": "Place-evidence literature review defaults",
        "vocabulary": {
          "place": "study site",
          "evidence": "cited finding"
        },
        "workflow_defaults": {
          "science.place-evidence": {
            "boundary_collection": "alkis_bezirke:bezirksgrenzen"
          }
        }
      }
    ],
    "source_packs": [
      {
        "pack_id": "research-discovery",
        "version": "1.4.0",
        "range": "^1.4.0"
      },
      {
        "pack_id": "primary-scientific-evidence",
        "version": "1.2.0",
        "range": "^1.1.0"
      }
    ]
  },
  "optional_features": [
    {
      "id": "cultural-collections",
      "default": false,
      "description": "Cultural collections compose Research with Geospatial place resolution",
      "requires": [
        {
          "capability": "science.cultural-objects",
          "contract": "noesis-cultural-object",
          "range": "^1.0.0",
          "reason": "the bundle's own entry points use these operations"
        },
        {
          "capability": "geospatial.place-resolution",
          "contract": "noesis-geospatial-place",
          "range": "^1.0.0"
        }
      ]
    },
    {
      "id": "media-metadata",
      "default": false,
      "description": "Books, music and authority metadata beside Cultural Collections: Open Library, MusicBrainz (CC0 core data), Wikidata, Deutsche Nationalbibliothek and Library of Congress works, editions, recordings, releases, creators and authority links with immutable provider revisions, reviewable identity, citation-only links to cultural objects, as-of answers and monitors. No full text, media content, popularity ranking or rights clearance.",
      "requires": [
        {
          "capability": "science.media-metadata",
          "contract": "noesis-media-metadata-record",
          "range": "^1.0.0",
          "reason": "the feature's own entry points use these operations"
        },
        {
          "capability": "science.cultural-objects",
          "contract": "noesis-cultural-object",
          "range": "^1.0.0",
          "reason": "cultural objects link to works and creators by identifier or provider relation"
        },
        {
          "capability": "platform.entity-identity",
          "contract": "noesis-entity-identity-decision",
          "range": "^1.0.0",
          "reason": "identity reviews and provider redirects are entity-history decisions"
        },
        {
          "capability": "platform.subscriptions",
          "contract": "noesis-knowledge-subscription",
          "range": "^1.0.0",
          "reason": "authority monitors are knowledge subscriptions"
        },
        {
          "capability": "platform.source-acquisition",
          "contract": "noesis-source-acquisition",
          "range": "^1.0.0",
          "reason": "Open Library, MusicBrainz, Wikidata, DNB and LoC sources run through the source-pack runtime"
        }
      ]
    },
    {
      "id": "media-metadata-news",
      "default": false,
      "description": "News entity resolution may use media authority records as reviewable candidates for canonical entities; only reviewed matches become links and no existing entity is re-labelled.",
      "requires": [
        {
          "capability": "science.media-news-candidates",
          "contract": "noesis-media-metadata-link",
          "range": "^1.0.0",
          "reason": "the feature's own entry points use these operations"
        },
        {
          "capability": "science.media-metadata",
          "contract": "noesis-media-metadata-record",
          "range": "^1.0.0",
          "reason": "candidates come from the authority records and their creator matches"
        },
        {
          "capability": "news.articles",
          "contract": "noesis-news-articles",
          "range": "^1.0.0",
          "reason": "News owns the canonical entities the candidates are offered to"
        },
        {
          "capability": "platform.entity-identity",
          "contract": "noesis-entity-identity-decision",
          "range": "^1.0.0",
          "reason": "reviews are entity-history decisions"
        }
      ]
    }
  ]
}
