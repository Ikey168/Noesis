      "range": "^1.0.0"
    },
    {
      "capability": "scholarly.study-replication-graph-changes",
      "range": "^1.0.0"
    },
    {
      "capability": "scholarly.paper-family-versions",
      "range": "^1.0.0"
    },
    {
