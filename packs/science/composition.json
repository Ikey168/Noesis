      "range": "^1.0.0"
    },
    {
      "capability": "patents.publications-changes",
      "range": "^1.0.0"
    }
  ],
  "contributes": {
    "profiles": [
      {
        "profile_id": "place-evidence",
        "description": "Place-related literature review",
        "vocabulary": [
          "place",
          "archive",
          "literature"
        ],
        "query_defaults": {
          "collection": "schulen:schulen",
          "boundary_collection": "alkis_bezirke:bezirksgrenzen"
        },
        "workflow_templates": [
          "science.place-evidence"
        ]
      }
    ],
    "workflow_templates": [
      {
        "contract": "noesis-workflow-template-v1",
        "template_id": "science.place-evidence",
        "version": "1.0.0",
        "owner_pack": "science",
        "description": "Review place-related evidence: find the features inside a place using the shared spatial capability, look up committed literature that mentions it, pin the document revisions behind both, and record the evidence on the research session.",
        "mode": "Deep Research",
        "profile": "place-evidence",
        "parameters": {
          "place": {
            "type": "string",
            "required": true,
            "description": "Place or district under review"
          }
        },
        "steps": [
          {
            "id": "within",
            "capability": "spatial.points-within-boundary",
            "range": "^1.0.0",
            "effect": "read-only",
            "arguments": {
              "collection": "schulen:schulen",
              "boundary_name": {
                "$param": "place"
              },
              "boundary_collection": "alkis_bezirke:bezirksgrenzen"
            }
          },
          {
            "id": "literature",
            "capability": "research.place-literature",
            "range": "^1.0.0",
            "effect": "read-only",
            "arguments": {
              "place": {
                "$param": "place"
              }
            }
          },
          {
            "id": "evidence",
            "capability": "evidence.document-references",
            "range": "^1.0.0",
            "effect": "read-only",
            "depends_on": [
              "within"
            ],
            "arguments": {
              "document_ids": {
                "$step": "within.members[].document_id"
              }
            }
          },
          {
            "id": "artifact",
            "capability": "intake.session-artifact",
            "range": "^1.0.0",
            "effect": "local-mutation",
            "depends_on": [
              "evidence",
              "literature"
            ],
            "arguments": {
              "name": "science.place-evidence",
              "content": {
                "place": {
                  "$param": "place"
                },
                "features_inside": {
                  "$step": "within.total_members"
                },
                "literature": {
                  "$step": "literature.references"
                }
              },
              "references": {
                "$step": "evidence.references"
              }
            }
          }
        ],
        "permitted_record_kinds": [
          "geospatial_feature",
          "document"
        ],
        "expected_artifacts": [
          {
            "kind": "session-artifact",
            "name": "science.place-evidence",
            "from_step": "artifact"
          }
        ]
      }
    ],
    "providers": [
      {
        "provider_id": "noesis.cultural",
        "version": "1.0.0"
      },
      {
        "provider_id": "noesis.mathematics",
        "version": "1.0.0"
      },
      {
        "provider_id": "noesis.patents",
        "version": "1.0.0"
      },
      {
        "provider_id": "noesis.research",
        "version": "1.0.0"
      },
      {
        "provider_id": "noesis.scholarly",
        "version": "1.0.0"
      }
    ]
  },
  "aliases": {
    "capability_labels": {
      "bounded-scholarly-source-acquisition": "sources.acquire",
      "cultural-object-place-projection": "cultural.cultural-object-place-projection",
      "cultural-primary-source-records": "cultural.cultural-primary-source-records",
      "formal-library-snapshots": "math.formal-library-snapshots",
      "formal-proof-dependencies": "math.formal-proof-dependencies",
      "formal-revision-comparison": "math.formal-revision-comparison",
      "math-cross-source-links": "math.math-cross-source-links",
      "math-literature-records": "math.math-literature-records",
      "math-source-objects": "math.math-source-objects",
      "oeis-sequence-records": "math.oeis-sequence-records",
      "openreview-round-comparison": "scholarly.openreview-round-comparison",
      "paper-family-versions": "scholarly.paper-family-versions",
      "preserved-citation-snapshots": "scholarly.preserved-citation-snapshots",
      "primary-source-research-links": "cultural.primary-source-research-links",
      "rights-gated-cultural-assets": "cultural.rights-gated-cultural-assets",
      "study-methodology-records": "scholarly.study-methodology-records",
      "study-replication-graph": "scholarly.study-replication-graph",
      "systematic-review-screening": "scholarly.systematic-review-screening"
    }
  }
}
