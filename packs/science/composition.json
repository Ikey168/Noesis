    },
    {
      "capability": "scholarly.preserved-citation-snapshots",
      "range": "^1.0.0"
    },
    {
      "capability": "scholarly.preserved-citation-snapshots-changes",
      "range": "^1.0.0"
    },
    {
      "capability": "cultural.cultural-primary-source-records",
      "range": "^1.0.0"
    },
