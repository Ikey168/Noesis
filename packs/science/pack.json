  "source_pack": "config/source_packs/scientific.json",
  "query_examples": [
    {
      "intent": "Studies that used a randomized design",
      "tool": "search_methodology_studies",
      "arguments": {
        "namespace": "global",
        "query": "randomized"
      },
      "semantics": "bounded search over current study-method records; not a full-text literature search"
    },
    {
      "intent": "Registration, replication, data and code links for a study",
      "tool": "get_study_replication_graph",
      "arguments": {
        "namespace": "global",
        "study_id": "<study_id>"
      },
      "semantics": "bounded registration, replication, data, code and correction links recorded for the study"
    },
    {
      "intent": "Which versions of a paper exist and which one to cite",
      "tool": "inspect_paper_family",
      "arguments": {
        "namespace": "global",
        "family_id": "<family_id>"
      },
      "semantics": "exact source versions with their access types; membership is curated, not inferred at query time"
    },
    {
      "intent": "Citation network around a paper",
      "tool": "citation_graph",
      "arguments": {
        "identifier": "<doi or paper id>",
        "depth": 1
      },
      "semantics": "citations present in the document corpus only, bounded by depth and limit"
    },
    {
      "intent": "Archival photographs of Berlin from 1900-1915",
      "tool": "search_cultural_objects",
      "arguments": {
        "namespace": "global",
        "place_id": "<place_id for Berlin>",
        "date_from": "1900",
        "date_to": "1915"
      },
      "semantics": "only provider coordinates or gazetteer-resolved place names match; undated or unplaced objects never match; rights decide link-only access"
    },
    {
      "intent": "Papers, sequences and formal declarations about Zeckendorf representations",
      "tool": "search_mathematics",
      "arguments": {
        "query": "Zeckendorf representation"
      },
      "semantics": "bounded search over acquired records; formal results pin the library commit and show explicit vs candidate links"
    },
    {
      "intent": "Which sequence starts 0, 1, 1, 2, 3, 5, 8",
      "tool": "search_mathematics",
      "arguments": {
        "query": "0, 1, 1, 2, 3, 5, 8"
      },
      "semantics": "contiguous term match over acquired OEIS entries only"
    },
    {
      "intent": "A formal theorem and what it depends on at a fixed library revision",
      "tool": "inspect_formal_declaration",
      "arguments": {
        "library": "mathlib4",
        "name": "Nat.zeckendorfEquiv",
        "commit": "b2bf051988bf69448bce88722cc09a05fea31662"
      },
      "semantics": "lexical declaration scan; module imports are explicit, statement references are lexical, not elaborated"
    },
    {
      "intent": "What changed in a formal library between two revisions",
      "tool": "compare_formal_snapshots",
      "arguments": {
        "library": "mathlib4",
        "from_commit": "<older commit>",
        "to_commit": "<newer commit>"
      },
      "semantics": "declarations added/removed/changed by statement hash; renames are candidates"
    }
  ],
  "exclusions": [
    "full-text PDF harvesting from publishers",
    "paywalled content",
    "peer-review authoring or submission",
    "automated inclusion decisions without human adjudication",
    "bibliometric impact rankings",
    "digitized-file mirroring",
    "universal OCR/transcription",
    "unreviewed semantic location resolution",
    "automatic identity between a paper theorem and a formal theorem",
    "universal formula OCR",
    "proof translation between formal systems",
    "unrestricted repository mirroring",
    "licensed MathSciNet access"
  ]
}
