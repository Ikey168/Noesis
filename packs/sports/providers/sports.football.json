{
  "contract": "noesis-provider-descriptor-v1",
  "id": "sports.football",
  "version": "1.0.0",
  "description": "Sports records (src.kb.sports_store): competitions, seasons, fixtures with reschedule history, result revisions with corrections, forfeits and annulments, lineups, stated table rules, deductions and published tables, and transfers from open announcements; tables as of a date (src.kb.sports_queries), reviewable identity (src.kb.sports_identity), news links (src.kb.sports_links) and subscription monitors (src.kb.sports_monitoring).",
  "implementation": {
    "name": "src.kb.sports_store",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "sports.records",
      "contract": {
        "name": "noesis-sports-record",
        "version": "1.0.0"
      },
      "operations": [
        "readiness",
        "standings-as-of",
        "match-history",
        "fixture-history",
        "team-schedule",
        "player-appearances",
        "transfers",
        "export-records",
        "identity-candidates",
        "venue-place",
        "news-links",
        "poll-monitor",
        "propose-identity-matches",
        "review-identity-match",
        "revert-identity-match",
        "club-lineage",
        "link-venue-place",
        "record-decision",
        "record-table-rule",
        "record-transfer",
        "refresh-news-links",
        "review-news-link",
        "revert-news-link",
        "create-monitor",
        "run-monitor"
      ],
      "semantic_constraints": {
        "revisions": "every correction, forfeit, award or annulment appends a revision; current is chosen per source by the source's own date; unchanged re-acquisition adds nothing",
        "tables": "replayed only from results published by the knowledge cutoff under the stated rule and deductions, always compared with the source-published table; disagreements are shown, never resolved",
        "identity": "players, teams, competitions and venues link only by reviewable, reversible decisions; club renames, mergers and phoenix clubs are identity-history events",
        "exclusions": "no odds, betting advice, predictions, medical or biometric data; published participants only"
      }
    }
  ],
