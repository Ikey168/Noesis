{
  "contract": "noesis-provider-descriptor-v1",
  "id": "funding.development-finance",
  "version": "1.0.0",
  "description": "Development finance and aid activity data of the Funding & Grants bundle: IATI activities with publishers, transactions, participating organisations, allocations, results and version history; OECD CRS aggregates as vintaged statistics through the SDMX connector; World Bank projects linked by stated identifiers; normalised codes, places and cited currency conversions beside reported values; reviewable organisation identity with an open-call cross-reference; and monitors on the subscription outbox. No effectiveness or impact judgement and no total across publishers.",
  "implementation": {
    "name": "src.kb.development_finance",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "funding.development-finance-activities",
      "contract": {
        "name": "noesis-development-finance-record",
        "version": "1.0.0"
      },
      "operations": [
        "source-contracts",
        "readiness",
        "acquire-iati",
        "acquire-world-bank",
        "list-activities",
        "inspect-activity",
        "search-transactions",
        "publisher-coverage",
        "crs-aggregates",
        "world-bank-links",
        "publish-codelists",
        "normalise",
        "resolve-places",
        "review-place",
        "convert-amount",
        "record-answer",
        "attach-answer",
        "report-citation"
      ],
      "semantic_constraints": {
        "publishers": "a publisher is its own record; the same IATI identifier from two publishers stays two activities side by side; publishers are never merged",
        "revisions": "a changed activity is a new revision chosen by the publisher's last-updated-datetime; late older versions are history; unchanged re-acquisition adds nothing",
        "amounts": "transactions keep value, currency, value date and type as reported; unknown stays unknown; no total across publishers; within-publisher totals state type, currency and value-date range",
        "statistics": "OECD CRS aggregates are vintaged statistics with the OECD as publisher, never decomposed into activities or summed with IATI transactions",
        "world_bank": "a World Bank project links to an IATI activity only through a stated identifier; similarity is a marked candidate",
        "currency": "a conversion needs a cited rate, rate date and source and is stored beside the unchanged original",
        "coverage": "per-publisher coverage is bounded to explicit selections; failures are stale coverage, never ended activities",
        "exclusions": "no effectiveness or impact judgement"
      }
    },
    {
      "id": "funding.development-finance-identity",
      "contract": {
        "name": "noesis-development-finance-identity",
        "version": "1.0.0"
      },
      "operations": [
        "propose-identity",
        "identity-candidates",
        "review-identity",
        "revert-identity",
        "open-calls"
      ],
      "semantic_constraints": {
        "decisions": "organisations are offered to ownership, publisher, canonical and funder records from stated evidence; nothing is linked automatically; reviews and reverts are entity identity decisions",
        "calls": "open calls are a cross-reference to funding opportunities, never activities, transactions or commitments; no eligibility is inferred"
      }
    },
    {
      "id": "funding.development-finance-monitoring",
      "contract": {
        "name": "noesis-development-finance-monitor",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "delivery": "existing subscription outbox",
        "events": "new activity, new or corrected transaction, withdrawn activity, new result posting, new CRS vintage and coverage change, each citing before and after",
        "failures": "a failed or partial refresh is stale coverage, never a closed or ended activity"
      }
    }
  ],
