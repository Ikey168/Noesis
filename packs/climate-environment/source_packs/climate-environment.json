{
  "pack_id": "climate-environment",
  "version": "1.0.0",
  "description": "Climate and Environment sources for one bounded Berlin selection: OpenAQ and Umweltbundesamt air quality, ENTSO-E and SMARD grid records for DE-LU, EEA industrial facilities, EU ETS installations, Open-Meteo reanalysis and forecasts, and DWD station observations. Berlin Umweltatlas layers are delivered as the geospatial-berlin 1.2.0 upgrade. Every source is live-unverified until a dated run; Copernicus/CAMS is not implemented.",
  "domains": [
    "environment"
  ],
  "defaults": {
    "connector": "environment",
    "temporal_semantics": "provider observation, model or forecast periods as published; kind is explicit per series; acquisition time and provider release time recorded separately as vintages",
    "mapping": {
      "target_schema": "noesis-environment-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "environment-providers:1.0.0"
    ],
    "operations": [
      "observe"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 86400
    },
    "auth": {
      "kind": "none"
    },
    "budgets": {
      "timeout_ms": 60000,
      "max_results": 500,
      "max_bytes": 20000000,
      "max_pages": 40
    },
    "health": {
      "required": false,
      "max_staleness_s": 259200
    }
  },
  "sources": [
    {
      "source_id": "openaq-berlin-mitte",
      "endpoint": "https://api.openaq.org/v3",
      "publisher": "OpenAQ",
      "scope": "OpenAQ location 2993 (EEA station DEBE068, Berlin Mitte) and its NO2/PM10 sensors, hourly aggregates for one pinned window",
      "update_cadence": "hourly",
      "auth": {
        "kind": "required-secret",
        "secret_ref": "NOESIS_OPENAQ_API_KEY"
      },
      "license": {
        "id": "openaq-terms-per-location-licence",
        "terms_url": "https://openaq.org/terms",
        "redistribution": "per location licence (CC BY 4.0 for EEA data); attribution required"
      },
      "environment": {
        "provider": "openaq",
        "namespace": "environment",
        "live_verification": "blocked",
        "selection": {
          "locations": [
            "2993"
          ],
          "sensors": [
            "7771",
            "7772"
          ],
          "datetime_from": "2026-09-24T00:00:00Z",
          "datetime_to": "2026-09-24T04:00:00Z",
          "limit": 100
        }
      },
      "fixture": {
        "path": "tests/fixtures/source_packs/environment-openaq.json",
        "sha256": "69e36576157b3c74d28de8238bb0de851aaa8306b4c7c60e3e2584ca09940738",
        "expected_output_hash": "d07f2645981fe4a6352cc8bb835bfad0e5dc675b92b5f7f3ee03b1f0705fe3f1"
      }
    },
    {
      "source_id": "uba-berlin",
      "endpoint": "https://www.umweltbundesamt.de/api/air_data/v3",
      "publisher": "Umweltbundesamt",
      "scope": "UBA stations 282 (DEBE068 Berlin Mitte) and 271 (DEBE065 Frankfurter Allee), NO2 hourly means for one pinned window; values declared provisional",
      "update_cadence": "hourly",
      "license": {
        "id": "dl-de-by-2.0",
        "terms_url": "https://www.govdata.de/dl-de/by-2-0",
        "redistribution": "permitted with attribution 'Umweltbundesamt'"
      },
      "environment": {
        "provider": "uba",
        "namespace": "environment",
        "live_verification": "blocked",
        "selection": {
          "stations": [
            "282",
            "271"
          ],
          "components": [
            "5"
          ],
          "scope": 2,
          "date_from": "2026-09-24",
          "time_from": 1,
          "date_to": "2026-09-24",
          "time_to": 4,
          "data_status": "provisional"
        }
      },
      "fixture": {
        "path": "tests/fixtures/source_packs/environment-uba.json",
