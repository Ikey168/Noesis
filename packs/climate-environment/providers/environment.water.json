{
  "contract": "noesis-provider-descriptor-v1",
  "id": "environment.water",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.water_store",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "environment.water-records",
      "contract": {
        "name": "noesis-water-record",
        "version": "2.0.0"
      },
      "operations": [
        "source-contracts",
        "readiness",
        "register-schemas",
        "lookup-station",
        "value-at",
        "series",
        "place-water",
        "status-history",
        "link-records",
        "list-links",
        "export-bundle"
      ],
      "semantic_constraints": {
        "records": "stations (native id and number, river, location and gauge-zero/datum vintages, published characteristic values), observations (parameter, unit, time, value, quality state and qualifiers as published), WFD water bodies and their status per reporting cycle are statements as published with source, record revision and retrieval time; nothing is overwritten or deleted, and removals by the source are tombstone revisions",
        "quality": "provisional and approved are stated per value as published; a provisional value replaced by an approved one is a new revision, and as-of answers return the value on record at the date with later revisions listed",
        "missing": "values a source did not publish stay missing; no interpolation, resampling or gap filling",
        "containment": "place answers use accepted identity matches or containment in the stated geometry version",
        "links": "hazard, weather and infrastructure links only by citation, shared identifier or accepted match; absent providers degrade to an unavailable report; no proximity or causal links",
        "minimisation": "no personal data: contact, e-mail, phone, person and observer fields are rejected at write time and refused in answers",
        "exclusions": "no flood forecasting, no interpolation or gap filling, no own water-body status assessment or merged cycles, no flood-risk scoring"
      }
    },
    {
      "id": "environment.water-identity",
      "contract": {
        "name": "noesis-water-identity-match",
        "version": "1.0.0"
      },
      "operations": [
        "propose-identity",
        "review-identity",
        "undo-identity",
        "list-identity"
      ],
      "semantic_constraints": {
        "identity": "stations and water bodies connect to places and rivers only through reviewed proposals; published river identifiers and EU codes before names; coordinates and water-body geometry only as published, with geospatial contains receipts naming the geometry version; nothing is merged or accepted automatically; unmatched records stay listed"
      }
    },
    {
      "id": "environment.water-monitoring",
      "contract": {
        "name": "noesis-water-notification",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "monitoring": "station, river and water-body watches on platform.subscriptions evaluated at complete source-pack watermarks; new values above published characteristic values, revised or withdrawn values, station changes and new or corrected reporting cycles cite prior and new revisions and state what changed; unchanged data emits nothing"
      }
    }
  ],
  "operations": [
    {
      "id": "source-contracts",
      "tool": "noesis-knowledge-engine.water_source_contracts",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "revisions",
      "required_scopes": [],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "readiness",
      "tool": "noesis-knowledge-engine.water_readiness",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "revisions",
      "required_scopes": [
        "knowledge:environment:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "register-schemas",
      "tool": "noesis-knowledge-engine.register_water_schemas",
      "side_effect": "local-mutation",
      "idempotency": {
        "supported": true,
        "key": "schema name + version"
      },
      "readiness_probe": "revisions",
      "required_scopes": [
        "knowledge:environment:write",
        "knowledge:schema:register"
      ],
      "required_context": [
        "namespace",
        "principal"
      ]
    },
    {
