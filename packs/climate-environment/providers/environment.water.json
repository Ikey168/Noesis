{
  "contract": "noesis-provider-descriptor-v1",
  "id": "environment.water",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.water_store",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "environment.water-records",
      "contract": {
        "name": "noesis-water-record",
        "version": "1.0.0"
      },
      "operations": [
        "source-contracts",
        "readiness",
        "register-schemas",
        "value-at",
        "series",
        "station-history",
        "for-place",
        "status-history",
        "link-records",
        "list-links",
        "export-bundle"
      ],
      "semantic_constraints": {
        "records": "stations, observations, water bodies and WFD assessments are statements as published with source, record revision and as-of (retrieval) time; removals and corrections are revisions, never deletions",
        "stations": "keyed by PEGELONLINE station UUID and number or USGS monitoring_location_id; location, gauge zero or vertical datum (with the validity the source states) and published characteristic values change only by new revisions",
        "observations": "parameter, unit, time and value as published, never resampled; quality state provisional or approved (or unknown) with the source's wording and per-value qualifiers; a provisional value replaced by an approved one is a new revision",
        "assessments": "WFD ecological and chemical status elements per EU water-body code and reporting cycle as published; cycles are never merged",
        "answers": "value at a station and time as known at an as-of time with later revisions; missing periods stay missing; place answers state the geometry version used; every item cites its record revision",
        "minimisation": "no personal data: personal fields are rejected at write time and removed from outputs",
        "exclusions": "no flood forecasting, no interpolation or gap filling, no own status assessments, no flood-risk scoring, no causal links between observations and events"
      }
    },
    {
      "id": "environment.water-identity",
      "contract": {
        "name": "noesis-water-identity-match",
        "version": "1.0.0"
      },
      "operations": [
        "propose-identity",
        "review-identity",
        "undo-identity",
        "list-identity"
      ],
      "semantic_constraints": {
        "identity": "stations match places and rivers through reviewed proposals from published identifiers first, then published coordinates, then river names (lower-evidence); water bodies map to places only through published geometries; every match carries method, evidence and confidence and is proposed, accepted, rejected or reverted; nothing is auto-merged; unmatched records stay visible"
      }
    },
    {
      "id": "environment.water-monitoring",
      "contract": {
        "name": "noesis-water-notification",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "monitoring": "station, river and water-body watches on platform.subscriptions evaluated at complete source-pack watermarks; observations above a station's published characteristic values, observation and station revisions and new assessment cycles cite the new and prior revisions and state what changed; unchanged data emits nothing; notices are record changes, not warnings or assessments"
      }
    }
  ],
