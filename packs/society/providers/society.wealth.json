      ]
    },
    {
      "id": "record-comparability-note",
      "tool": "noesis-knowledge-engine.record_wealth_comparability",
      "side_effect": "local-mutation",
      "idempotency": {
        "supported": true,
        "key": "series + relation + statement"
      },
      "readiness_probe": "series",
      "required_scopes": [
        "knowledge:wealth:write"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "review-comparability-note",
      "tool": "noesis-knowledge-engine.review_wealth_comparability",
      "side_effect": "local-mutation",
      "idempotency": {
        "supported": true,
        "key": "note_id + state"
      },
      "readiness_probe": "series",
      "required_scopes": [
        "knowledge:wealth:review"
      ],
      "required_context": [
        "namespace"
      ]
    }
  ],
  "stores": [
    {
      "record_type": "wealth-distribution-record",
      "store": "src.kb.wealth_distribution_store",
      "tables": [
        "wealth_releases",
        "wealth_series",
        "wealth_definitions",
        "wealth_vintages",
        "wealth_observations",
        "wealth_release_members",
