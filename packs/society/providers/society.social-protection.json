  "capabilities": [
    {
      "id": "society.social-protection-series",
      "contract": {
        "name": "noesis-social-protection-record",
        "version": "2.0.0"
      },
      "operations": [
        "source-contracts",
        "readiness",
        "list-series",
        "indicator-for-place",
        "series-history",
        "comparability-notes",
        "profile",
        "export-profile",
        "register-schemas",
        "record-comparability-note",
        "review-comparability-note"
      ],
      "semantic_constraints": {
        "series": "keyed by source, dataset or dataflow, measure (expenditure, beneficiaries or coverage), the publisher's own classification (ESSPROS spfunc or pension category, SOCX policy area, ILO contingency), scheme or benefit type, financing, cash or in kind, gross or net basis, sex, unit as published, place and frequency; ILO's population denominator per series; values also in the Economics series storage (economic_vintages, dataset_observations; domain society)",
        "definitions": "the ESSPROS manual edition, the SOCX methodology and ILO NOTE_SOURCE, NOTE_INDICATOR and NOTE_CLASSIF (verbatim) are definition revisions; a changed definition is a new revision",
        "vintages": "each changed release is an appended vintage with release and retrieval clocks (Eurostat LAST UPDATE, a declared OECD or ILO release date or the labelled retrieval time); a restating World Social Protection Report edition is a new vintage; a series a complete later release no longer states gets a removed_by_source vintage; as-of answers select the vintage released by the date",
        "values": "stored as published, never recomputed; OECD estimates and projections keep that status and are never final; flags b, p, e, d and c verbatim and c is a status, never a value",
        "comparability": "expenditure, beneficiary counts and coverage are never presented as measuring the same thing; ESSPROS, SOCX and ILO rows are side by side and never combined; ESSPROS-SOCX scope notes, breaks, manual edition changes and restatements are source-stated notes; pairs without notes are comparability_unknown",
        "minimisation": "published aggregates only; person- and household-level fields, registers, microdata and Social Security Inquiry returns refused at write time",
        "exclusions": "no nowcasting, no filled years, no blending of ESSPROS, SOCX and ILO figures, no re-classification of one publisher's functions into another's, no combination with COFOG, no per-capita, per-beneficiary or share-of-GDP figure of our own, no derived indicators, no forecasts"
      }
    },
    {
      "id": "society.social-protection-identity",
      "contract": {
        "name": "noesis-social-protection-identity-assertion",
        "version": "1.0.0"
      },
      "operations": [
        "propose-place-matches",
        "propose-function-relations",
        "record-function-relation",
        "review-identity",
        "revert-identity",
        "list-identity"
      ],
      "semantic_constraints": {
        "identity": "places match through reviewed assertions on published ISO codes before names (the Geospatial place identity society.income uses); a function, branch or contingency may be recorded as related to another publisher's, never re-classified or merged; COFOG stays a distinct concept; nothing auto-accepted; unmatched records stay visible"
      }
    },
    {
      "id": "society.social-protection-links",
      "contract": {
        "name": "noesis-social-protection-link",
        "version": "1.0.0"
      },
      "operations": [
        "link-series",
        "list-links"
      ],
      "semantic_constraints": {
        "links": "Demographics population denominators and COFOG social-protection expenditure (gov_10a_exp, GF10) in Public finance by shared published code or accepted match; both revisions pinned; no ratio or share computed; provider_absent and target_not_held reported"
      }
    },
    {
      "id": "society.social-protection-monitoring",
      "contract": {
        "name": "noesis-social-protection-monitor",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "delivery": "knowledge subscriptions and source-pack watermarks; no new scheduler; notices are record changes, not assessments; a failed run never produces a removal notice"
      }
    }
  ],
