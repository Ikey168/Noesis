{
  "contract": "noesis-provider-descriptor-v1",
  "id": "society.income",
  "version": "1.0.0",
  "implementation": {
    "name": "src.kb.income_distribution_*",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "society.income-series",
      "contract": {
        "name": "noesis-income-distribution-record",
        "version": "1.0.0"
      },
      "operations": [
        "bundle-status",
        "source-contracts",
        "acquire-source",
        "register-schemas",
        "list-series",
        "indicator-for-place",
        "series-history",
        "profile",
        "export-profile",
        "record-comparability-note",
        "review-comparability-note"
      ],
      "semantic_constraints": {
        "series": "keyed by source, indicator, welfare concept (income, consumption or a source's mixed regional aggregate), equivalence scale, poverty line and its PPP base year, place, coverage, survey, income definition and methodology; values also in the Economics series storage (domain society)",
        "vintages": "each release that changes a series is an appended vintage with release and retrieval clocks; a PPP revision is a new vintage, never an overwrite; a source removal is a vintage, never a deletion; as-of answers select the vintage released by the date",
        "comparability": "sources, lines, PPP rounds and welfare concepts are separate series shown side by side and never combined; pairs of vintages without notes are comparability_unknown",
        "minimisation": "aggregate statistics only; person- and household-level fields refused at write time",
        "exclusions": "no nowcasting, no filled years, no own poverty lines, no blending of PIP, EU-SILC and OECD figures, no re-harmonisation of welfare concepts, no derived indicators"
      }
    },
    {
      "id": "society.income-identity",
      "contract": {
        "name": "noesis-income-identity-assertion",
        "version": "1.0.0"
      },
      "operations": [
        "propose-place-matches",
        "propose-related-indicators",
        "review-identity",
        "revert-identity",
        "list-identity"
      ],
      "semantic_constraints": {
        "identity": "places match through reviewed assertions on published identifiers (ISO, NUTS, World Bank regions); the same indicator across sources is related, never merged; nothing auto-accepted"
      }
    },
    {
      "id": "society.income-links",
      "contract": {
        "name": "noesis-income-link",
        "version": "1.0.0"
      },
      "operations": [
        "link-series",
        "list-links"
      ],
      "semantic_constraints": {
        "links": "methodology documents by exact URL, Demographics denominators and Labour series by shared identifier or accepted match; both revisions pinned; missing providers and targets reported"
      }
    },
    {
      "id": "society.income-monitoring",
      "contract": {
        "name": "noesis-income-monitor",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "delivery": "knowledge subscriptions and source-pack watermarks; no new scheduler; notices are record changes, not assessments"
      }
    }
  ],
