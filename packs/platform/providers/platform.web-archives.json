        "citation_health_checks",
        "web_archive_captures",
        "web_archive_timemaps",
        "web_archive_matches",
        "citation_pins"
      ],
      "revision_addressable": true,
      "namespace_scoped": true
    }
  ],
  "readiness_probes": [
