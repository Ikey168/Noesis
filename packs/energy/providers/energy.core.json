{
 "contract": "noesis-provider-descriptor-v1",
 "id": "energy.core",
 "version": "1.0.0",
 "description": "Energy Systems: generation by fuel, load, day-ahead prices, installed capacity (zone and plant/unit), cross-border flows and energy balances as published with release vintages (src.kb.energy_store), bounded receipted acquisition reusing the environment entsoe adapter and the SDMX connector (src.ingestion.energy_sources), reviewable identity (src.kb.energy_identity), citation-only links (src.kb.energy_links), as-of queries (src.kb.energy_queries) and subscription monitors (src.kb.energy_monitoring).",
 "implementation": {
  "name": "src.kb.energy_*",
  "version": "1.0.0",
  "server": "noesis-knowledge-engine"
 },
 "capabilities": [
  {
   "id": "energy.records",
   "contract": {
    "name": "noesis-energy-record",
    "version": "1.0.0"
   },
   "operations": [
    "source-contracts",
    "bundle-status",
    "acquire-source",
    "register-schemas",
    "list-series",
    "publish-prices-to-market"
   ],
   "semantic_constraints": {
    "vintages": "every release is a vintage; provisional and revised figures are distinct and never overwritten",
    "kinds": "observations only; forecasts refused",
    "units": "published unit kept; no conversion, gap-filling or cross-source blending",
    "prices": "written through market storage (noesis-market-bar-v1); negative prices listed as refused",
    "coverage": "explicit bounded selections per provider (docs/roadmaps/energy-systems-source-audit.md)"
   }
  },
  {
   "id": "energy.queries",
   "contract": {
    "name": "noesis-energy-answer",
    "version": "1.0.0"
   },
   "operations": [
    "generation-mix",
    "observations",
    "revision-history",
    "capacity-as-of"
   ],
   "semantic_constraints": {
    "as_of": "the vintage published at or before the as-of time (release date, else retrieval time, labelled)",
    "sources": "side by side per provider and dataset; never blended",
    "unknowns": "capacity without a covering published value is unknown; subjects without records say so"
   }
  },
  {
   "id": "energy.identity",
   "contract": {
    "name": "noesis-energy-identity-match",
    "version": "1.0.0"
   },
   "operations": [
    "propose-identity",
    "review-identity",
    "list-identity"
   ],
   "semantic_constraints": {
    "review": "candidates only; accepted by a principal other than the proposer; reject and revert recorded",
    "owners": "places through geospatial.place-resolution, plants through canonical_entities and entity history"
   }
  },
  {
   "id": "energy.links",
   "contract": {
    "name": "noesis-energy-link",
    "version": "1.0.0"
   },
   "operations": [
    "link-records",
    "link-facility",
    "list-links"
   ],
   "semantic_constraints": {
    "basis": "shared identifier or explicit citation with source and locator; never name similarity, co-location or correlation",
    "facilities": "only through an accepted identity match"
   }
  },
  {
   "id": "energy.monitoring",
   "contract": {
    "name": "noesis-energy-monitor",
    "version": "1.0.0"
   },
   "operations": [
    "create-monitor",
    "run-monitor",
    "poll-monitor"
   ],
   "semantic_constraints": {
    "schedule": "committed watermarks from source-pack runs / maintenance orchestrator; no scheduler",
    "thresholds": "user-configured only; the pack derives none"
   }
  }
 ],
 "operations": [
  {
   "id": "source-contracts",
   "tool": "noesis-knowledge-engine.energy_source_contracts",
   "side_effect": "read-only",
   "idempotency": {
    "supported": true
   },
   "readiness_probe": "records",
   "required_scopes": [],
   "required_context": [
    "namespace"
   ]
  },
  {
   "id": "bundle-status",
