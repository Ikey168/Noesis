  "optional_features": [
    {
      "id": "sanctions",
      "default": false,
      "description": "Sanctions citations: a vessel links to a Legal sanctions designation only when the designation states the same IMO number, citing the listing revision; a shared name is a candidate only. Without the feature the link step reports provider_unavailable.",
      "requires": [
        {
          "capability": "legal.sanctions",
          "contract": "noesis-sanctions-record",
          "range": "^1.0.0",
          "reason": "designations stating an IMO number are read from the Legal sanctions owner"
        }
      ]
    },
    {
      "id": "geospatial",
      "default": false,
      "description": "Fishing areas as places: published FAO major area, RFMO convention area and EEZ codes and published GFW grid cells are registered as geospatial places by their codes and linked; no geometry is guessed from free text.",
      "requires": [
        {
          "capability": "geospatial.place-resolution",
          "contract": "noesis-geospatial-place",
          "range": "^1.0.0",
          "reason": "area codes and grid cells are registered and resolved as geospatial places"
        }
      ]
    }
  ]
