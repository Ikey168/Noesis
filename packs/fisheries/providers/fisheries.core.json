{
  "contract": "noesis-provider-descriptor-v1",
  "id": "fisheries.core",
  "version": "1.0.0",
  "description": "Fisheries and Maritime Activity: GFW vessel identity and effort aggregates, FAO FishStat catch statistics, RFMO authorised-vessel registers and IUU lists and the Combined IUU Vessel List kept as immutable revisions of dated snapshots and releases; reviewable vessel identity; vessel status as of a date; effort and catch side by side; citation links to sanctions, geospatial areas and citing providers; subscription monitors. No illegal-fishing inference, legality status or enforcement recommendation.",
  "implementation": {
    "name": "src.kb.fisheries_*",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "fisheries.records",
      "contract": {
        "name": "noesis-fisheries-record",
        "version": "1.0.0"
      },
      "operations": [
        "source-contracts",
        "bundle-status",
        "acquire-sources",
        "vessel-status",
        "area-aggregates"
      ],
      "semantic_constraints": {
        "records": "values quoted as published with locator; every distinct payload is an immutable revision",
        "snapshots": "register and list pages are dated snapshots with retrieval time; absence from a later snapshot of the same selection is a dated removal, never a deletion",
        "effort": "GFW apparent fishing effort aggregates only; never confirmed fishing, never per-vessel tracks",
        "answers": "effort and catch side by side, never combined; unpublished cells are not zero; a vessel without records has none on record in the covered registers, never legal or compliant",
        "exclusions": "no illegal-fishing inference, legality status or enforcement recommendation"
      }
    },
    {
      "id": "fisheries.identity",
      "contract": {
        "name": "noesis-fisheries-identity",
        "version": "1.0.0"
      },
      "operations": [
        "vessel-identity",
        "propose-identities",
        "review-identity",
        "revert-identity",
        "list-matches"
      ],
      "semantic_constraints": {
        "matching": "IMO (check digit verified) recorded with evidence; name, flag or call-sign only is a review candidate; different IMO numbers never proposed",
        "review": "accept/reject are entity identity decisions; revert appends an undo; nothing merged",
        "history": "renames and re-flagging are a time-bounded identity history over dated revisions"
      }
    },
    {
      "id": "fisheries.citations",
      "contract": {
        "name": "noesis-fisheries-link",
        "version": "1.0.0"
      },
      "operations": [
        "link-citations",
        "project-areas",
        "list-links"
      ],
      "semantic_constraints": {
        "sanctions": "an IMO number the designation states, citing its revision; a name alone is a candidate only",
        "areas": "published area codes and grid cells; no geometry guessed from free text",
        "citing_providers": "OSINT movements and Agriculture & Food Systems by explicit IMO/ASFIS/FAO-area citation; provider_unavailable when not composed"
      }
    },
    {
      "id": "fisheries.monitoring",
      "contract": {
        "name": "noesis-fisheries-notification",
        "version": "1.0.0"
      },
      "operations": [
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "schedule": "committed complete fisheries-maritime runs; no scheduler of its own",
        "events": "dated authorisation, listing, delisting, removal and release events citing prior and new revisions"
      }
    }
  ],
  "operations": [
    {
      "id": "source-contracts",
      "tool": "noesis-knowledge-engine.fisheries_source_contracts",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "revisions",
      "required_scopes": [],
      "required_context": []
    },
    {
      "id": "bundle-status",
      "tool": "noesis-knowledge-engine.fisheries_bundle_status",
      "side_effect": "read-only",
      "idempotency": {
        "supported": true
      },
      "readiness_probe": "revisions",
      "required_scopes": [
        "knowledge:fisheries:read"
      ],
      "required_context": [
        "namespace"
      ]
    },
    {
      "id": "acquire-sources",
      "tool": "noesis-knowledge-engine.acquire_fisheries_sources",
      "side_effect": "acquisition",
      "idempotency": {
        "supported": true,
        "key": "run_key (source-pack run receipt)"
      },
      "readiness_probe": "revisions",
      "required_scopes": [
        "knowledge:fisheries:write",
        "knowledge:ingestion:execute"
      ],
      "required_context": [
        "namespace",
        "network",
        "source_terms",
        "credentials"
      ]
    },
    {
      "id": "vessel-status",
