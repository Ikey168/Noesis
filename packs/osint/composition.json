{
  "requires": [
    {
      "capability": "geospatial.feature-query",
      "contract": "noesis-geospatial-feature-query",
      "range": "^1.0.0",
      "semantic_constraints": {
        "crs": "EPSG:4326"
      },
      "reason": "places are resolved against the shared spatial store"
    },
    {
      "capability": "platform.session-artifacts",
      "contract": "noesis-intake-session-artifact",
      "range": "^1.0.0"
    },
    {
      "capability": "osint.corroboration",
      "contract": "noesis-osint-corroboration",
      "range": "^1.0.0"
    }
  ],
  "optional_features": [
    {
      "id": "acquisition",
      "default": true,
      "description": "Refresh source features before investigating",
      "requires": [
        {
          "capability": "platform.source-acquisition",
          "contract": "noesis-source-acquisition",
          "range": "^1.0.0"
        }
      ]
    },
    {
      "id": "imagery",
      "default": false,
      "description": "Review-gated imagery provenance",
      "requires": [
        {
          "capability": "osint.media-provenance",
          "contract": "noesis-media-provenance",
          "range": "^1.0.0"
        }
      ]
    },
    {
      "id": "ownership",
      "default": false,
      "description": "Cited Corporate Ownership section in entity_dossier for organization entities; inert unless the Corporate Ownership bundle is enabled in the namespace",
      "requires": [
        {
          "capability": "ownership.graph",
          "contract": "noesis-ownership-graph",
          "range": "^1.0.0"
        },
        {
          "capability": "ownership.dossier",
          "contract": "noesis-ownership-dossier",
          "range": "^1.0.0"
        }
      ]
    },
    {
      "id": "designations",
      "default": false,
      "description": "Cited per-list sanctions designation statements in entity_dossier through the Legal bundle's sanctions feature; inert unless that feature is enabled in the namespace. List statements only, never a screening verdict or compliance determination",
      "requires": [
        {
          "capability": "legal.sanctions",
          "contract": "noesis-sanctions-record",
          "range": "^1.0.0",
          "reason": "the section composes the Legal sanctions record owner's as-of statements"
        }
      ]
    },
    {
      "id": "onchain",
      "default": false,
      "description": "Cited contract-origin facts (deployer, creation transaction, first funding) in entity_dossier for organization entities, reached only through accepted On-chain label references; never for persons and never an attribution of an address",
      "requires": [
        {
          "capability": "onchain.observations",
          "contract": "noesis-onchain-observation",
          "range": "^1.0.0",
          "reason": "the section composes the On-chain Observations record owner's cited contract-origin answers"
        }
      ]
    }
  ],
  "contributes": {
    "capabilities": [
      {
        "id": "osint.corroboration",
        "provider": "osint.core",
        "contract": {
          "name": "noesis-osint-corroboration",
          "version": "1.1.0"
        }
      },
      {
        "id": "osint.media-provenance",
        "provider": "osint.core",
        "contract": {
          "name": "noesis-media-provenance",
          "version": "1.0.0"
        }
      },
      {
        "id": "osint.source-infrastructure",
        "provider": "osint.core",
        "contract": {
          "name": "noesis-osint-source-infrastructure",
          "version": "1.0.0"
        }
      }
    ],
    "providers": [
      {
        "id": "osint.core",
        "version": "1.0.0"
      }
    ],
    "workflow_templates": [
      {
        "id": "osint.location-investigation",
        "version": "1.0.0"
      },
      {
        "id": "osint.source-vetting",
        "version": "1.0.0"
      }
    ],
    "profiles": [
      {
        "id": "osint.investigator",
        "description": "Investigation vocabulary and defaults",
        "vocabulary": {
          "place": "location of interest",
          "evidence": "sourced observation"
        },
        "workflow_defaults": {
          "osint.location-investigation": {
            "boundary_collection": "alkis_bezirke:bezirksgrenzen"
          }
        }
      }
    ]
  }
}
