{
  "contract": "noesis-provider-descriptor-v1",
  "id": "osint.platform-transparency",
  "version": "1.0.0",
  "description": "Platform transparency records (#2580): EU DSA Transparency Database statements of reasons from declared daily dumps, Meta Ad Library and Google political ads with advertisers and funding entities as declared and spend and impression ranges as published, and Lumen takedown notices under researcher access (gated); every record with source, record revision and as-of time, reviewable advertiser identity, and links to elections, campaign finance, lobbying and ownership by declared selection, published identifier or accepted match.",
  "implementation": {
    "name": "src.kb.platform_transparency_records",
    "version": "1.0.0",
    "server": "noesis-knowledge-engine"
  },
  "capabilities": [
    {
      "id": "osint.platform-transparency",
      "contract": {
        "name": "noesis-platform-transparency-record",
        "version": "2.0.0"
      },
      "operations": [
        "source-contracts",
        "readiness",
        "ads-for-advertiser",
        "ads-for-election",
        "moderation-statement-counts",
        "record-history",
        "takedown-notices",
        "export-evidence-bundle",
        "list-identity-candidates",
        "list-links",
        "propose-identity-matches",
        "review-identity-match",
        "revert-identity-match",
        "link-records",
        "create-monitor",
        "run-monitor",
        "poll-monitor"
      ],
      "semantic_constraints": {
        "optional_features": "platform-transparency-dsa, platform-transparency-meta, platform-transparency-google and platform-transparency-lumen, each default off; the osint-platform-transparency source pack is in a plan only when one of them is selected",
        "records": "statements of reasons (platform, decision id, decision type, ground, content type, automated-detection and automated-decision flags and dates as published), DSA dump releases (file, variant, digest), ads (platform, ad id, advertiser and funding entity as declared, delivery dates, spend and impression ranges and currency as published), advertisers and takedown notices; every record cites source, record revision and as-of time",
        "revisions": "records are immutable revisions; corrections and removals by the source (a record no longer returned for the same declared selection) are revisions, never deletions",
        "ranges": "spend and impression ranges are stored and returned exactly as published; never converted to midpoints, point estimates or sums",
        "aggregates": "moderation counts are computed only over stored statements, state the stored window, the days without a dump and the dump versions used",
        "identity": "advertisers and funding entities match campaign-finance committees and regulated entities, lobbying registrants and clients and ownership entities through reviewable ownership.identity decisions (published FEC ids before names); nothing is merged or auto-accepted; unmatched subjects stay visible",
        "links": "election, campaign-finance, lobbying and ownership links record their basis and point at ad revisions; absent providers degrade only their own link kind and missing targets are reported",
        "minimisation": "the SP01 decision (platform-transparency-minimisation-v1): DSA free text, content ids and notifier identity, ad creative text and audience distributions, and Lumen bodies, works and URLs are never stored; natural-person records are never identity targets; Lumen notices are returned only with knowledge:osint:platform-transparency:notices:read",
        "gated": "Lumen needs a researcher token (NOESIS_LUMEN_API_TOKEN); access has not been granted to this deployment, so the source reports gated-not-granted and live runs fail with authentication_failed",
        "monitoring": "advertiser, election and platform monitors are platform.subscriptions knowledge subscriptions; no new scheduler",
        "exclusions": "no user-level profiling, no collection of private content, no inference of coordinated behaviour, no conversion of spend or impression ranges into point estimates",
        "no_new_store": false
      }
    }
  ],
