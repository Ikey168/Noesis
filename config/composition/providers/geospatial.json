{
  "contract": "noesis-capability-provider-v1",
  "provider_id": "noesis.geospatial",
  "version": "1.0.0",
  "description": "The existing Geospatial service: places, geometries, reviewable resolutions, spatial relations and acquired vector features in src/kb/geospatial.py and src/kb/geospatial_features.py, exposed through noesis-knowledge-engine tools. Coordinates are stored in WGS84 (EPSG:4326); projected source coordinates are transformed on import and keep their source CRS in provenance.",
  "implementation": {
    "identity": "src.kb.geospatial:GeospatialStore+src.kb.geospatial_features:GeospatialFeatureStore",
    "version": "1.0.0"
  },
  "capabilities": [
    {
      "capability": "spatial.relation",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geospatial-geometry-v2",
        "version": "2.0.0"
      },
      "output_contract": {
        "name": "noesis-spatial-result-v1",
        "version": "1.0.0"
      },
      "semantics": {
        "algorithm": "wgs84-stdlib-v1",
        "crs": "EPSG:4326",
        "crs_handling": "inputs must be stored WGS84 geometries",
        "distance_units": "metres",
        "proximity": "haversine-nearest-stored-vertex",
        "topology": "exact-ring-parity",
        "routing": false
      },
      "effect": "local-mutation",
      "idempotent": true,
      "execution_receipt": true,
      "required_scopes": [
        "knowledge:geospatial:calculate"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [
        "spatial_receipt"
      ],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.calculate_spatial_relation"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    },
    {
      "capability": "spatial.geometry-store",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geospatial-geometry-v2",
        "version": "2.0.0"
      },
      "output_contract": {
        "name": "noesis-geospatial-geometry-v2",
        "version": "2.0.0"
      },
      "semantics": {
        "crs": "EPSG:4326",
        "crs_handling": "projected inputs are transformed to WGS84 and keep their source CRS",
        "identity": "content-addressed-geometry"
      },
      "effect": "local-mutation",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:geospatial:write"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [
        "geometry"
      ],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.store_geospatial_geometry"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    },
    {
      "capability": "spatial.resolution-record",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geocode-resolution-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-geocode-resolution-v1",
        "version": "1.0.0"
      },
      "semantics": {
        "resolution": "reviewable-candidates",
        "automatic_acceptance": false
      },
      "effect": "local-mutation",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:geospatial:write"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [
        "geocode_resolution"
      ],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.record_geospatial_resolution"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    },
    {
      "capability": "spatial.place-revision",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geospatial-place-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-geospatial-place-v1",
        "version": "1.0.0"
      },
      "semantics": {
        "concurrency": "optimistic-expected-revision",
        "history": "immutable-place-revisions"
      },
      "effect": "local-mutation",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:geospatial:write"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [
        "place"
      ],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.revise_geospatial_place"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    },
    {
      "capability": "spatial.geometry-simplify",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geospatial-geometry-v2",
        "version": "2.0.0"
      },
      "output_contract": {
        "name": "noesis-geospatial-geometry-v2",
        "version": "2.0.0"
      },
      "semantics": {
        "tolerance_units": "metres",
        "crs": "EPSG:4326",
        "result": "new-content-addressed-geometry",
        "source_geometry": "unchanged"
      },
      "effect": "local-mutation",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:geospatial:write"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [
        "geometry"
      ],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.simplify_geospatial_geometry"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    },
    {
      "capability": "spatial.resolution-review",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geocode-resolution-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-geocode-resolution-v1",
        "version": "1.0.0"
      },
      "semantics": {
        "decision": "human-review",
        "merge_names_across_collections": false
      },
      "effect": "local-mutation",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:geospatial:review"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [
        "geocode_resolution"
      ],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.review_geospatial_resolution"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    },
    {
      "capability": "spatial.points-within-boundary",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geospatial-feature-query-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-geospatial-feature-query-v1",
        "version": "1.0.0"
      },
      "semantics": {
        "containment": "exact-ring-parity",
        "boundary_edge": "inside",
        "crs": "EPSG:4326",
        "crs_handling": "features projected from EPSG:25833 on import",
        "query_receipt": "owner-audit"
      },
      "effect": "read-only",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:geospatial:calculate"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [],
      "bindings": [
        {
          "kind": "registered",
          "id": "geospatial.features-within"
        },
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.query_geospatial_features_within"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    },
    {
      "capability": "spatial.feature-import",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geospatial-feature-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-geospatial-feature-v1",
        "version": "1.0.0"
      },
      "semantics": {
        "input": "bounded GeoJSON FeatureCollection",
        "crs": "declared CRS transformed to WGS84; source CRS kept in provenance",
        "revisions": "provenance-preserving"
      },
      "effect": "local-mutation",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:geospatial:write"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [
        "geospatial_feature"
      ],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.import_geospatial_features"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    },
    {
      "capability": "spatial.feature-inspect",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geospatial-feature-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-geospatial-feature-v1",
        "version": "1.0.0"
      },
      "semantics": {
        "revisions": "immutable feature revisions with document and page provenance",
        "crs": "EPSG:4326"
      },
      "effect": "read-only",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:geospatial:read"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.inspect_geospatial_feature"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    },
    {
      "capability": "spatial.boundary-resolution",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-geospatial-feature-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-geospatial-feature-v1",
        "version": "1.0.0"
      },
      "semantics": {
        "resolution": "exact title after whitespace and case folding",
        "ambiguity": "needs-review; names are not merged across collections"
      },
      "effect": "read-only",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:geospatial:read"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.resolve_geospatial_boundary"
        }
      ],
      "readiness": {
        "probe": "geospatial.local-store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    }
  ],
  "stores": [
    {
      "record_kind": "place",
      "tables": [
        "geospatial_places",
        "geospatial_place_revisions",
        "geospatial_place_current"
      ],
      "revision_addressing": "immutable"
    },
    {
      "record_kind": "geometry",
      "tables": [
        "geospatial_geometries"
      ],
      "revision_addressing": "immutable"
    },
    {
      "record_kind": "geocode_resolution",
      "tables": [
        "geocode_resolutions",
        "geocode_reviews"
      ],
      "revision_addressing": "immutable"
    },
    {
      "record_kind": "spatial_receipt",
      "tables": [
        "spatial_receipts"
      ],
      "revision_addressing": "immutable"
    },
    {
      "record_kind": "geospatial_feature",
      "tables": [
        "geospatial_features",
        "geospatial_feature_revisions",
        "geospatial_feature_current"
      ],
      "revision_addressing": "immutable"
    }
  ],
  "source_packs": [
    {
      "pack_id": "geospatial-berlin",
      "range": "^1.0.0",
      "config": "config/source_packs/geospatial.json"
    }
  ]
}
