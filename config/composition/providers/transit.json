{
  "contract": "noesis-capability-provider-v1",
  "provider_id": "noesis.transit",
  "version": "1.0.0",
  "description": "Generated by src/composition/bundles.py from the verified capability map; owns src.kb.transit records.",
  "implementation": {
    "identity": "src.kb.transit",
    "version": "1.0.0"
  },
  "capabilities": [
    {
      "capability": "transit.schedules",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-mcp-tool-io-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-mcp-tool-io-v1",
        "version": "1.0.0"
      },
      "semantics": {
        "io": "catalog-declared-tool-schemas"
      },
      "effect": "read-only",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:transit:read"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.transit_departures"
        },
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.transit_feed_versions"
        },
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.transit_source_contracts"
        },
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.transit_stops_in_bbox"
        }
      ],
      "readiness": {
        "probe": "catalog.required-data",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    }
  ],
  "stores": [
    {
      "record_kind": "transit_record",
      "tables": [
        "transit_feed_versions",
        "transit_realtime",
        "transit_route_shapes",
        "transit_stops"
      ],
      "revision_addressing": "immutable"
    }
  ],
  "source_packs": [
    {
      "pack_id": "geospatial-berlin",
      "range": "^1.0.0",
      "config": "config/source_packs/geospatial.json"
    }
  ]
}
