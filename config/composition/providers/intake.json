{
  "contract": "noesis-capability-provider-v1",
  "provider_id": "noesis.intake",
  "version": "1.0.0",
  "description": "The intake session ledger: owner-scoped sessions with optimistic revisions and command replay.",
  "implementation": {
    "identity": "src.kb.intake_modes:IntakeStore",
    "version": "1.0.0"
  },
  "capabilities": [
    {
      "capability": "intake.session-artifact",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-intake-session-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-composition-session-artifact-v1",
        "version": "1.0.0"
      },
      "effect": "local-mutation",
      "idempotent": true,
      "execution_receipt": true,
      "required_scopes": [
        "knowledge:intake:write"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [
        "intake_session"
      ],
      "bindings": [
        {
          "kind": "registered",
          "id": "intake.session-artifact"
        },
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.command_intake_mode"
        }
      ],
      "readiness": {
        "probe": "intake.store",
        "required_data": [
          "knowledge-engine-runtime"
        ]
      }
    }
  ],
  "stores": [
    {
      "record_kind": "intake_session",
      "tables": [
        "intake_sessions",
        "intake_session_revisions",
        "intake_session_commands"
      ],
      "revision_addressing": "immutable"
    }
  ]
}
