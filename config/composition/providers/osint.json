{
  "contract": "noesis-capability-provider-v1",
  "provider_id": "noesis.osint",
  "version": "1.0.0",
  "description": "OSINT investigation capabilities over the warehouse; outputs are referenced by document identity only.",
  "implementation": {
    "identity": "src.osint",
    "version": "1.0.0"
  },
  "capabilities": [
    {
      "capability": "osint.event-geolocation",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-knowledge-source-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-composition-event-geolocation-v1",
        "version": "1.0.0"
      },
      "effect": "read-only",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:read"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [],
      "bindings": [
        {
          "kind": "registered",
          "id": "osint.event-geolocation"
        }
      ],
      "readiness": {
        "probe": "osint.claims"
      },
      "semantics": {
        "subject": "event-geography-only",
        "person_location": false,
        "review_gate": "osint.gated-tools"
      }
    },
    {
      "capability": "osint.corroboration",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-knowledge-source-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-evidence-independence-v1",
        "version": "1.0.0"
      },
      "effect": "read-only",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:read"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [],
      "bindings": [
        {
          "kind": "mcp-tool",
          "id": "noesis-osint.corroborate"
        }
      ],
      "readiness": {
        "probe": "osint.claims",
        "required_data": [
          "warehouse"
        ]
      }
    }
  ],
  "stores": [
    {
      "record_kind": "osint_observation",
      "tables": [
        "argument_claims"
      ],
      "revision_addressing": "unsupported"
    }
  ]
}
