{
  "contract": "noesis-capability-provider-v1",
  "provider_id": "noesis.documents",
  "version": "1.0.0",
  "description": "The document revision store: committed, immutable document revisions linked to their source-pack runs.",
  "implementation": {
    "identity": "src.ingestion.revisions:DocumentRevisionStore",
    "version": "1.0.0"
  },
  "capabilities": [
    {
      "capability": "evidence.document-references",
      "version": "1.0.0",
      "input_contract": {
        "name": "noesis-knowledge-source-v1",
        "version": "1.0.0"
      },
      "output_contract": {
        "name": "noesis-composition-evidence-references-v1",
        "version": "1.0.0"
      },
      "effect": "read-only",
      "idempotent": true,
      "execution_receipt": false,
      "required_scopes": [
        "knowledge:read"
      ],
      "required_context": [
        "namespace",
        "principal"
      ],
      "record_kinds": [],
      "bindings": [
        {
          "kind": "registered",
          "id": "evidence.document-references"
        },
        {
          "kind": "mcp-tool",
          "id": "noesis-knowledge-engine.document_revision"
        }
      ],
      "readiness": {
        "probe": "documents.store"
      }
    }
  ],
  "stores": [
    {
      "record_kind": "document",
      "tables": [
        "documents",
        "document_revision_records"
      ],
      "revision_addressing": "immutable"
    }
  ]
}
