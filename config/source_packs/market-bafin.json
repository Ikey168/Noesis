        "id": "bafin-website-terms",
        "terms_url": "https://www.bafin.de/DE/Service/Impressum/impressum_node.html",
        "redistribution": "reuse of published supervisory information with attribution (operator must verify the terms of use)"
      },
      "bafin": {
        "namespace": "market-bafin",
        "provider": "bafin-voting-rights",
        "format": "bafin-voting-rights-csv",
        "encoding": "windows-1252",
        "delimiter": ";",
        "decimal": ",",
        "window": {
          "from": "2025-01-01"
