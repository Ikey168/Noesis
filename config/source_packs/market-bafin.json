          {
            "isin": "DE000BASF111",
            "name": "BASF SE"
          },
          {
            "isin": "DE0005557508",
            "name": "Deutsche Telekom AG"
          }
        ],
        "columns": {
          "source_id": "Mitteilungs-ID",
          "issuer_name": "Emittent",
          "issuer_isin": "ISIN",
          "issuer_lei": "LEI des Emittenten",
          "notifier": "Meldepflichtiger",
