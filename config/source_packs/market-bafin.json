{
  "pack_id": "bafin-capital-market-notices",
  "version": "1.0.0",
  "description": "BaFin and Bundesanzeiger capital-market notices for the Market pack's optional bafin-notices feature: voting-rights notifications (WpHG §§ 33 ff.) with holder chains and corrections, managers' transactions (Art. 19 MAR), published net short positions (Art. 11 SSR) with publication-end semantics, the BaFin company database and BaFin warnings and measures. Bounded to a declared issuer set and publication window; notices as published, never advice or signals.",
  "domains": [
    "market"
  ],
  "defaults": {
    "connector": "bafin-notices",
    "update_cadence": "daily at most",
    "temporal_semantics": "the publication date as the public clock (end of day, UTC) and the event date as valid time; a missing publication date falls back to the first observation time, never to the event date; acquisition time recorded separately per revision",
    "mapping": {
      "target_schema": "noesis-bafin-notice-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "bafin-notices:1.0.0"
    ],
    "operations": [
      "documents"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 86400
    },
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 5000,
      "max_bytes": 5000000,
      "max_pages": 4
    },
    "auth": {
      "kind": "none"
    },
    "health": {
      "required": false,
      "max_staleness_s": 604800
    }
  },
  "sources": [
    {
      "source_id": "bafin-voting-rights",
      "publisher": "Bundesanstalt für Finanzdienstleistungsaufsicht (BaFin), Stimmrechtsmitteilungen (AnteileInfo)",
      "endpoint": "https://portal.mvp.bafin.de/database/AnteileInfo/",
      "scope": "Voting-rights notifications (WpHG §§ 33 ff.) for the declared DAX 40 issuers published on or after 2025-01-01, from the database's result-list CSV export (operator must verify the export URL, encoding and column headers; a truncated export would read as removals)",
