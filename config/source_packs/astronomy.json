{
  "pack_id": "astronomy-and-space",
  "version": "1.1.0",
  "description": "Astronomy and Space sources for the Astronomy pack: MPC designations, identifications and MPCORB orbits, JPL SBDB solutions and Sentry listings (quoted), NASA Exoplanet Archive dispositions per table, GCAT and CelesTrak SATCAT launches and objects, and NOAA SWPC alerts. Bounded to declared objects, hosts, years and codes; published values quoted, never computed. Plus the space-object registration feature (#2224): UNOOSA Online Index entries and UN registration documents (symbol, locator, language, verbatim), ESA DISCOS under its account terms (permitted subset, never redistributed) and Aerospace Corporation re-entry predictions and confirmed reports, each as published.",
  "domains": [
    "astronomy"
  ],
  "defaults": {
    "connector": "astronomy",
    "update_cadence": "daily at most",
    "temporal_semantics": "each record's own date (orbit computation, disposition row update, product issue time, else the document date) orders revisions and is the public clock (a date counts as the end of that day, UTC); a missing date falls back to the first observation; acquisition time recorded separately per revision",
    "mapping": {
      "target_schema": "noesis-astronomy-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "astronomy:1.0.0"
    ],
    "operations": [
      "documents"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 86400
    },
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 5000,
      "max_bytes": 20000000,
      "max_pages": 10
    },
    "auth": {
      "kind": "none"
    },
    "health": {
      "required": false,
      "max_staleness_s": 604800
    }
  },
  "sources": [
