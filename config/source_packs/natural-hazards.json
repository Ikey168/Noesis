{
  "pack_id": "natural-hazards",
  "version": "1.0.0",
  "description": "Natural Hazards sources for one bounded coverage (NH01, docs/development/hazards-evidence/source-audit.md): USGS earthquake catalog events and PAGER products and EMSC events for the Eastern Mediterranean, GDACS multi-hazard episodes, NOAA NHC Atlantic advisories as issued, Copernicus EFFIS burnt areas and key-gated GloFAS flood notifications. Parameters are quoted as published and every update is a revision. Every source is live-unverified until a dated run.",
  "domains": [
    "natural-hazards"
  ],
  "defaults": {
    "connector": "natural-hazards",
    "temporal_semantics": "the issuing body's update or issue time per revision (USGS updated, EMSC lastupdate, GDACS episode datemodified, NHC advisory issue time, EFFIS LASTUPDATE, GloFAS issue time); acquisition time recorded separately",
    "mapping": {
      "target_schema": "noesis-hazard-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "natural-hazards:1.0.0"
    ],
    "operations": [
      "observe"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 3600
    },
    "auth": {
      "kind": "none"
    },
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 200,
      "max_bytes": 10000000,
      "max_pages": 10
    },
    "health": {
      "required": false,
      "max_staleness_s": 259200
    }
  },
  "sources": [
    {
      "source_id": "usgs-earthquakes",
      "endpoint": "https://earthquake.usgs.gov/fdsnws/event/1/query",
      "publisher": "U.S. Geological Survey (USGS) Earthquake Hazards Program",
      "scope": "FDSN events M4.5+ in the Eastern Mediterranean and Anatolia box [19, 34, 45, 43] for one declared 30-day window (deleted events included), plus event details with PAGER (losspager) products for declared event IDs",
      "update_cadence": "minutes (event updates) to days (review)",
      "license": {
        "id": "us-public-domain",
        "terms_url": "https://www.usgs.gov/information-policies-and-instructions/copyrights-and-credits",
        "redistribution": "public domain (U.S. government work); credit 'U.S. Geological Survey' requested"
      },
      "natural_hazards": {
        "provider": "usgs",
        "namespace": "hazards",
        "live_verification": "unverified-live",
        "documents": [
          {
            "label": "FDSN events M4.5+ Eastern Mediterranean, 2099-08",
            "format": "usgs-fdsn-geojson",
            "url": "https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&starttime=2099-08-01&endtime=2099-08-31&minlatitude=34&maxlatitude=43&minlongitude=19&maxlongitude=45&minmagnitude=4.5&orderby=time&limit=200&includedeleted=true"
          },
          {
            "label": "Event detail and PAGER for us7000zz01",
            "format": "usgs-detail-geojson",
            "requested_id": "us7000zz01",
            "url": "https://earthquake.usgs.gov/fdsnws/event/1/query?eventid=us7000zz01&format=geojson"
          },
          {
            "label": "Event detail for us7000zz03 (secondary ID check)",
            "format": "usgs-detail-geojson",
            "requested_id": "us7000zz03",
            "url": "https://earthquake.usgs.gov/fdsnws/event/1/query?eventid=us7000zz03&format=geojson"
          }
        ]
      },
      "fixture": {
        "path": "tests/fixtures/source_packs/hazards-usgs.json",
