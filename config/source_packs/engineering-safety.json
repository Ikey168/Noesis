{
  "pack_id": "engineering-safety",
  "version": "1.0.0",
  "description": "Engineering Safety pack sources (#2059): FAA airworthiness directives through the Federal Register API, EASA airworthiness directives, NTSB investigations and safety recommendations (CAROL), PHMSA hazardous-liquid incident files, U.S. Chemical Safety Board investigation pages, NHTSA ODI investigations and complaints, BFU reports and BEA reports (link-only). Bounded to declared identifiers, files and windows per the ES01 source audit (docs/development/engineering-safety-evidence/source-audit.md); records are quoted as published, never a verdict, risk score or compliance determination. NHTSA recall campaigns stay with the Products safety feature and are linked by campaign number.",
  "domains": [
    "engineering-safety"
  ],
  "defaults": {
    "connector": "engineering-safety",
    "update_cadence": "daily at most",
    "temporal_semantics": "the source's own publication, issue, report, status or file-vintage date orders revisions (a final report ranks above a preliminary one); a missing date falls back to observation order; acquisition time is recorded separately per revision",
    "mapping": {
      "target_schema": "noesis-engineering-safety-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "engineering-safety-sources:1.0.0"
    ],
    "operations": [
      "records"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 86400
    },
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 200,
      "max_bytes": 5000000,
      "max_pages": 50
    },
    "auth": {
      "kind": "none"
    },
    "health": {
      "required": false,
      "max_staleness_s": 604800
    }
  },
