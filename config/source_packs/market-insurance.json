{
  "pack_id": "insurance-supervisory-and-catastrophe-losses",
  "version": "1.0.0",
  "description": "Insurance supervisory statistics and published catastrophe losses for the Market pack's optional insurance feature: EIOPA insurance statistics per release vintage, insurers' SFCR reports with quoted QRT figures, NAIC under its metadata-only access decision, and catastrophe-loss estimates from publishers cleared by the licence audit (Florida OIR, NOAA NCEI), each publication kept as a publisher revision. Bounded to the audited countries, insurer sample, events and periods; figures as published, never assessments, ratios or loss models.",
  "domains": [
    "market"
  ],
  "defaults": {
    "connector": "insurance",
    "update_cadence": "weekly at most",
    "temporal_semantics": "the stated publication or release date as the public clock (end of day, UTC); a missing one falls back to the first observation time, never to the reference period; every publication is a revision and acquisition time is recorded per revision",
    "mapping": {
      "target_schema": "noesis-insurance-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "insurance:1.0.0"
    ],
    "operations": [
      "documents"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 604800
    },
    "budgets": {
      "timeout_ms": 60000,
      "max_results": 5000,
      "max_bytes": 30000000,
      "max_pages": 12
    },
    "auth": {
      "kind": "none"
    },
    "health": {
      "required": false,
      "max_staleness_s": 2678400
    }
  },
  "sources": [
    {
      "source_id": "eiopa-insurance-statistics",
      "publisher": "European Insurance and Occupational Pensions Authority (EIOPA), insurance statistics",
      "endpoint": "https://www.eiopa.europa.eu/",
      "scope": "Premiums, claims and solvency aggregates by country and line of business for DE, FR, IT, NL, IE and the EEA total, reference years 2022-2025, one workbook per release (operator must verify the download URL, sheet name and headers of each release; releases are declared with their release date)",
      "license": {
        "id": "eiopa-legal-notice",
        "terms_url": "https://www.eiopa.europa.eu/legal-notice_en",
        "redistribution": "reproduction authorised provided the source is acknowledged (operator must verify)"
      },
      "insurance": {
        "namespace": "market-insurance",
        "provider": "eiopa-insurance-statistics",
        "access_decision": "in-scope",
        "format": "eiopa-statistics-xlsx",
        "sheet": "Data",
        "dataset": "Premiums, claims and expenses by line of business",
        "countries": [
          "DE",
          "FR",
          "IT",
          "NL",
          "IE",
          "EEA"
        ],
        "reference_years": {
          "from": 2022,
          "to": 2025
        },
        "markers": [
          "c",
          "x",
          "n/a",
          "-",
          ".."
        ],
        "indicators": {
          "Gross written premiums": {
            "indicator": "gross_written_premiums",
            "definition": "Gross written premiums as published by EIOPA (Solvency II reporting)"
          },
          "Gross claims incurred": {
            "indicator": "gross_claims_incurred",
            "definition": "Gross claims incurred as published by EIOPA (Solvency II reporting)"
          },
          "SCR ratio": {
            "indicator": "scr_ratio",
            "definition": "Eligible own funds to SCR as published by EIOPA; never computed by Noesis"
          }
        },
        "columns": {
          "country": "Country",
          "line_of_business": "Line of business",
          "indicator": "Indicator",
          "reference": "Reference period",
          "amount": "Value",
          "unit": "Unit"
        },
        "documents": [
          {
            "label": "EIOPA insurance statistics release 2025-06",
            "url": "https://www.eiopa.europa.eu/document/download/insurance-statistics-premiums-claims-expenses_en.xlsx",
            "release": "2025-06",
            "release_date": "2025-06-30"
