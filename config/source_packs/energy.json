{
 "pack_id": "energy-systems",
 "version": "1.0.0",
 "description": "Energy Systems sources: generation by fuel, load, day-ahead prices, installed capacity (zone and plant/unit), cross-border flows and energy balances as published, each release a vintage. ENTSO-E reuses the Climate and Environment adapter (no second acquisition path); EIA Open Data v2, Ember, Eurostat energy balances (SDMX connector) and Energy-Charts public power (licence decision: public_power acquired, prices link-only). Access audit: docs/roadmaps/energy-systems-source-audit.md. Every source is unverified-live until a dated run. Observations only: no forecasts, dispatch modelling, emissions estimation or trading advice.",
 "domains": [
  "energy"
 ],
 "defaults": {
  "connector": "energy",
  "mapping": {
   "target_schema": "noesis-energy-record-v1",
   "version": "1.0.0"
  },
  "extractor_versions": [
   "energy-sources:1.0.0"
  ],
  "operations": [
   "observe"
  ],
  "schedule": {
   "kind": "interval",
   "interval_s": 86400
  },
  "auth": {
   "kind": "none"
  },
  "budgets": {
   "timeout_ms": 60000,
   "max_results": 500,
   "max_bytes": 20000000,
   "max_pages": 40
  },
  "health": {
   "required": false,
   "max_staleness_s": 259200
  }
 },
