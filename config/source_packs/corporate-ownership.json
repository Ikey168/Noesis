    },
    {
      "source_id": "open-ownership-bods",
      "connector": "bods",
      "publisher": "Open Ownership",
      "endpoint": "https://bods-data.openownership.org",
      "scope": "Explicitly selected BODS 0.2/0.3 statement files; only sources listed as implemented in the provider contract are projected",
      "license": {
        "id": "bods-per-statement-license",
        "terms_url": "https://www.openownership.org/en/topics/beneficial-ownership-data-standard/",
        "redistribution": "licence as stated per statement in publicationDetails.license; person statements stay owner-scoped"
      },
      "mapping": {
        "target_schema": "noesis-ownership-part-v1",
        "version": "1.0.0"
      },
      "extractor_versions": [
        "ownership-providers:1.0.0"
      ],
      "auth": {
        "kind": "none"
      },
      "operations": [
        "ownership"
      ],
      "ownership": {
        "namespace": "ownership",
        "files": [
          "/fixtures/exampla/gb-psc-statements.json"
        ],
        "live_verification": "unverified-live"
      },
      "fixture": {
        "path": "tests/fixtures/ownership/open-ownership-bods.json",
        "sha256": "a155a62afc7e2ee61a07e4a63b15ec12d71e51b7d7285b1e05548c69b4cbf86e",
        "expected_output_hash": "6fca1478d29ca91745044d27cf7a2682d3193a3f608213aadb05f2e64fb6aff1"
      }
    }
  ]
}
