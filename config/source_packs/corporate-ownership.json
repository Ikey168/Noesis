{
  "pack_id": "corporate-ownership",
  "version": "1.1.0",
  "description": "Corporate ownership and registries: GLEIF Level 2 relationships and reporting exceptions, UK Companies House profiles, officers, PSC and filing history, SEC EDGAR submissions and beneficial-ownership filing references, and Open Ownership BODS statements, each for explicitly selected identifiers. Handelsregister, Unternehmensregister and BRIS have no supported machine access and are not sources here (see src/ingestion/ownership_providers.py PROVIDER_CONTRACTS). Ownership assertions are what each source states; no beneficial-ownership, sanctions or AML determination is inferred. From 1.1.0 the optional competition feature adds declared European Commission competition cases, EU State Aid Transparency Award Module awards, UK CMA case pages and US FTC and DOJ Antitrust Division actions, recorded as published (no outcome prediction, market-power or aid-compatibility assessment).",
  "domains": [
    "corporate-ownership"
  ],
  "defaults": {
    "update_cadence": "daily at most",
    "temporal_semantics": "source-stated validity and filing dates kept as stated; observation time recorded separately per record revision",
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 200,
      "max_bytes": 5000000,
      "max_pages": 40
    },
    "schedule": {
      "kind": "interval",
      "interval_s": 86400
    },
    "health": {
      "required": false,
      "max_staleness_s": 604800
    }
  },
  "sources": [
    {
