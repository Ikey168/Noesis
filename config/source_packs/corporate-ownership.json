      },
      "extractor_versions": [
        "ownership-providers:1.0.0"
      ],
      "auth": {
        "kind": "required-secret",
        "secret_ref": "NOESIS_SEC_CONTACT"
      },
      "operations": [
        "ownership"
      ],
      "ownership": {
        "namespace": "ownership",
        "ciks": [
          "0009999101"
