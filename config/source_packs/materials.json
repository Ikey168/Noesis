{
 "pack_id": "materials",
 "version": "1.0.0",
 "description": "Materials: condition-aware material properties with measured vs computed provenance for a bounded Ti-O / Al-O selection. Materials Project, JARVIS-DFT and OQMD (computed, with functional and database release), NIST Chemistry WebBook (measured and evaluated thermochemistry with cited references) and the Crystallography Open Database (experimental structures). Values are never merged or averaged across sources or method classes. Source audit and licence decisions: docs/development/materials-evidence/source-audit.md. Every source is live-unverified until a dated run.",
 "domains": [
  "materials"
 ],
 "defaults": {
  "connector": "materials",
  "update_cadence": "per source release; weekly check",
  "temporal_semantics": "values belong to the source's dataset release (stated by the source, else declared in this pack); retrieval time recorded separately; conditions as the source states them, unstated otherwise",
  "mapping": {
   "target_schema": "noesis-material-record-v1",
   "version": "1.0.0"
  },
  "extractor_versions": [
   "materials-sources:1.0.0"
  ],
  "operations": [
   "properties"
  ],
  "schedule": {
   "kind": "interval",
   "interval_s": 604800
  },
  "auth": {
   "kind": "none"
  },
  "budgets": {
   "timeout_ms": 60000,
   "max_results": 100,
   "max_bytes": 20000000,
   "max_pages": 1
  },
  "health": {
   "required": false,
   "max_staleness_s": 2592000
  }
 },
 "sources": [
  {
   "source_id": "materials-project-ti-al-oxides",
   "endpoint": "https://api.materialsproject.org",
   "publisher": "The Materials Project",
   "scope": "Chemical systems O-Ti and Al-O: summary (band gap, density, structure), thermo (formation energy and hull distance per thermo_type) and elasticity (VRH moduli) documents; at most 50 materials (verify paths and field names)",
   "license": {
    "id": "cc-by-4.0",
    "terms_url": "https://materialsproject.org/about/terms",
    "redistribution": "with attribution to the Materials Project and its reference paper (verify licence text)"
   },
   "auth": {
    "kind": "required-secret",
    "secret_ref": "NOESIS_MATERIALS_PROJECT_API_KEY"
   },
   "materials": {
    "namespace": "materials",
    "provider": "materials-project",
    "format": "mp-api-json",
    "chemical_systems": [
     "O-Ti",
     "Al-O"
    ],
    "max_records": 50,
    "documents": [
     {
      "kind": "summary",
      "path": "/materials/summary/",
      "params": {
       "chemsys": "O-Ti,Al-O",
       "_limit": "50",
       "_fields": "material_id,formula_pretty,symmetry,structure,nsites,volume,density,band_gap,database_IDs,deprecated,last_updated"
      }
     },
     {
      "kind": "thermo",
      "path": "/materials/thermo/",
      "params": {
       "chemsys": "O-Ti,Al-O",
       "_limit": "50",
       "_fields": "material_id,thermo_type,formation_energy_per_atom,energy_above_hull"
      }
     },
     {
      "kind": "elasticity",
      "path": "/materials/elasticity/",
      "params": {
       "chemsys": "O-Ti,Al-O",
       "_limit": "50",
       "_fields": "material_id,bulk_modulus,shear_modulus"
      }
     }
    ]
   },
   "fixture": {
    "path": "tests/fixtures/source_packs/materials-mp.json",
