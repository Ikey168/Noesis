  "pack_id": "society-social-protection",
  "version": "1.0.0",
  "description": "Society bundle, society.social-protection provider: Eurostat ESSPROS expenditure and pension beneficiaries, OECD SOCX public social expenditure and ILOSTAT SDG 1.3.1 coverage, for one bounded selection (Germany and France). Values are quoted as each source released them with definitions, release vintages and flags; ESSPROS, SOCX, ILO and COFOG figures are never blended and no publisher's functions are re-classified into another's; no nowcasting, no filled years, no derived indicators. Audit: docs/development/social-protection-evidence/source-audit.md.",
  "domains": [
    "society"
  ],
  "defaults": {
    "connector": "social-protection",
    "temporal_semantics": "the source's release clock (Eurostat LAST UPDATE, a declared OECD or ILO release date, else the retrieval time, labelled) dates each vintage; the reference year is the period; report editions that restate earlier years are new vintages; vintages appended, never overwritten",
    "update_cadence": "ESSPROS: annual; SOCX: about annual; ILOSTAT: per indicator and report edition",
    "mapping": {
      "target_schema": "noesis-social-protection-record-v2",
      "version": "2.0.0"
    },
    "extractor_versions": [
      "social-protection:1.0.0"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 604800
    },
    "auth": {
      "kind": "none"
    },
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 60,
      "max_bytes": 2000000,
      "max_pages": 3
    },
    "health": {
      "required": false,
      "max_staleness_s": 31536000
    },
    "operations": [
      "release"
    ],
    "policy": {
      "personal_data": "never; published aggregates only; registers, microdata and Social Security Inquiry returns excluded",
      "values": "as published per source and release; never blended, filled, nowcast, recomputed or re-classified",
      "cofog": "COFOG social-protection expenditure stays in economics.public-finance, a distinct concept"
    }
  },
