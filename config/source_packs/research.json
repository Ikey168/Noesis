{
  "pack_id": "research-discovery",
  "version": "1.3.0",
  "description": "Scholarly discovery, authorship, venue, identifier, and citation metadata.",
  "domains": [
    "research"
  ],
  "defaults": {
    "connector": "declarative-rest",
    "scope": "global scholarly metadata",
    "update_cadence": "daily",
    "temporal_semantics": "publication-and-provider-update",
    "mapping": {
      "target_schema": "scholarly-work-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "research-metadata:1.0.0"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 86400
    },
    "budgets": {
      "timeout_ms": 10000,
      "max_results": 100,
      "max_bytes": 5000000,
      "max_pages": 5
    },
    "auth": {
      "kind": "none"
    },
    "fixture": {
      "path": "tests/fixtures/source_packs/research.json",
      "sha256": "a05bc61c155ddd13a4943323d5c51b059f98e0bb40f2bfde7b2dc16c055b5769",
      "expected_output_hash": "233caf4f5d5c62a4e2d445d0ab5c851e691409a0c3018a321217a246537e74d8"
    },
    "health": {
      "required": true,
      "max_staleness_s": 172800
    }
  },
  "sources": [
    {
      "source_id": "crossref-works",
      "endpoint": "https://api.crossref.org/works",
      "publisher": "Crossref",
      "license": {
        "id": "crossref-metadata",
        "terms_url": "https://www.crossref.org/documentation/retrieve-metadata/rest-api/rest-api-metadata-license-information/",
        "redistribution": "metadata-per-source-license"
      },
      "operations": [
        "search",
        "doi",
        "author",
        "venue",
        "date-range"
      ]
    },
    {
      "source_id": "openalex-works",
      "endpoint": "https://api.openalex.org/works",
      "publisher": "OurResearch",
      "license": {
        "id": "cc0-metadata",
        "terms_url": "https://docs.openalex.org/additional-help/faq",
        "redistribution": "cc0"
      },
      "operations": [
        "search",
        "doi",
        "author",
        "venue",
        "concept",
        "date-range"
      ],
      "auth": {
        "kind": "optional-secret",
        "secret_ref": "NOESIS_OPENALEX_API_KEY"
      }
    },
    {
      "source_id": "datacite-dois",
      "endpoint": "https://api.datacite.org/dois",
      "publisher": "DataCite",
      "operations": [
        "search",
        "doi"
      ],
      "license": {
        "id": "cc0-metadata",
        "terms_url": "https://support.datacite.org/docs/metadata-license",
        "redistribution": "cc0"
      }
    },
    {
      "source_id": "epo-ops-patents",
      "connector": "epo-ops",
      "publisher": "European Patent Office (Open Patent Services)",
      "endpoint": "https://ops.epo.org/3.2",
      "scope": "Explicitly selected EP/DE publications: bibliographic data, INPADOC family, legal events, claims",
      "update_cadence": "weekly publication cycles; legal events as reported",
      "temporal_semantics": "publication, priority and legal-event dates as reported; observation time recorded separately; no validity inferred",
      "mapping": {
        "target_schema": "noesis-patent-part-v1",
        "version": "1.0.0"
      },
      "extractor_versions": [
        "patent-sources:1.0.0"
      ],
      "operations": [
        "publications"
      ],
      "schedule": {
        "kind": "interval",
        "interval_s": 604800
      },
      "auth": {
        "kind": "required-secret",
        "secret_ref": "NOESIS_EPO_OPS_CREDENTIALS"
      },
      "license": {
        "id": "epo-ops-terms",
        "terms_url": "https://www.epo.org/en/searching-for-patents/data/web-services/ops",
        "redistribution": "per EPO OPS terms and fair-use policy; bibliographic data reuse with attribution (operator must confirm)"
      },
      "budgets": {
        "timeout_ms": 30000,
        "max_results": 50,
        "max_bytes": 2000000,
        "max_pages": 20
      },
      "health": {
        "required": false,
        "max_staleness_s": 2592000
      },
      "patent": {
        "namespace": "global",
        "publications": [
          "EP.3999001.A1",
          "DE.102020000001.A1"
        ],
        "parts": [
          "biblio",
          "family",
          "legal",
          "claims"
        ]
      },
      "fixture": {
        "path": "tests/fixtures/source_packs/patents-epo-ops.json",
        "sha256": "d25d912a9af732920f39052ccf7491188f5a0e0f4b4dd1dafa10fad63e0f9069",
        "expected_output_hash": "58bc4a6bed298f2d31dbdb105f816c12621cba2017fa5b652d8babe600f2227b"
      }
    }
  ]
}
