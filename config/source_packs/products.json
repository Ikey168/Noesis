{
  "pack_id": "products-displays",
  "version": "1.2.0",
  "description": "EU-market electronic displays, household washing machines and refrigerating appliances from Open Icecat (brand-authorised content) and the EPREL public API (supplier registrations), and multilayer ceramic capacitors from manufacturer and supplier BMEcat catalogues, each bounded to an explicit model or part selection, plus product safety notices and recalls (EU Safety Gate, CPSC, NHTSA, RASFF) bounded to explicit notice numbers. No provider is independent testing, and a notice is what its authority published, never a verdict.",
  "domains": [
    "products"
  ],
  "defaults": {
    "publisher": "see source",
    "temporal_semantics": "provider-declared revision (Icecat ProductDataUpdated, EPREL versionNumber); acquisition time recorded separately; absence never implies discontinuation",
    "mapping": {
      "target_schema": "noesis-product-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "product-sources:1.0.0",
      "products-display-normalization-v1:1.0.0"
    ],
    "operations": [
      "models"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 604800
    },
    "health": {
      "required": false,
      "max_staleness_s": 2592000
    }
  },
