{
  "pack_id": "society-wealth-distribution",
  "version": "1.0.0",
  "description": "Society bundle, society.wealth provider: World Inequality Database top wealth shares and wealth-income ratios, ECB Distributional Wealth Accounts and Federal Reserve Distributional Financial Accounts, for one bounded selection (Germany, France, United States). Values are quoted as each source released them with definitions, methods, release vintages and flags; WID, DWA and DFA figures are never blended or re-harmonised; model-based estimates keep the publisher's method; no nowcasting, no filled periods, no derived indicators. Audit: docs/development/wealth-distribution-evidence/source-audit.md.",
  "domains": [
    "society"
  ],
  "defaults": {
    "connector": "wealth-distribution",
    "temporal_semantics": "the declared release date (a WID update, an ECB DWA quarterly release, a Fed Z.1 release), else the retrieval time, labelled, dates each vintage; the reference year or quarter is the period; whole-history revisions are new vintages, appended, never overwritten",
    "update_cadence": "WID: irregular updates; ECB DWA: quarterly; Fed DFA: quarterly with the Z.1 release",
    "mapping": {
      "target_schema": "noesis-wealth-distribution-record-v2",
      "version": "2.0.0"
    },
    "extractor_versions": [
      "wealth-distribution:1.0.0"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 604800
    },
    "auth": {
      "kind": "none"
    },
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 40,
      "max_bytes": 5000000,
      "max_pages": 1
    },
    "health": {
      "required": false,
      "max_staleness_s": 31536000
    },
    "operations": [
      "release"
    ],
    "policy": {
      "personal_data": "never; published aggregates only; HFCS, PHF and SCF microdata, rich lists and named individuals excluded",
      "values": "as published per source and release; never blended, filled, nowcast, recomputed or re-harmonised",
      "model_estimates": "WID, DWA and DFA are model-based; their method and flags are kept, never corrected"
    }
  },
  "sources": [
    {
      "source_id": "wid-wealth-distribution",
      "endpoint": "https://rfap9nitz6.execute-api.eu-west-1.amazonaws.com/prod",
      "publisher": "World Inequality Lab, World Inequality Database (WID.world)",
      "scope": "WID for Germany (DE), France (FR) and the United States (US): shweal top 1%, 0.1% and 0.01% net personal wealth shares (992_j) and wwealn and wwealp wealth-to-income ratios (999_i), from a declared start year; 1 document, at most 40 series; model-based DINA estimates kept with WID's method and extrapolation flags (operator must verify the API host, path, response shape and the terms for the API key)",
      "license": {
        "id": "wid-terms",
        "terms_url": "https://wid.world/",
        "redistribution": "attribution-required (verify)"
      },
      "update_cadence": "irregular WID updates; whole histories revised when methods change",
      "auth": {
        "kind": "required-secret",
        "secret_ref": "NOESIS_WID_API_KEY"
      },
      "budgets": {
        "timeout_ms": 30000,
        "max_results": 40,
        "max_bytes": 2000000,
        "max_pages": 1
      },
