{
  "pack_id": "society-wealth-distribution",
  "version": "1.0.0",
  "description": "Society bundle, society.wealth provider: World Inequality Database top wealth shares and wealth-income ratios, ECB Distributional Wealth Accounts, Federal Reserve Distributional Financial Accounts, and the ECB HFCS statistical tables and Bundesbank PHF data annex read from their PDFs at declared table cells only, for one bounded selection (Germany, France, Spain, Italy, United States). Values are quoted as each source released them with definitions, methods, release vintages and flags; WID, DWA, DFA, HFCS and PHF figures are never blended or re-harmonised; model-based estimates keep the publisher's method; no nowcasting, no filled periods, no derived indicators. Audit: docs/development/wealth-distribution-evidence/source-audit.md.",
  "domains": [
    "society"
  ],
  "defaults": {
    "connector": "wealth-distribution",
    "temporal_semantics": "the declared release date (a WID update, an ECB DWA quarterly release, a Fed Z.1 release), else the retrieval time, labelled, dates each vintage; the reference year or quarter is the period; whole-history revisions are new vintages, appended, never overwritten",
    "update_cadence": "WID: irregular updates; ECB DWA: quarterly; Fed DFA: quarterly with the Z.1 release; ECB HFCS and Bundesbank PHF: per survey wave",
    "mapping": {
      "target_schema": "noesis-wealth-distribution-record-v2",
      "version": "2.0.0"
    },
    "extractor_versions": [
      "wealth-distribution:1.0.0"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 604800
    },
    "auth": {
      "kind": "none"
    },
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 40,
      "max_bytes": 5000000,
      "max_pages": 1
    },
    "health": {
      "required": false,
      "max_staleness_s": 31536000
    },
    "operations": [
      "release"
    ],
    "policy": {
      "personal_data": "never; published aggregates only; HFCS, PHF and SCF microdata, rich lists and named individuals excluded",
      "values": "as published per source and release; never blended, filled, nowcast, recomputed or re-harmonised",
      "model_estimates": "WID, DWA and DFA are model-based; their method and flags are kept, never corrected",
      "pdf_tables": "HFCS and PHF PDFs are read only at declared table anchors, row labels and printed columns; each value keeps its printed token, page and quoted line; a cell that cannot be read exactly fails the document"
    }
  },
  "sources": [
    {
