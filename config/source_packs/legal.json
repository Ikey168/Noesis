{
  "pack_id": "legal-research",
  "version": "1.4.0",
  "description": "Bounded EU (CELLAR), German federal court (Rechtsprechung im Internet) and Berlin (gesetze.berlin.de) legal sources for cited legal research, plus the sanctions feature's lists (EU FSF, UN SC, OFAC SLS, UK Sanctions List) and the dual-use Regulation (EU) 2021/821 editions, plus the product-safety acts notices cite (Regulation (EU) 2023/988, Regulation (EC) No 178/2002), plus the federal-statutes feature's bounded statute set from gesetze-im-internet.de (observed versions), rechtsinformationen.bund.de (source-stated versions) and the digital Federal Law Gazette on recht.bund.de (amendment acts). Selected works, published decisions and full list files only; current law is never inferred and no list statement is a screening result, plus the courts feature's CourtListener dockets, docket entries and opinions (parties minimised; dispositions quoted) and the justice-statistics feature's FBI Crime Data Explorer, data.police.uk and Eurostat crime statistics with definitions and vintages (no rankings, safety ratings or risk scores).",
  "domains": [
    "legal"
  ],
  "defaults": {
    "temporal_semantics": "source-reported dates (document, publication, entry into force, commencement, validity end, decision) as valid time; acquisition time recorded separately; current force is not inferred",
    "mapping": {
      "target_schema": "noesis-legal-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "regional-providers:noesis-native-regional-v1",
      "legal-projection:1.0.0"
    ],
    "operations": [
      "records"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 2592000
    },
    "health": {
      "required": false,
      "max_staleness_s": 7776000
    }
  },
