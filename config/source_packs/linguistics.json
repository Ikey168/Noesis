      "endpoint": "https://kaikki.org/dictionary/",
      "scope": "Per-language Wiktextract JSONL extracts bounded to declared words: lexemes, forms, senses with definitions and usage examples, structured etymology templates, verbatim etymology text and translation tables; sounds (speaker recordings) are dropped. Declared selection is the offline, synthetic fixture selection (tests/unit/linguistics_harness.py); the LG01 production bounds replace it at live validation (#2191).",
      "license": {
        "id": "CC-BY-SA-4.0",
        "terms_url": "https://creativecommons.org/licenses/by-sa/4.0/",
        "redistribution": "share-alike: every derived record and export carries CC BY-SA 4.0 attribution; exports under another licence are refused (GFDL dual licence, verify)"
