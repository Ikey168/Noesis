{
  "pack_id": "linguistics-lexical-typological",
  "version": "1.0.0",
  "description": "Linguistics pack sources: Wikidata lexemes and language items (CC0), Wiktionary via kaikki.org Wiktextract extracts (CC BY-SA 4.0, share-alike), Glottolog and WALS CLDF releases (CC BY 4.0), Unicode CLDR locale data and the SIL ISO 639-3 code tables. Every record is attributed to its source and revision; nothing machine-translated is stored as sourced; no speaker data is kept; no full dumps are mirrored. Audit: docs/development/linguistics-evidence/source-audit.md.",
  "domains": [
    "linguistics"
  ],
  "defaults": {
    "connector": "linguistics",
    "update_cadence": "per pinned release; Wikidata entities at most daily",
    "temporal_semantics": "the source's own revision (Wikidata revision id and modified time, kaikki extract and dump dates, CLDF/CLDR release and date, SIL table date) orders revisions; observation time is recorded separately and orders only undated revisions",
    "mapping": {
      "target_schema": "noesis-linguistic-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "linguistics:1.0.0"
    ],
    "operations": [
      "documents"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 86400
    },
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 5000,
      "max_bytes": 20000000,
      "max_pages": 20
    },
    "auth": {
      "kind": "none"
    },
    "health": {
      "required": false,
      "max_staleness_s": 2592000
    }
  },
  "sources": [
    {
      "source_id": "wikidata-lexemes",
      "publisher": "Wikidata (Wikimedia Foundation)",
      "endpoint": "https://www.wikidata.org/wiki/Special:EntityData/",
      "scope": "Declared lexemes (L-ids) with lemmas, forms, grammatical features, senses, glosses and etymology statements (P5191, P5238 with P5886), plus the declared language items' stated Glottocode (P1394) and ISO 639-3 (P220). Declared selection is the offline, synthetic fixture selection (tests/unit/linguistics_harness.py); the LG01 production bounds replace it at live validation (#2191).",
      "license": {
        "id": "CC0-1.0",
        "terms_url": "https://www.wikidata.org/wiki/Wikidata:Licensing",
        "redistribution": "CC0: no restriction; courtesy attribution to Wikidata and the revision"
      },
      "linguistics": {
        "namespace": "linguistics",
        "provider": "wikidata-lexemes",
        "format": "wikidata-lexeme-json",
        "derivation_modes": {
          "Q900101": "borrowed",
          "Q900102": "inherited",
          "Q900103": "calque"
        },
        "documents": [
          {
            "label": "L90001",
            "entity": "L90001",
            "url": "https://www.wikidata.org/wiki/Special:EntityData/L90001.json"
          },
          {
            "label": "L90002",
            "entity": "L90002",
            "url": "https://www.wikidata.org/wiki/Special:EntityData/L90002.json"
          },
          {
            "label": "L90003",
            "entity": "L90003",
            "url": "https://www.wikidata.org/wiki/Special:EntityData/L90003.json"
          },
          {
            "label": "Q900001",
            "entity": "Q900001",
            "url": "https://www.wikidata.org/wiki/Special:EntityData/Q900001.json"
          },
          {
            "label": "Q900002",
            "entity": "Q900002",
            "url": "https://www.wikidata.org/wiki/Special:EntityData/Q900002.json"
          }
        ]
