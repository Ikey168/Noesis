{
  "pack_id": "oss-ecosystems",
  "version": "1.0.0",
  "description": "Open-source Software Ecosystems: release, yank, deprecation and unpublish history, declared dependencies, licence declarations with SPDX normalisation, organisation-level publishers and repository links from PyPI, npm, crates.io and Maven Central, deps.dev as a second attributed source, pinned SPDX License List releases and Software Heritage archive provenance. Explicit package lists only; no maintainer or contributor data and no quality, popularity or trust verdicts. Source audit: docs/development/oss-ecosystems-evidence/source-audit.md.",
  "domains": [
    "oss-ecosystems"
  ],
  "defaults": {
    "connector": "oss-ecosystem",
    "update_cadence": "daily",
    "temporal_semantics": "source-modified-or-observed-revision",
    "mapping": {
      "target_schema": "noesis-oss-ecosystem-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "oss-ecosystem-sources:1.0.0"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 86400
    },
    "auth": {
      "kind": "none"
    },
    "health": {
      "required": false,
      "max_staleness_s": 172800
    }
  },
  "sources": [
    {
      "source_id": "pypi-json",
      "connector": "oss-ecosystem",
      "endpoint": "https://pypi.org/pypi",
      "publisher": "Python Package Index",
      "scope": "Release, yank, dependency, licence, organisation and repository history for pinned PyPI projects",
      "license": {
        "id": "pypi-terms",
        "terms_url": "https://policies.python.org/pypi.org/Terms-of-Service/",
        "redistribution": "metadata under the publishers' licences (operator must confirm)"
      },
      "operations": [
        "acquire"
      ],
      "mapping": {
        "target_schema": "noesis-oss-ecosystem-record-v1",
        "version": "1.0.0"
      },
      "extractor_versions": [
        "oss-ecosystem-sources:1.0.0"
      ],
      "update_cadence": "daily",
      "temporal_semantics": "source-modified-or-observed-revision",
      "budgets": {
        "timeout_ms": 20000,
        "max_results": 500,
        "max_bytes": 10000000,
        "max_pages": 10
      },
      "oss": {
        "format": "pypi-json",
        "namespace": "global",
        "selection": {
          "packages": [
            {
              "name": "fixture-parser",
              "versions": [
                "1.0.0",
                "1.1.0",
                "2.0.0"
              ]
            },
            {
              "name": "fixture-tokens",
              "versions": [
                "1.0.0",
                "1.2.0",
                "1.3.0",
                "2.0rc1"
              ]
            }
          ]
        }
      },
      "fixture": {
        "path": "tests/fixtures/source_packs/oss-pypi-json.json",
        "sha256": "ef718db418553d79a8272dbe4f2f9d800794cf55bd17dbad6b8a8950b71a6784",
        "expected_output_hash": "9202fac235803169abda946a1113d1fe652c387ab403ef49a70651d04d9c6fda"
      }
    },
    {
