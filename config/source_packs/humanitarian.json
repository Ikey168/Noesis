{
  "pack_id": "humanitarian-response",
  "version": "1.0.0",
  "description": "Humanitarian Response and Conflict Events: ReliefWeb situation reports, appeals and disaster entries, HDX dataset metadata with HXL tags and update history, and UCDP GED and Candidate conflict events with the coder's precision codes, for one bounded crisis selection (Sudan). ACLED is declined under its licence and never acquired. Counts and codings are quoted as published; no casualty estimation, cross-coder deduplication, forecasting or personal data. Audit: docs/development/humanitarian-evidence/source-audit.md.",
  "domains": [
    "humanitarian"
  ],
  "defaults": {
    "connector": "humanitarian",
    "temporal_semantics": "the provider's own change time (ReliefWeb date.changed, HDX metadata_modified) or the declared release date of a coder dataset version as the as-of time; retrieval time recorded separately; revisions appended, never overwritten",
    "update_cadence": "ReliefWeb and HDX daily; UCDP Candidate monthly; UCDP GED annually",
    "mapping": {
      "target_schema": "noesis-humanitarian-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "humanitarian-sources:1.0.0"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 86400
    },
    "auth": {
      "kind": "none"
    },
    "budgets": {
      "timeout_ms": 30000,
      "max_results": 1000,
      "max_bytes": 10000000,
      "max_pages": 2
    },
    "health": {
      "required": false,
      "max_staleness_s": 604800
    },
    "policy": {
      "personal_data": "never; free text that can name individuals is dropped at parse time",
      "counts": "as published by the coder or publisher; never summed, merged or estimated",
      "bodies": "referenced by locator, never mirrored"
    }
  },
  "sources": [
    {
      "source_id": "reliefweb-reports-sdn",
      "endpoint": "https://api.reliefweb.int/v2",
      "publisher": "ReliefWeb (UN OCHA)",
      "scope": "ReliefWeb reports tagged Sudan (SDN) and the pinned Sudan conflict disaster, formats Situation Report, Appeal and Flash Appeal, in a closed 12-month window; at most 50 per page and 2 pages",
      "license": {
        "id": "reliefweb-terms",
        "terms_url": "https://reliefweb.int/terms-conditions",
        "redistribution": "metadata and links with attribution to ReliefWeb and the report's own sources; report bodies are never mirrored (verify)"
      },
      "operations": [
        "reports"
      ],
      "budgets": {
        "timeout_ms": 30000,
        "max_results": 100,
        "max_bytes": 5000000,
        "max_pages": 2
      },
      "humanitarian": {
        "provider": "reliefweb",
        "namespace": "humanitarian",
        "appname": "noesis-humanitarian",
        "live_verification": "unverified-live",
        "selection": {
          "resource": "reports",
          "countries": [
            "SDN"
          ],
          "disaster_ids": [
            99001
          ],
          "limit": 50,
          "date_from": "2098-04-15",
          "date_to": "2099-04-14"
        }
      },
      "fixture": {
        "path": "tests/fixtures/source_packs/humanitarian-reliefweb-reports-sdn.json",
