{
  "pack_id": "agrifood",
  "version": "1.0.0",
  "description": "Agriculture and Food Systems: published production, yield, area, producer and market prices and food balances for a bounded set of commodities (maize/corn, wheat, soybeans) and places (United States with Iowa and one county, France, Germany, the EU), from FAOSTAT (QCL, PP, FBS), USDA NASS Quick Stats, USDA FAS PSD, Eurostat agriculture (through the SDMX connector) and the EU Agri-food data portal. Every figure keeps its unit, reference period (calendar or marketing year, never converted), source flag verbatim and release vintage; revisions are new vintages. No forecasting, projection or food-security scoring by the pack; publisher forecasts and USDA projections are labelled as the publisher's. Access audit: docs/roadmaps/agrifood-source-audit.md.",
  "domains": [
    "agrifood"
  ],
  "defaults": {
    "connector": "agrifood",
    "update_cadence": "weekly re-check of the explicit selection; FAOSTAT domains update a few times a year, NASS on its release calendar, PSD monthly with WASDE, Eurostat on dataset update, portal prices weekly",
    "temporal_semantics": "publisher release time per vintage (FAOSTAT domain date_update, NASS load_time, PSD release month, Eurostat LAST UPDATE); portal answers state none and are dated by first retrieval; reference periods are kept as published (calendar year, marketing year, week)",
    "mapping": {
      "target_schema": "noesis-agrifood-record-v1",
      "version": "1.0.0"
    },
    "extractor_versions": [
      "agrifood-sources:1.0.0"
    ],
    "operations": [
      "series"
    ],
    "schedule": {
      "kind": "interval",
      "interval_s": 604800
    },
    "health": {
      "required": false,
      "max_staleness_s": 5184000
    },
    "policy": {
      "flags_verbatim": true,
      "vintages_never_overwritten": true,
      "excluded": [
        "yield, production or price forecasting by the pack",
        "food-security scoring beyond quoting the publisher",
        "blending or summing across sources",
        "marketing-year to calendar-year conversion",
        "imputation of withheld or missing values"
      ]
    }
  },
  "sources": [
